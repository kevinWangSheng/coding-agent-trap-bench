+function getMeta(body:any){return body?.params?._meta;}
+async function body(req:http.IncomingMessage){let s='';for await(const c of req)s+=c;try{return JSON.parse(s)}catch{return null}}
+function header(req:http.IncomingMessage,name:string){const v=req.headers[name.toLowerCase()];return Array.isArray(v)?v[0]:v;}
+function validateTransport(req:http.IncomingMessage,b:any){const h=header(req,'mcp-protocol-version');const m=getMeta(b);if(!h)return {status:400,response:err(b?.id,-32602,'Missing MCP-Protocol-Version header')};if(h!==VERSION)return {status:400,response:err(b?.id,-32022,'Unsupported protocol version',{supportedVersions:[VERSION]})};if(m?.['io.modelcontextprotocol/protocolVersion']!==h)return {status:400,response:err(b?.id,-32020,'Header mismatch',{header:'MCP-Protocol-Version',expected:m?.['io.modelcontextprotocol/protocolVersion'],received:h})};if(!m||typeof m!=='object'||!m['io.modelcontextprotocol/clientCapabilities'])return {status:400,response:err(b?.id,-32602,'Invalid params: missing required _meta fields')};if(header(req,'mcp-method')!==b?.method)return {status:400,response:err(b?.id,-32020,'Header mismatch',{header:'Mcp-Method'})};if(['tools/call','resources/read','prompts/get'].includes(b?.method)){const expected=b.method==='tools/call'?b?.params?.name:b.method==='resources/read'?b?.params?.uri:b?.params?.name;if(header(req,'mcp-name')!==expected)return {status:400,response:err(b?.id,-32020,'Header mismatch',{header:'Mcp-Name'})};}return null;}
+function invalid(id:number|string,message:string){return err(id,-32602,message);}
+function paginate<T>(items:T[],cursor:any){if(cursor!==undefined&&typeof cursor!=='string')return null;const start=cursor===undefined?0:Number(cursor||0);if(!Number.isInteger(start)||start<0||start>items.length)return null;const page=items.slice(start,start+50);const out:any={items:page};if(start+50<items.length)out.nextCursor=String(start+50);return out;}
+async function handle(b:any,req:http.IncomingMessage,res:http.ServerResponse):Promise<{response:any;sse?:boolean}|null>{const id=b.id, p=(b.params||{}) as Json, method=b.method;switch(method){
+ case 'server/discover': return {response:{jsonrpc:'2.0',id,result:result({supportedVersions:[VERSION],capabilities:caps,instructions:INSTRUCTIONS,ttlMs:300000,cacheScope:'public'})}};
+ case 'tools/list':{const x=paginate(toolDefs,p.cursor);if(!x)return {response:invalid(id,'Invalid cursor')};return {response:{jsonrpc:'2.0',id,result:result({tools:x.items,...('nextCursor'in x?{nextCursor:x.nextCursor}:{}),ttlMs:300000,cacheScope:'public'})}};}
