+ case 'resources/templates/list':return {response:{jsonrpc:'2.0',id,result:result({resourceTemplates:[{uriTemplate:'notes://notes/{id}',name:'note',title:'A single note',mimeType:'text/markdown'}],ttlMs:300000,cacheScope:'public'})}};
+ case 'resources/read':{const uri=String(p.uri||'');let contents:any;if(uri==='notes://index')contents={uri,mimeType:'application/json',text:j(sorted().map(n=>({id:n.id,notebook:n.notebook,title:n.title}))) };else {const m=/^notes:\/\/notes\/(n\d+)$/.exec(uri);const n=m&&notes.find(x=>x.id===m[1]);if(!n)return {response:err(id,-32602,'Resource not found')};contents={uri,mimeType:'text/markdown',text:`# ${n.title}\n\n${n.body}\n`};}return {response:{jsonrpc:'2.0',id,result:result({contents:[contents],ttlMs:0,cacheScope:'private'})}};}
+ case 'prompts/list':return {response:{jsonrpc:'2.0',id,result:result({prompts:[promptDef],ttlMs:300000,cacheScope:'public'})}};
+ case 'prompts/get':{const name=p.name,args=(p.arguments||{}) as Json;if(name!=='summarize_notebook'||typeof args.notebook!=='string'||!args.notebook)return {response:invalid(id,'Invalid prompt arguments')};const style=args.style===undefined?'brief':args.style;if(style!=='brief'&&style!=='detailed')return {response:invalid(id,'Invalid style')};const ns=sorted().filter(n=>n.notebook===args.notebook);const text=style==='brief'?`Summarize the notes in the "${args.notebook}" notebook in two sentences.`:`Summarize the notes in the "${args.notebook}" notebook in detail, one paragraph per note.`;const messages:any[]=[{role:'user',content:{type:'text',text}}];for(const n of ns)messages.push({role:'user',content:{type:'resource',resource:{uri:noteUri(n),mimeType:'text/markdown',text:`# ${n.title}\n\n${n.body}\n`}}});return {response:{jsonrpc:'2.0',id,result:result({description:promptDef.description,messages})}};}
+ case 'tools/call':{const name=p.name,args=(p.arguments||{}) as Json;if(typeof name!=='string')return {response:invalid(id,'Missing tool name')};if(name==='add_note'){const nb=args.notebook,title=args.title,body=args.body;if(typeof nb!=='string'||!/^[A-Za-z0-9_-]{1,64}$/.test(nb))return {response:{jsonrpc:'2.0',id,result:result({isError:true,content:[{type:'text',text:'Invalid notebook: must match [A-Za-z0-9_-] and be 1-64 characters'}]})}};if(header(req,'mcp-param-notebook')!==undefined&&header(req,'mcp-param-notebook')!==nb)return {response:err(id,-32020,'Header mismatch',{header:'Mcp-Param-Notebook'})};if(typeof title!=='string'||!title)return {response:{jsonrpc:'2.0',id,result:{resultType:'complete',isError:true,content:[{type:'text',text:'Invalid title: must be non-empty'}]}}};if(title.length>200)return {response:{jsonrpc:'2.0',id,result:{resultType:'complete',isError:true,content:[{type:'text',text:'Invalid title: at most 200 characters'}]}}};if(typeof body!=='string')return {response:{jsonrpc:'2.0',id,result:{resultType:'complete',isError:true,content:[{type:'text',text:'Invalid body: must be a string'}]}}};const n={id:'n'+nextId++,notebook:nb,title,body};notes.push(n);const out={id:n.id,uri:noteUri(n),notebook:nb,wordCount:words(body)};notify('notes://index');return {response:{jsonrpc:'2.0',id,result:result({structuredContent:out,content:[{type:'text',text:j(out)}]})}};}
+ if(name==='delete_note'){const ident=args.id;if(typeof ident!=='string')return {response:invalid(id,'Invalid id')};const n=notes.find(x=>x.id===ident);if(!n)return {response:{jsonrpc:'2.0',id,result:{resultType:'complete',isError:true,content:[{type:'text',text:`Note ${ident} not found`}]}}};const ir=(p.inputResponses||{}) as Json;if(!ir.confirm_delete){const meta=getMeta(b);if(!(meta?.['io.modelcontextprotocol/clientCapabilities'] as any)?.elicitation?.form)return {response:err(id,-32021,'Missing required client capability',{requiredCapabilities:['elicitation.form']})};return {response:{jsonrpc:'2.0',id,result:{resultType:'input_required',inputRequests:{confirm_delete:{method:'elicitation/create',params:{mode:'form',message:`Delete note "${n.title}"?`,requestedSchema:{type:'object',properties:{confirm:{type:'boolean'}},required:['confirm']}}}},requestState:token(n as Note)}}};const state=p.requestState;if(typeof state!=='string'||!verifyToken(state as string,ident as string))return {response:invalid(id,'Invalid requestState')};const ans=ir.confirm_delete as any;if(ans.action==='accept'&&ans.content?.confirm===true){notes.splice(notes.indexOf(n as Note),1);notify('notes://index');notify(noteUri(n as Note));return {response:{jsonrpc:'2.0',id,result:result({content:[{type:'text',text:`Deleted note ${ident}`}]})}}}return {response:{jsonrpc:'2.0',id,result:result({content:[{type:'text',text:'Deletion cancelled'}]})}};}
+ }
+ if(name==='reindex'){const steps:any=args.steps===undefined?5:args.steps,delay:any=args.delayMs===undefined?200:args.delayMs;if(!Number.isInteger(steps)||steps<1||steps>20||!Number.isInteger(delay)||delay<0||delay>1000)return {response:{jsonrpc:'2.0',id,result:{resultType:'complete',isError:true,content:[{type:'text',text:'Invalid steps or delayMs'}]}}};const pt=(p._meta as any)?.progressToken; if(pt!==undefined){sse(res);let canceled=false;res.on('close',()=>{canceled=true});for(let k=1;k<=steps;k++){await new Promise<void>(r=>setTimeout(r,delay));if(canceled||res.writableEnded)return null;event(res,{jsonrpc:'2.0',method:'notifications/progress',params:{progressToken:pt,progress:k,total:steps,message:`Indexed ${k}/${steps}`}});}return {sse:true,response:{jsonrpc:'2.0',id,result:result({content:[{type:'text',text:`Reindex complete: ${steps} steps`}]})}};}await new Promise<void>(r=>setTimeout(r,steps*delay));return {response:{jsonrpc:'2.0',id,result:result({content:[{type:'text',text:`Reindex complete: ${steps} steps`}]})}};}
+ }
+ }
+ if(method==='subscriptions/listen'){const f=(p.notifications||{}) as Json;sse(res);const sub:Sub={res,id,filter:f,closed:false};subs.add(sub);res.on('close',()=>{sub.closed=true;subs.delete(sub)});event(res,{jsonrpc:'2.0',method:'notifications/subscriptions/acknowledged',params:{_meta:{'io.modelcontextprotocol/subscriptionId':id},notifications:f}});return {sse:true,response:null};}
+ return {response:err(id,-32601,'Method not found')};}
+const srv=http.createServer(async(req,res)=>{if(req.method!=='POST'||req.url!=='/mcp'){send(res,404,err(null,-32601,'Method not found'));return;}const origin=header(req,'origin');if(origin&&origin!==`http://localhost:${PORT}`&&origin!==`http://127.0.0.1:${PORT}`){send(res,403,err(null,-32600,'Forbidden origin'));return;}const b=await body(req);if(!b){send(res,400,err(null,-32700,'Parse error'));return;}if(b.jsonrpc!=='2.0'||typeof b.method!=='string'||(b.id===null)||('id'in b&&typeof b.id!=='string'&&typeof b.id!=='number')){send(res,400,err(b.id,-32600,'Invalid Request'));return;}const vt=validateTransport(req,b);if(vt){send(res,vt.status,vt.response);return;}try{const out=await handle(b,req,res);if(!out)return;if(out.sse){if(out.response)event(res,out.response);if(b.method!=='subscriptions/listen')res.end();return;}if(!('id'in b)){send(res,202);return;}send(res,out.response?.error?.code===-32601?404:200,out.response);}catch(e){if(!res.headersSent)send(res,500,err(b.id,-32603,'Internal error'));}});
