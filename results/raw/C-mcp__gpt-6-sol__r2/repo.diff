+import test from 'node:test'; import assert from 'node:assert/strict'; import {spawn} from 'node:child_process';
+const port=33123; let child:any;
+function call(body:any,headers:any={}){return fetch(`http://127.0.0.1:${port}/mcp`,{method:'POST',headers:{'content-type':'application/json','accept':'application/json, text/event-stream','mcp-protocol-version':'2026-07-28','mcp-method':body.method,...headers},body:JSON.stringify(body)});}
+const meta={ 'io.modelcontextprotocol/protocolVersion':'2026-07-28','io.modelcontextprotocol/clientCapabilities':{}};
+test.before(async()=>{child=spawn('node',['dist/server.js'],{cwd:process.cwd(),env:{...process.env,PORT:String(port)}});for(let i=0;i<30;i++){try{await fetch(`http://127.0.0.1:${port}/mcp`);break}catch{await new Promise(r=>setTimeout(r,50));}}});
+test.after(()=>child.kill());
+test('discover and list tools',async()=>{let r=await call({jsonrpc:'2.0',id:1,method:'server/discover',params:{_meta:meta}});assert.equal(r.status,200);let x:any=await r.json();assert.deepEqual(x.result.supportedVersions,['2026-07-28']);r=await call({jsonrpc:'2.0',id:2,method:'tools/list',params:{_meta:meta}});x=await r.json();assert.equal(x.result.tools.length,3);});
+test('resource and add note',async()=>{let r=await call({jsonrpc:'2.0',id:3,method:'tools/call',params:{name:'add_note',arguments:{notebook:'work',title:'Test',body:'one two'},_meta:meta}},{'mcp-name':'add_note','mcp-param-notebook':'work'});let x:any=await r.json();assert.equal(x.result.structuredContent.wordCount,2);r=await call({jsonrpc:'2.0',id:4,method:'resources/read',params:{uri:'notes://index',_meta:meta}},{'mcp-name':'notes://index'});x=await r.json();assert.match(x.result.contents[0].text,/Test/);});
