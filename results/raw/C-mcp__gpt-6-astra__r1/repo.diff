--- /dev/null
+++ b/test/server.test.js
@@ -0,0 +1,11 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {spawn} from 'node:child_process';
+
+let child, base, available=true;
+test.before(async()=>{child=spawn('node',['dist/server.js'],{env:{...process.env,PORT:'3311'}}); await new Promise(r=>setTimeout(r,150)); base='http://127.0.0.1:3311/mcp'; try { await fetch(base); } catch { available=false; }});
+test.after(()=>child?.kill());
+async function rpc(method,params={},id=1,extra={}){const headers={'content-type':'application/json','accept':'application/json, text/event-stream','mcp-protocol-version':'2026-07-28','mcp-method':method,...extra}; if(params.name)headers['mcp-name']=params.name;if(params.uri)headers['mcp-name']=params.uri; const r=await fetch(base,{method:'POST',headers,body:JSON.stringify({jsonrpc:'2.0',id,method,params:{...params,_meta:{'io.modelcontextprotocol/protocolVersion':'2026-07-28','io.modelcontextprotocol/clientCapabilities':{}}}})});return [r,await r.json()]}
+test('discover and list tools',async t=>{if(!available)return t.skip('localhost networking unavailable');const [r,j]=await rpc('server/discover');assert.equal(r.status,200);assert.equal(j.result._meta['io.modelcontextprotocol/serverInfo'].name,'field-notes');assert.equal(j.result.supportedVersions[0],'2026-07-28');const [,l]=await rpc('tools/list');assert.deepEqual(l.result.tools.map(x=>x.name),['add_note','delete_note','reindex']);});
+test('add and read note',async t=>{if(!available)return t.skip('localhost networking unavailable');const [,j]=await rpc('tools/call',{name:'add_note',arguments:{notebook:'test',title:'Hello',body:'one two'},_meta:{}} ,2,{'mcp-param-notebook':'test'});assert.equal(j.result.structuredContent.wordCount,2);const [,r]=await rpc('resources/read',{uri:j.result.structuredContent.uri});assert.match(r.result.contents[0].text,/Hello/);});
+test('origin rejected and protocol mismatch',async t=>{if(!available)return t.skip('localhost networking unavailable');let r=await fetch(base,{method:'POST',headers:{origin:'http://evil.test'}});assert.equal(r.status,403);r=await fetch(base,{method:'POST',headers:{'content-type':'application/json','mcp-protocol-version':'bad'},body:JSON.stringify({jsonrpc:'2.0',id:1,method:'tools/list',params:{_meta:{'io.modelcontextprotocol/protocolVersion':'bad'}}})});assert.equal(r.status,400);});
