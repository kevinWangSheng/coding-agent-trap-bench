+def test_setattr_inherited_attribute_restores_instance_state() -> None:
+    class Parent:
+        value = 1
+
+    target = Parent()
+    monkeypatch = MonkeyPatch()
+    monkeypatch.setattr(target, "value", 2)
+    assert target.value == 2
+    monkeypatch.undo()
+    assert target.value == 1
+    assert vars(target) == {}
+
+
+def test_setattr_inherited_descriptor_restores_dynamic_lookup() -> None:
+    class Descriptor:
+        def __get__(self, instance, owner):
+            return object()
+
+    class Parent:
+        value = Descriptor()
+
+    target = Parent()
+    original = target.value
+    monkeypatch = MonkeyPatch()
+    monkeypatch.setattr(target, "value", object())
+    monkeypatch.undo()
+    assert target.value is not original
+    assert vars(target) == {}
+
