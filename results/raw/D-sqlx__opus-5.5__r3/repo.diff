+#[sqlx_macros::test]
+async fn it_executes_large_multi_statement_script() -> anyhow::Result<()> {
+    let mut conn = new::<Sqlite>().await?;
+
+    const N: usize = 20_000;
+
+    let mut script = String::from(
+        "CREATE TEMPORARY TABLE script_test (id INTEGER PRIMARY KEY, n INTEGER NOT NULL);\n",
+    );
+    for i in 0..N {
+        script.push_str(&format!(
+            "-- row {i}\nINSERT INTO script_test (n) VALUES ({i});;\n/* c */ UPDATE script_test SET n = n + 1 WHERE id = {};\n",
+            i + 1
+        ));
+    }
+    script.push_str("SELECT 1; -- trailing comment\n  \n");
+
+    let done = sqlx::raw_sql(sqlx::AssertSqlSafe(script)).execute(&mut conn).await?;
+    assert_eq!(done.rows_affected(), 2 * N as u64);
+
+    let (count, sum): (i64, i64) = sqlx::query_as("SELECT count(*), sum(n) FROM script_test")
+        .fetch_one(&mut conn)
+        .await?;
+    assert_eq!(count, N as i64);
+    assert_eq!(sum, (1..=N as i64).sum::<i64>());
+
+    // an error in the middle of the script stops execution there
+    let err = sqlx::raw_sql(
+        "INSERT INTO script_test (n) VALUES (-1); SELECT * FROM does_not_exist; INSERT INTO script_test (n) VALUES (-2);",
+    )
+    .execute(&mut conn)
+    .await
+    .unwrap_err();
+    assert!(err.to_string().contains("no such table"), "{err}");
+
+    let ns: Vec<i64> = sqlx::query_scalar("SELECT n FROM script_test WHERE n < 0")
+        .fetch_all(&mut conn)
+        .await?;
+    assert_eq!(ns, [-1]);
+
+    Ok(())
+}
+
+#[sqlx_macros::test]
+async fn it_enforces_sql_length_limit_on_remaining_script() -> anyhow::Result<()> {
+    use libsqlite3_sys::{sqlite3_limit, SQLITE_LIMIT_SQL_LENGTH};
+
+    let mut conn = SqliteConnection::connect("sqlite::memory:").await?;
+    // load the schema first, as the (tiny) limit would also apply to that
+    sqlx::query("SELECT count(*) FROM sqlite_master").execute(&mut conn).await?;
+
+    {
+        let mut handle = conn.lock_handle().await?;
+        unsafe { sqlite3_limit(handle.as_raw_handle().as_ptr(), SQLITE_LIMIT_SQL_LENGTH, 59) };
+    }
+
+    // each statement is short, but SQLite checks the length of the whole remaining input
+    let script = "SELECT 1; SELECT 2; SELECT 3; SELECT 4; SELECT 5; SELECT 6; SELECT 7; SELECT 8;";
+    assert!(script.len() > 59);
+
+    let err = sqlx::raw_sql(script).execute(&mut conn).await.unwrap_err();
+    assert!(err.to_string().contains("statement too long"), "{err}");
+
+    // exactly at the limit is fine
+    let script = &script[..59];
+    assert!(script.ends_with("SELECT 6;"));
+    sqlx::raw_sql(sqlx::AssertSqlSafe(script)).execute(&mut conn).await?;
+
+    Ok(())
+}
