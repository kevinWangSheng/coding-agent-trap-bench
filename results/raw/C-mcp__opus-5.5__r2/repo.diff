+      ["resources/read", { uri: "notes://index" }],
+      ["prompts/get", { name: "summarize_notebook", arguments: { notebook: "work" } }],
+    ];
+    for (const [method, params] of cases) {
+      let res = await rpc(server.port, method, params, { headers: { "Mcp-Name": undefined } });
+      assert.equal(res.status, 400, method);
+      assert.equal(res.json.error.code, -32020, method);
+      res = await rpc(server.port, method, params, { headers: { "Mcp-Name": "something-else" } });
+      assert.equal(res.status, 400, method);
+      assert.equal(res.json.error.code, -32020, method);
+    }
+  });
+
+  it("decodes a Base64-encoded Mcp-Name before comparing", async () => {
+    const encoded = `=?base64?${Buffer.from("notes://index").toString("base64")}?=`;
+    const res = await rpc(server.port, "resources/read", { uri: "notes://index" }, { headers: { "Mcp-Name": encoded } });
+    assert.equal(res.status, 200);
+    assert.equal(res.json.result.resultType, "complete");
+  });
+
+  it("treats header names case-insensitively", async () => {
+    const res = await rpc(server.port, "tools/list", {}, {
+      headers: { "mcp-protocol-version": PROTOCOL_VERSION, "MCP-METHOD": "tools/list" },
+    });
+    assert.equal(res.status, 200);
+  });
+});
+
+describe("HTTP transport", () => {
+  it("returns 404 with -32601 for unknown methods", async () => {
+    for (const method of ["ping", "resources/subscribe", "logging/setLevel", "nope/nope"]) {
+      const res = await rpc(server.port, method);
+      assert.equal(res.status, 404, method);
+      assert.equal(res.json.error.code, -32601, method);
+    }
+  });
+
+  it("answers GET and DELETE with 405", async () => {
+    for (const method of ["GET", "DELETE"]) {
+      const res = await httpRequest(server.port, { method, headers: { Accept: "text/event-stream" } });
+      assert.equal(res.status, 405, method);
+    }
+  });
+
+  it("accepts notifications with 202 and no body", async () => {
+    const res = await httpRequest(server.port, {
+      headers: { "Content-Type": "application/json", Accept: "application/json, text/event-stream" },
+      body: JSON.stringify({ jsonrpc: "2.0", method: "notifications/cancelled", params: { requestId: 1 } }),
+    });
+    assert.equal(res.status, 202);
+    assert.equal(res.body, "");
+  });
+
+  it("rejects malformed JSON with a parse error", async () => {
+    const res = await httpRequest(server.port, {
+      headers: { "Content-Type": "application/json", Accept: "application/json, text/event-stream" },
+      body: "{not json",
+    });
+    assert.equal(res.status, 400);
+    assert.equal(res.json.error.code, -32700);
+  });
+
+  it("rejects batches and client-sent responses as invalid requests", async () => {
+    for (const body of [[{ jsonrpc: "2.0", id: 1, method: "tools/list" }], { jsonrpc: "2.0", id: 1, result: {} }]) {
+      const res = await httpRequest(server.port, {
+        headers: { "Content-Type": "application/json", Accept: "application/json, text/event-stream" },
+        body: JSON.stringify(body),
+      });
+      assert.equal(res.status, 400);
+      assert.equal(res.json.error.code, -32600);
+    }
+  });
+
+  it("rejects browser requests from foreign origins with 403", async () => {
+    const res = await rpc(server.port, "tools/list", {}, { headers: { Origin: "http://evil.example" } });
+    assert.equal(res.status, 403);
+    const other = await rpc(server.port, "tools/list", {}, { headers: { Origin: "http://localhost:1" } });
+    assert.equal(other.status, 403);
+  });
+
+  it("allows browser requests from localhost and 127.0.0.1 on the server port", async () => {
+    for (const origin of [`http://localhost:${server.port}`, `http://127.0.0.1:${server.port}`]) {
+      const res = await rpc(server.port, "tools/list", {}, { headers: { Origin: origin } });
+      assert.equal(res.status, 200, origin);
