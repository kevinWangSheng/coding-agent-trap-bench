+// Streamable HTTP transport, per-request metadata and discovery.
+
+import assert from "node:assert/strict";
+import { after, before, describe, it } from "node:test";
+import { PROTOCOL_VERSION, buildRequest, httpRequest, rpc, startServer, type RunningServer } from "./helpers.ts";
+
+let server: RunningServer;
+before(async () => {
+  server = await startServer();
+});
+after(async () => {
+  await server.stop();
+});
+
+const SERVER_INFO = { name: "field-notes", version: "1.0.0" };
+
+describe("server/discover", () => {
+  it("advertises version, capabilities, identity, instructions and caching hints", async () => {
+    const res = await rpc(server.port, "server/discover");
+    assert.equal(res.status, 200);
+    assert.match(res.headers["content-type"]!, /^application\/json/);
+    const r = res.json.result;
+    assert.equal(res.json.jsonrpc, "2.0");
+    assert.equal(r.resultType, "complete");
+    assert.deepEqual(r.supportedVersions, [PROTOCOL_VERSION]);
+    assert.deepEqual(r.capabilities, { tools: {}, resources: { subscribe: true }, prompts: {} });
+    assert.deepEqual(r._meta["io.modelcontextprotocol/serverInfo"], SERVER_INFO);
+    assert.equal(
+      r.instructions,
+      "Field Notes stores short notes grouped into notebooks. Use add_note to save a note, read notes://index to see what exists.",
+    );
+    assert.equal(r.ttlMs, 300000);
+    assert.equal(r.cacheScope, "public");
+  });
+
+  it("includes serverInfo in every result", async () => {
+    for (const method of ["tools/list", "resources/list", "prompts/list", "resources/templates/list"]) {
+      const res = await rpc(server.port, method);
+      assert.deepEqual(res.json.result._meta["io.modelcontextprotocol/serverInfo"], SERVER_INFO, method);
+    }
+  });
+});
+
+describe("protocol version and _meta", () => {
+  it("rejects an unsupported version with UnsupportedProtocolVersionError (400)", async () => {
+    const res = await rpc(server.port, "tools/list", {}, {
+      meta: { "io.modelcontextprotocol/protocolVersion": "2025-11-25" },
+      headers: { "MCP-Protocol-Version": "2025-11-25" },
+    });
+    assert.equal(res.status, 400);
+    assert.equal(res.json.error.code, -32022);
+    assert.deepEqual(res.json.error.data, { supported: [PROTOCOL_VERSION], requested: "2025-11-25" });
+  });
+
+  it("rejects a legacy initialize request naming the supported versions", async () => {
+    const res = await httpRequest(server.port, {
+      headers: { "Content-Type": "application/json", Accept: "application/json, text/event-stream" },
+      body: JSON.stringify({
+        jsonrpc: "2.0", id: 1, method: "initialize",
+        params: { protocolVersion: "2025-11-25", capabilities: {}, clientInfo: { name: "old", version: "1" } },
+      }),
+    });
+    assert.equal(res.status, 400);
+    assert.equal(res.json.error.code, -32022);
+    assert.deepEqual(res.json.error.data.supported, [PROTOCOL_VERSION]);
+  });
+
+  it("rejects requests missing required _meta fields with -32602 (400)", async () => {
+    const { headers } = buildRequest("tools/list");
+    for (const params of [
+      undefined,
+      {},
+      { _meta: { "io.modelcontextprotocol/clientCapabilities": {} } },
+      { _meta: { "io.modelcontextprotocol/protocolVersion": PROTOCOL_VERSION } },
+    ]) {
+      const res = await httpRequest(server.port, {
+        headers,
+        body: JSON.stringify({ jsonrpc: "2.0", id: 7, method: "tools/list", params }),
+      });
+      assert.equal(res.status, 400, JSON.stringify(params));
+      assert.equal(res.json.error.code, -32602);
+      assert.equal(res.json.id, 7);
+    }
+  });
+
+  it("rejects an invalid log level", async () => {
+    const res = await rpc(server.port, "tools/list", {}, { meta: { "io.modelcontextprotocol/logLevel": "loud" } });
+    assert.equal(res.status, 400);
+    assert.equal(res.json.error.code, -32602);
+  });
+});
+
+describe("request metadata headers", () => {
+  it("requires MCP-Protocol-Version", async () => {
+    const res = await rpc(server.port, "tools/list", {}, { headers: { "MCP-Protocol-Version": undefined } });
+    assert.equal(res.status, 400);
+    assert.equal(res.json.error.code, -32020);
+  });
+
+  it("rejects MCP-Protocol-Version that differs from _meta", async () => {
+    const res = await rpc(server.port, "tools/list", {}, {
+      meta: { "io.modelcontextprotocol/protocolVersion": "2025-11-25" },
+    });
+    assert.equal(res.status, 400);
+    assert.equal(res.json.error.code, -32020);
+  });
+
+  it("requires Mcp-Method and checks it against the body", async () => {
+    let res = await rpc(server.port, "tools/list", {}, { headers: { "Mcp-Method": undefined } });
+    assert.equal(res.status, 400);
+    assert.equal(res.json.error.code, -32020);
+    res = await rpc(server.port, "tools/list", {}, { headers: { "Mcp-Method": "prompts/list" } });
+    assert.equal(res.status, 400);
+    assert.equal(res.json.error.code, -32020);
+  });
+
+  it("requires Mcp-Name for tools/call, resources/read and prompts/get", async () => {
+    const cases: [string, Record<string, unknown>][] = [
