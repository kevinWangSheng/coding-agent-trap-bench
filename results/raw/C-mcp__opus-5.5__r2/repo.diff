+// Resources, prompts and subscriptions/listen.
+
+import assert from "node:assert/strict";
+import { after, before, describe, it } from "node:test";
+import { openStream, rpc, sleep, startServer, type RunningServer } from "./helpers.ts";
+
+let server: RunningServer;
+before(async () => {
+  server = await startServer();
+});
+after(async () => {
+  await server.stop();
+});
+
+function addNote(notebook: string, title: string, body = "") {
+  return rpc(server.port, "tools/call", { name: "add_note", arguments: { notebook, title, body } });
+}
+
+async function deleteNote(id: string) {
+  const caps = { elicitation: { form: {} } };
+  const first = await rpc(server.port, "tools/call", { name: "delete_note", arguments: { id } }, { capabilities: caps });
+  const { inputRequests, requestState } = first.json.result;
+  const key = Object.keys(inputRequests)[0]!;
+  const res = await rpc(server.port, "tools/call", {
+    name: "delete_note",
+    arguments: { id },
+    inputResponses: { [key]: { action: "accept", content: { confirm: true } } },
+    requestState,
+  }, { capabilities: caps });
+  assert.equal(res.json.result.content[0].text, `Deleted note ${id}`);
+}
+
+describe("resources", () => {
+  it("lists only the index resource", async () => {
+    const res = await rpc(server.port, "resources/list");
+    const r = res.json.result;
+    assert.equal(r.resultType, "complete");
+    assert.equal(r.resources.length, 1);
+    assert.deepEqual(
+      { uri: r.resources[0].uri, name: r.resources[0].name, title: r.resources[0].title, mimeType: r.resources[0].mimeType },
+      { uri: "notes://index", name: "index", title: "All notes", mimeType: "application/json" },
+    );
+    assert.equal(r.ttlMs, 300000);
+    assert.equal(r.cacheScope, "public");
+  });
+
+  it("lists the note template", async () => {
+    const res = await rpc(server.port, "resources/templates/list");
+    const r = res.json.result;
+    assert.equal(r.resourceTemplates.length, 1);
+    const t = r.resourceTemplates[0];
+    assert.deepEqual(
+      { uriTemplate: t.uriTemplate, name: t.name, title: t.title, mimeType: t.mimeType },
+      { uriTemplate: "notes://notes/{id}", name: "note", title: "A single note", mimeType: "text/markdown" },
+    );
+    assert.equal(r.ttlMs, 300000);
+    assert.equal(r.cacheScope, "public");
+  });
+
+  it("reads the seeded index as private, never-fresh data", async () => {
+    const res = await rpc(server.port, "resources/read", { uri: "notes://index" });
+    const r = res.json.result;
+    assert.equal(r.ttlMs, 0);
+    assert.equal(r.cacheScope, "private");
+    assert.equal(r.contents.length, 1);
+    assert.equal(r.contents[0].uri, "notes://index");
+    assert.equal(r.contents[0].mimeType, "application/json");
+    assert.deepEqual(JSON.parse(r.contents[0].text), [
+      { id: "n1", notebook: "work", title: "Standup" },
+      { id: "n2", notebook: "work", title: "Retro actions" },
+      { id: "n3", notebook: "personal", title: "Groceries" },
+    ]);
+  });
+
+  it("reads a note as markdown", async () => {
+    const res = await rpc(server.port, "resources/read", { uri: "notes://notes/n1" });
+    const r = res.json.result;
+    assert.deepEqual(r.contents, [
+      { uri: "notes://notes/n1", mimeType: "text/markdown", text: "# Standup\n\nDiscussed the release schedule and blockers.\n" },
+    ]);
+    assert.equal(r.ttlMs, 0);
+    assert.equal(r.cacheScope, "private");
+  });
+
+  it("reports a missing resource with -32602", async () => {
+    for (const uri of ["notes://notes/n999", "notes://other", "file:///etc/passwd"]) {
+      const res = await rpc(server.port, "resources/read", { uri });
+      assert.equal(res.json.error.code, -32602, uri);
+      assert.equal(res.json.result, undefined);
+    }
+  });
+});
+
+describe("prompts", () => {
+  it("lists summarize_notebook", async () => {
+    const res = await rpc(server.port, "prompts/list");
+    const r = res.json.result;
+    assert.equal(r.prompts.length, 1);
+    assert.equal(r.prompts[0].name, "summarize_notebook");
+    const args = Object.fromEntries(r.prompts[0].arguments.map((a: any) => [a.name, !!a.required]));
+    assert.deepEqual(args, { notebook: true, style: false });
+    assert.equal(r.ttlMs, 300000);
+    assert.equal(r.cacheScope, "public");
+  });
+
+  it("builds a brief summary prompt with embedded notes", async () => {
+    const res = await rpc(server.port, "prompts/get", { name: "summarize_notebook", arguments: { notebook: "work" } });
+    const r = res.json.result;
+    assert.equal(r.resultType, "complete");
+    assert.equal(r.messages.length, 3);
+    assert.deepEqual(r.messages[0], {
+      role: "user",
+      content: { type: "text", text: 'Summarize the notes in the "work" notebook in two sentences.' },
+    });
+    assert.deepEqual(r.messages[1], {
+      role: "user",
+      content: {
+        type: "resource",
+        resource: { uri: "notes://notes/n1", mimeType: "text/markdown", text: "# Standup\n\nDiscussed the release schedule and blockers.\n" },
+      },
+    });
+    assert.equal(r.messages[2].content.resource.uri, "notes://notes/n2");
+  });
+
+  it("supports the detailed style and empty notebooks", async () => {
+    let res = await rpc(server.port, "prompts/get", {
+      name: "summarize_notebook", arguments: { notebook: "personal", style: "detailed" },
+    });
+    assert.equal(
+      res.json.result.messages[0].content.text,
+      'Summarize the notes in the "personal" notebook in detail, one paragraph per note.',
+    );
+    assert.equal(res.json.result.messages.length, 2);
+    res = await rpc(server.port, "prompts/get", { name: "summarize_notebook", arguments: { notebook: "empty" } });
+    assert.equal(res.json.result.messages.length, 1);
+  });
+
+  it("rejects bad arguments and unknown prompts with -32602", async () => {
+    for (const params of [
+      { name: "summarize_notebook", arguments: { notebook: "work", style: "long" } },
+      { name: "summarize_notebook", arguments: {} },
+      { name: "summarize_notebook" },
+      { name: "other", arguments: { notebook: "work" } },
+    ]) {
+      const res = await rpc(server.port, "prompts/get", params);
+      assert.equal(res.json.error.code, -32602, JSON.stringify(params));
+    }
+  });
+});
+
+describe("subscriptions/listen", () => {
+  it("acknowledges first, then notifies only watchers of changed URIs", async () => {
+    const indexWatcher = openStream(server.port, "subscriptions/listen", {
+      notifications: { resourceSubscriptions: ["notes://index"], toolsListChanged: true },
+    }, { id: "listen-index" });
+    const noteWatcher = openStream(server.port, "subscriptions/listen", {
+      notifications: { resourceSubscriptions: ["notes://notes/n2"] },
+    }, { id: 77 });
+
+    await indexWatcher.ready;
+    assert.equal(indexWatcher.status, 200);
+    assert.match(indexWatcher.contentType, /^text\/event-stream/);
+    const [ack] = await indexWatcher.waitFor((e) => e.length >= 1);
+    assert.deepEqual(ack!.data, {
+      jsonrpc: "2.0",
+      method: "notifications/subscriptions/acknowledged",
+      params: {
+        _meta: { "io.modelcontextprotocol/subscriptionId": "listen-index" },
+        notifications: { resourceSubscriptions: ["notes://index"] },
+      },
+    });
+    const [ack2] = await noteWatcher.waitFor((e) => e.length >= 1);
+    assert.equal(ack2!.data.params._meta["io.modelcontextprotocol/subscriptionId"], 77);
+
+    // Adding a note updates the index only.
+    await addNote("work", "New");
+    await indexWatcher.waitFor((e) => e.length >= 2);
+    assert.deepEqual(indexWatcher.events[1]!.data, {
+      jsonrpc: "2.0",
+      method: "notifications/resources/updated",
+      params: { _meta: { "io.modelcontextprotocol/subscriptionId": "listen-index" }, uri: "notes://index" },
+    });
+
+    // Deleting n1 updates the index and n1, which the note watcher does not watch.
+    await deleteNote("n1");
+    await indexWatcher.waitFor((e) => e.length >= 3);
+    await sleep(100);
+    assert.equal(noteWatcher.events.length, 1);
+
+    // Deleting n2 notifies both.
+    await deleteNote("n2");
+    await noteWatcher.waitFor((e) => e.length >= 2);
+    assert.deepEqual(noteWatcher.events[1]!.data.params, {
+      _meta: { "io.modelcontextprotocol/subscriptionId": 77 },
+      uri: "notes://notes/n2",
+    });
+    await indexWatcher.waitFor((e) => e.length >= 4);
+    await sleep(100);
+    assert.equal(indexWatcher.events.length, 4);
+    assert.ok(indexWatcher.events.every((e) => e.data.params.uri !== "notes://notes/n2"));
+
+    indexWatcher.close();
+    noteWatcher.close();
+  });
+
+  it("omits unsupported notification types from the acknowledgment", async () => {
+    const s = openStream(server.port, "subscriptions/listen", {
+      notifications: { toolsListChanged: true, promptsListChanged: true, resourcesListChanged: true },
+    });
+    const [ack] = await s.waitFor((e) => e.length >= 1);
+    assert.deepEqual(ack!.data.params.notifications, {});
+    s.close();
+  });
+
+  it("rejects a missing notifications filter", async () => {
+    const res = await rpc(server.port, "subscriptions/listen", {});
+    assert.equal(res.json.error.code, -32602);
+  });
+
+  it("ends subscriptions gracefully on server shutdown", async () => {
+    const own = await startServer();
+    try {
+      const s = openStream(own.port, "subscriptions/listen", {
+        notifications: { resourceSubscriptions: ["notes://index"] },
+      }, { id: "bye" });
+      await s.waitFor((e) => e.length >= 1);
+      await own.stop();
+      await s.waitFor((e) => e.length >= 2).catch(() => undefined);
+      const last = s.events.at(-1)!.data;
+      assert.equal(last.id, "bye");
+      assert.equal(last.result.resultType, "complete");
+      assert.equal(last.result._meta["io.modelcontextprotocol/subscriptionId"], "bye");
+    } finally {
+      await own.stop();
+    }
+  });
+});
