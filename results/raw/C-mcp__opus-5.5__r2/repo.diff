+// Tools: add_note (x-mcp-header), delete_note (MRTR elicitation), reindex (progress, cancellation).
+
+import assert from "node:assert/strict";
+import { after, before, describe, it } from "node:test";
+import { openStream, rpc, sleep, startServer, type RunningServer } from "./helpers.ts";
+
+let server: RunningServer;
+before(async () => {
+  server = await startServer();
+});
+after(async () => {
+  await server.stop();
+});
+
+const FORM = { elicitation: { form: {} } };
+
+async function callTool(name: string, args: Record<string, unknown>, opts: Parameters<typeof rpc>[3] = {}, extra = {}) {
+  return rpc(server.port, "tools/call", { name, arguments: args, ...extra }, opts);
+}
+
+async function readIndex(): Promise<{ id: string; notebook: string; title: string }[]> {
+  const res = await rpc(server.port, "resources/read", { uri: "notes://index" });
+  return JSON.parse(res.json.result.contents[0].text);
+}
+
+describe("tools/list", () => {
+  it("lists tools alphabetically with schemas and caching hints", async () => {
+    const res = await rpc(server.port, "tools/list");
+    assert.equal(res.status, 200);
+    const r = res.json.result;
+    assert.deepEqual(r.tools.map((t: any) => t.name), ["add_note", "delete_note", "reindex"]);
+    assert.equal(r.ttlMs, 300000);
+    assert.equal(r.cacheScope, "public");
+    assert.equal(r.nextCursor, undefined);
+    const add = r.tools[0];
+    assert.equal(add.inputSchema.type, "object");
+    assert.equal(add.inputSchema.properties.notebook["x-mcp-header"], "Notebook");
+    assert.deepEqual([...add.inputSchema.required].sort(), ["body", "notebook", "title"]);
+    assert.equal(add.outputSchema.type, "object");
+    assert.deepEqual([...add.outputSchema.required].sort(), ["id", "notebook", "uri", "wordCount"]);
+    for (const t of r.tools) assert.equal(t.inputSchema.type, "object");
+  });
+
+  it("rejects an unknown cursor", async () => {
+    const res = await rpc(server.port, "tools/list", { cursor: "bogus" });
+    assert.equal(res.json.error.code, -32602);
+  });
+});
+
+describe("add_note", () => {
+  it("creates a note and returns structured output plus JSON text", async () => {
+    const res = await callTool("add_note", { notebook: "work", title: "Plan", body: "  ship  the thing\n" });
+    assert.equal(res.status, 200);
+    const r = res.json.result;
+    assert.equal(r.resultType, "complete");
+    assert.equal(r.isError, false);
+    assert.deepEqual(r.structuredContent, { id: "n4", uri: "notes://notes/n4", notebook: "work", wordCount: 3 });
+    assert.equal(r.content[0].type, "text");
