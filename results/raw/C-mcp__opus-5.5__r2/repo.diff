+++ b/src/protocol.ts
@@ -0,0 +1,98 @@
+// Transport-independent MCP protocol pieces: constants, error type and
+// per-request metadata validation.
+
+export const PROTOCOL_VERSION = "2026-07-28";
+export const SUPPORTED_VERSIONS = [PROTOCOL_VERSION];
+
+export const SERVER_INFO = { name: "field-notes", version: "1.0.0" };
+
+export const INSTRUCTIONS =
+  "Field Notes stores short notes grouped into notebooks. Use add_note to save a note, read notes://index to see what exists.";
+
+export const META_PROTOCOL_VERSION = "io.modelcontextprotocol/protocolVersion";
+export const META_CLIENT_CAPABILITIES = "io.modelcontextprotocol/clientCapabilities";
+export const META_CLIENT_INFO = "io.modelcontextprotocol/clientInfo";
+export const META_LOG_LEVEL = "io.modelcontextprotocol/logLevel";
+export const META_SERVER_INFO = "io.modelcontextprotocol/serverInfo";
+export const META_SUBSCRIPTION_ID = "io.modelcontextprotocol/subscriptionId";
+
+export const PARSE_ERROR = -32700;
+export const INVALID_REQUEST = -32600;
+export const METHOD_NOT_FOUND = -32601;
+export const INVALID_PARAMS = -32602;
+export const INTERNAL_ERROR = -32603;
+export const HEADER_MISMATCH = -32020;
+export const MISSING_REQUIRED_CLIENT_CAPABILITY = -32021;
+export const UNSUPPORTED_PROTOCOL_VERSION = -32022;
+
+const LOG_LEVELS = new Set([
+  "debug", "info", "notice", "warning", "error", "critical", "alert", "emergency",
+]);
+
+export type RequestId = string | number;
+export type JsonObject = Record<string, unknown>;
+
+/** A JSON-RPC error, plus the HTTP status the Streamable HTTP transport should use. */
+export class RpcError extends Error {
+  constructor(
+    readonly code: number,
+    message: string,
+    readonly data?: unknown,
+    readonly httpStatus = 200,
+  ) {
+    super(message);
+  }
+}
+
+export function isObject(v: unknown): v is JsonObject {
+  return typeof v === "object" && v !== null && !Array.isArray(v);
+}
+
+export function unsupportedVersion(requested: unknown): RpcError {
+  return new RpcError(
+    UNSUPPORTED_PROTOCOL_VERSION,
+    `Unsupported protocol version: this server supports only ${SUPPORTED_VERSIONS.join(", ")}`,
+    { supported: SUPPORTED_VERSIONS, requested: typeof requested === "string" ? requested : String(requested) },
+    400,
+  );
+}
+
+export interface RequestMeta {
+  protocolVersion: string;
+  clientCapabilities: JsonObject;
+  progressToken?: string | number;
+  raw: JsonObject;
+}
+
+/** Validates the required per-request `_meta` fields (400 / -32602 if missing). */
+export function parseRequestMeta(params: JsonObject): RequestMeta {
+  const meta = params._meta;
+  if (!isObject(meta)) {
+    throw new RpcError(INVALID_PARAMS, "Missing required params._meta", undefined, 400);
+  }
+  const version = meta[META_PROTOCOL_VERSION];
+  if (typeof version !== "string" || version === "") {
+    throw new RpcError(INVALID_PARAMS, `Missing required _meta field ${META_PROTOCOL_VERSION}`, undefined, 400);
+  }
+  const caps = meta[META_CLIENT_CAPABILITIES];
+  if (!isObject(caps)) {
+    throw new RpcError(INVALID_PARAMS, `Missing required _meta field ${META_CLIENT_CAPABILITIES}`, undefined, 400);
+  }
+  const logLevel = meta[META_LOG_LEVEL];
+  if (logLevel !== undefined && (typeof logLevel !== "string" || !LOG_LEVELS.has(logLevel))) {
+    throw new RpcError(INVALID_PARAMS, `Invalid log level: ${JSON.stringify(logLevel)}`, undefined, 400);
+  }
+  const token = meta.progressToken;
+  const progressToken =
+    typeof token === "string" || (typeof token === "number" && Number.isInteger(token)) ? token : undefined;
+  return { protocolVersion: version, clientCapabilities: caps, progressToken, raw: meta };
+}
+
+/** Whether the client declared support for form-mode elicitation on this request. */
+export function supportsFormElicitation(caps: JsonObject): boolean {
+  const e = caps.elicitation;
+  if (!isObject(e)) return false;
+  // An empty elicitation object is equivalent to form-only support.
+  if (e.form === undefined && e.url === undefined) return true;
+  return isObject(e.form);
+}
