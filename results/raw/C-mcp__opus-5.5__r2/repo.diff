+// Wires the store, handlers and HTTP transport together.
+
+import type { Server } from "node:http";
+import type { AddressInfo } from "node:net";
+import { FieldNotesHandlers } from "./handlers.js";
+import { createMcpHttpServer } from "./http.js";
+import { createSeededStore } from "./store.js";
+
+export interface FieldNotesApp {
+  server: Server;
+  /** Gracefully ends subscriptions and in-flight work, then closes the server. */
+  stop(): Promise<void>;
+}
+
+export function createApp(configuredPort: number): FieldNotesApp {
+  const shutdown = new AbortController();
+  const server: Server = createMcpHttpServer({
+    handlers: new FieldNotesHandlers(createSeededStore()),
+    shutdown: shutdown.signal,
+    port: () => (server.address() as AddressInfo | null)?.port ?? configuredPort,
+  });
+
+  let stopping: Promise<void> | undefined;
+  const stop = () =>
+    (stopping ??= new Promise<void>((resolve) => {
+      shutdown.abort(new Error("Server shutting down"));
+      const force = setTimeout(() => server.closeAllConnections(), 1000);
+      force.unref();
+      server.close(() => {
+        clearTimeout(force);
+        resolve();
+      });
+      // Streams were just ended by the abort; drop the idle keep-alive sockets.
+      setImmediate(() => server.closeIdleConnections());
+    }));
+
+  return { server, stop };
+}
diff --git a/src/handlers.ts b/src/handlers.ts
new file mode 100644
index 0000000..86a7758
--- /dev/null
+++ b/src/handlers.ts
@@ -0,0 +1,527 @@
+// MCP method handlers for the Field Notes server.
+
+import {
+  INSTRUCTIONS,
+  INVALID_PARAMS,
+  METHOD_NOT_FOUND,
+  META_SUBSCRIPTION_ID,
+  MISSING_REQUIRED_CLIENT_CAPABILITY,
+  SUPPORTED_VERSIONS,
+  RpcError,
+  isObject,
+  supportsFormElicitation,
+  type JsonObject,
+  type RequestId,
+  type RequestMeta,
+} from "./protocol.js";
+import { RequestStateCodec } from "./requestState.js";
+import { INDEX_URI, NOTE_URI_PREFIX, NotesStore, noteMarkdown, noteUri } from "./store.js";
+
+export interface RequestContext {
+  id: RequestId;
+  method: string;
+  params: JsonObject;
+  meta: RequestMeta;
+  /** Aborted when the client goes away (cancellation) or the server shuts down. */
+  signal: AbortSignal;
+  /** Aborted only on server shutdown. */
+  shutdown: AbortSignal;
+  /** Sends a notification on this request's response stream (no-op if streaming is unavailable). */
+  notify(method: string, params: JsonObject): void;
+}
+
+// Discovery and list results may be cached by anyone for 5 minutes; note
+// contents are user data and never fresh.
+const LIST_CACHE = { ttlMs: 300_000, cacheScope: "public" } as const;
+const NOTE_CACHE = { ttlMs: 0, cacheScope: "private" } as const;
+
+const NOTEBOOK_RE = /^[A-Za-z0-9_-]{1,64}$/;
+const MAX_TITLE = 200;
+const CONFIRM_KEY = "confirm_delete";
+const REQUEST_STATE_TTL_MS = 10 * 60_000;
+
+export const TOOLS = [
+  {
+    name: "add_note",
+    title: "Add note",
+    description: "Create a note in a notebook. Returns the new note's id and resource URI.",
+    inputSchema: {
+      type: "object",
+      properties: {
+        notebook: {
+          type: "string",
+          description: "Notebook name: 1-64 characters from A-Z, a-z, 0-9, '_' and '-'.",
+          minLength: 1,
+          maxLength: 64,
+          pattern: "^[A-Za-z0-9_-]+$",
+          "x-mcp-header": "Notebook",
+        },
+        title: { type: "string", description: "Note title (1-200 characters).", minLength: 1, maxLength: MAX_TITLE },
+        body: { type: "string", description: "Note body; may be empty." },
+      },
+      required: ["notebook", "title", "body"],
+      additionalProperties: false,
+    },
+    outputSchema: {
+      type: "object",
+      properties: {
+        id: { type: "string" },
+        uri: { type: "string" },
+        notebook: { type: "string" },
+        wordCount: { type: "integer", minimum: 0 },
+      },
+      required: ["id", "uri", "notebook", "wordCount"],
+      additionalProperties: false,
+    },
+  },
+  {
+    name: "delete_note",
+    title: "Delete note",
+    description: "Delete a note by id. The user is asked to confirm before anything is deleted.",
+    inputSchema: {
+      type: "object",
+      properties: { id: { type: "string", description: "Note id, e.g. n1." } },
+      required: ["id"],
+      additionalProperties: false,
+    },
+    annotations: { destructiveHint: true, idempotentHint: true, readOnlyHint: false, openWorldHint: false },
+  },
+  {
+    name: "reindex",
+    title: "Rebuild search index",
+    description: "Rebuild the search index. Slow; reports progress after each step when requested.",
+    inputSchema: {
+      type: "object",
+      properties: {
+        steps: { type: "integer", minimum: 1, maximum: 20, default: 5, description: "Number of steps (1-20)." },
+        delayMs: { type: "integer", minimum: 0, maximum: 1000, default: 200, description: "Time per step in ms (0-1000)." },
+      },
+      additionalProperties: false,
+    },
+    annotations: { readOnlyHint: false, destructiveHint: false, idempotentHint: true, openWorldHint: false },
+  },
+] as const;
+
+/**
+ * Header mirrors declared via `x-mcp-header` for a tool: the property path in
+ * the arguments and the `Mcp-Param-{name}` suffix. Only chains of
+ * `properties` keys are considered (the statically reachable ones).
+ */
+export function toolHeaderParams(toolName: string): { path: string[]; header: string }[] {
+  const tool = TOOLS.find((t) => t.name === toolName);
+  if (!tool) return [];
+  const out: { path: string[]; header: string }[] = [];
+  const walk = (schema: unknown, path: string[]) => {
+    if (!isObject(schema) || !isObject(schema.properties)) return;
+    for (const [key, sub] of Object.entries(schema.properties)) {
+      if (isObject(sub) && typeof sub["x-mcp-header"] === "string") {
+        out.push({ path: [...path, key], header: sub["x-mcp-header"] });
+      }
+      walk(sub, [...path, key]);
+    }
+  };
+  walk(tool.inputSchema, []);
+  return out;
+}
+
+const PROMPTS = [
+  {
+    name: "summarize_notebook",
+    title: "Summarize notebook",
+    description: "Ask the model to summarize all notes in a notebook.",
+    arguments: [
+      { name: "notebook", description: "Notebook to summarize.", required: true },
+      { name: "style", description: "Summary style: brief (default) or detailed.", required: false },
+    ],
+  },
+];
+
+const INDEX_RESOURCE = {
+  uri: INDEX_URI,
+  name: "index",
+  title: "All notes",
+  description: "JSON list of every note's id, notebook and title.",
+  mimeType: "application/json",
+};
+
+const NOTE_TEMPLATE = {
+  uriTemplate: `${NOTE_URI_PREFIX}{id}`,
+  name: "note",
+  title: "A single note",
+  description: "A note rendered as Markdown.",
+  mimeType: "text/markdown",
+};
+
+function textResult(text: string, isError = false): JsonObject {
+  return { resultType: "complete", content: [{ type: "text", text }], isError };
+}
+
+function sleep(ms: number, signal: AbortSignal): Promise<void> {
+  return new Promise((resolve, reject) => {
+    if (signal.aborted) return reject(signal.reason);
+    const onAbort = () => {
+      clearTimeout(timer);
+      reject(signal.reason);
+    };
+    const timer = setTimeout(() => {
+      signal.removeEventListener("abort", onAbort);
+      resolve();
+    }, ms);
+    signal.addEventListener("abort", onAbort, { once: true });
+  });
+}
+
+/** Rejects a non-empty cursor: every list fits in a single page, so no cursor was ever issued. */
+function checkCursor(params: JsonObject): void {
+  if (params.cursor !== undefined) {
+    throw new RpcError(INVALID_PARAMS, "Invalid cursor");
+  }
+}
+
+function requireString(params: JsonObject, key: string): string {
+  const v = params[key];
+  if (typeof v !== "string") {
+    throw new RpcError(INVALID_PARAMS, `params.${key} must be a string`, undefined, 400);
+  }
+  return v;
+}
+
+/** Whether a URI can be watched through subscriptions/listen. */
+export function isWatchableUri(uri: string): boolean {
+  return uri === INDEX_URI || /^notes:\/\/notes\/[^/?#]+$/.test(uri);
+}
+
+export class FieldNotesHandlers {
+  constructor(
+    private readonly store: NotesStore,
+    private readonly states: RequestStateCodec = new RequestStateCodec(),
+  ) {}
+
+  async handle(ctx: RequestContext): Promise<JsonObject> {
+    switch (ctx.method) {
+      case "server/discover":
+        return this.discover();
+      case "tools/list":
+        checkCursor(ctx.params);
+        return { resultType: "complete", tools: TOOLS, ...LIST_CACHE };
+      case "tools/call":
+        return this.callTool(ctx);
+      case "resources/list":
+        checkCursor(ctx.params);
+        return { resultType: "complete", resources: [INDEX_RESOURCE], ...LIST_CACHE };
+      case "resources/templates/list":
+        checkCursor(ctx.params);
+        return { resultType: "complete", resourceTemplates: [NOTE_TEMPLATE], ...LIST_CACHE };
+      case "resources/read":
+        return this.readResource(ctx);
+      case "prompts/list":
+        checkCursor(ctx.params);
+        return { resultType: "complete", prompts: PROMPTS, ...LIST_CACHE };
+      case "prompts/get":
+        return this.getPrompt(ctx);
+      case "subscriptions/listen":
+        return this.listen(ctx);
+      default:
+        throw new RpcError(METHOD_NOT_FOUND, `Method not found: ${ctx.method}`, undefined, 404);
+    }
+  }
+
+  private discover(): JsonObject {
+    return {
+      resultType: "complete",
+      supportedVersions: SUPPORTED_VERSIONS,
+      capabilities: {
+        tools: {},
+        resources: { subscribe: true },
+        prompts: {},
+      },
+      instructions: INSTRUCTIONS,
+      ...LIST_CACHE,
+    };
+  }
+
+  // ---------------------------------------------------------------- tools
+
+  private async callTool(ctx: RequestContext): Promise<JsonObject> {
+    const name = requireString(ctx.params, "name");
+    const rawArgs = ctx.params.arguments;
+    if (rawArgs !== undefined && !isObject(rawArgs)) {
+      throw new RpcError(INVALID_PARAMS, "params.arguments must be an object", undefined, 400);
+    }
+    const args = rawArgs ?? {};
+    switch (name) {
+      case "add_note":
+        return this.addNote(args);
+      case "delete_note":
+        return this.deleteNote(ctx, args);
+      case "reindex":
+        return this.reindex(ctx, args);
+      default:
+        throw new RpcError(INVALID_PARAMS, `Unknown tool: ${name}`);
+    }
+  }
+
+  private addNote(args: JsonObject): JsonObject {
+    const problems: string[] = [];
+    const { notebook, title, body } = args;
+    for (const key of Object.keys(args)) {
+      if (!["notebook", "title", "body"].includes(key)) problems.push(`unknown argument '${key}'`);
+    }
+    if (notebook === undefined) problems.push("'notebook' is required");
+    else if (typeof notebook !== "string") problems.push("'notebook' must be a string");
+    else if (!NOTEBOOK_RE.test(notebook)) {
+      problems.push("'notebook' must be 1-64 characters from A-Z, a-z, 0-9, '_' and '-'");
+    }
+    if (title === undefined) problems.push("'title' is required");
+    else if (typeof title !== "string") problems.push("'title' must be a string");
+    else if (title.length === 0) problems.push("'title' must not be empty");
+    else if (title.length > MAX_TITLE) problems.push(`'title' must be at most ${MAX_TITLE} characters (got ${title.length})`);
+    if (body === undefined) problems.push("'body' is required");
+    else if (typeof body !== "string") problems.push("'body' must be a string");
+    if (problems.length > 0) {
+      return textResult(`Invalid arguments for add_note: ${problems.join("; ")}.`, true);
+    }
+
+    const note = this.store.add({
+      notebook: notebook as string,
+      title: title as string,
+      body: body as string,
+    });
+    const structured = {
+      id: note.id,
+      uri: noteUri(note.id),
+      notebook: note.notebook,
+      wordCount: note.body.split(/\s+/).filter((w) => w.length > 0).length,
+    };
+    return {
+      resultType: "complete",
+      content: [{ type: "text", text: JSON.stringify(structured) }],
+      structuredContent: structured,
+      isError: false,
+    };
+  }
+
+  private deleteNote(ctx: RequestContext, args: JsonObject): JsonObject {
+    const id = args.id;
+    for (const key of Object.keys(args)) {
+      if (key !== "id") return textResult(`Invalid arguments for delete_note: unknown argument '${key}'.`, true);
+    }
+    if (typeof id !== "string" || id === "") {
+      return textResult("Invalid arguments for delete_note: 'id' is required and must be a non-empty string.", true);
+    }
+    const note = this.store.get(id);
+    if (!note) return textResult(`Note ${id} not found`, true);
+
+    const rawState = ctx.params.requestState;
+    if (rawState !== undefined) {
+      if (typeof rawState !== "string") {
+        throw new RpcError(INVALID_PARAMS, "params.requestState must be a string", undefined, 400);
+      }
+      const state = this.states.decode(rawState);
+      if (!state || state.kind !== "delete_note_confirm") {
+        throw new RpcError(INVALID_PARAMS, "Invalid requestState");
+      }
+      if (typeof state.exp !== "number" || Date.now() > state.exp) {
+        throw new RpcError(INVALID_PARAMS, "Expired requestState; call the tool again without it");
+      }
+      // The confirmation is bound to the note it was issued for.
+      if (state.noteId !== id) {
+        throw new RpcError(INVALID_PARAMS, "requestState was issued for a different note");
+      }
+      const answer = this.confirmationAnswer(ctx.params.inputResponses);
+      if (answer === "confirmed") {
+        this.store.delete(id);
+        return textResult(`Deleted note ${id}`);
+      }
+      if (answer === "cancelled") return textResult("Deletion cancelled");
+      // No usable answer yet: ask again.
+    }
+
+    if (!supportsFormElicitation(ctx.meta.clientCapabilities)) {
+      throw new RpcError(
+        MISSING_REQUIRED_CLIENT_CAPABILITY,
+        "delete_note requires the elicitation (form mode) client capability to confirm deletion",
+        { requiredCapabilities: { elicitation: { form: {} } } },
+        400,
+      );
+    }
+    const requestState = this.states.encode({
+      kind: "delete_note_confirm",
+      method: "tools/call",
+      tool: "delete_note",
+      noteId: id,
+      exp: Date.now() + REQUEST_STATE_TTL_MS,
+    });
+    return {
+      resultType: "input_required",
+      inputRequests: {
+        [CONFIRM_KEY]: {
+          method: "elicitation/create",
+          params: {
+            mode: "form",
+            message: `Delete note "${note.title}"?`,
+            requestedSchema: {
+              type: "object",
+              properties: {
+                confirm: { type: "boolean", title: "Confirm", description: "Delete this note permanently." },
+              },
+              required: ["confirm"],
+            },
+          },
+        },
+      },
+      requestState,
+    };
+  }
+
+  private confirmationAnswer(inputResponses: unknown): "confirmed" | "cancelled" | "missing" {
+    if (inputResponses === undefined) return "missing";
+    if (!isObject(inputResponses)) {
+      throw new RpcError(INVALID_PARAMS, "params.inputResponses must be an object", undefined, 400);
+    }
+    const resp = inputResponses[CONFIRM_KEY];
+    if (resp === undefined) return "missing";
+    if (!isObject(resp) || !["accept", "decline", "cancel"].includes(resp.action as string)) {
+      throw new RpcError(INVALID_PARAMS, `Invalid elicitation result for '${CONFIRM_KEY}'`);
+    }
+    if (resp.action !== "accept") return "cancelled";
+    const content = resp.content;
+    if (!isObject(content) || typeof content.confirm !== "boolean") return "missing";
+    return content.confirm ? "confirmed" : "cancelled";
+  }
+
+  private async reindex(ctx: RequestContext, args: JsonObject): Promise<JsonObject> {
+    const problems: string[] = [];
+    for (const key of Object.keys(args)) {
+      if (key !== "steps" && key !== "delayMs") problems.push(`unknown argument '${key}'`);
+    }
+    const steps = args.steps ?? 5;
+    const delayMs = args.delayMs ?? 200;
+    if (typeof steps !== "number" || !Number.isInteger(steps) || steps < 1 || steps > 20) {
+      problems.push("'steps' must be an integer from 1 to 20");
+    }
+    if (typeof delayMs !== "number" || !Number.isInteger(delayMs) || delayMs < 0 || delayMs > 1000) {
+      problems.push("'delayMs' must be an integer from 0 to 1000");
+    }
+    if (problems.length > 0) {
+      return textResult(`Invalid arguments for reindex: ${problems.join("; ")}.`, true);
+    }
+    const total = steps as number;
+    const token = ctx.meta.progressToken;
+    for (let k = 1; k <= total; k++) {
+      await sleep(delayMs as number, ctx.signal);
+      if (token !== undefined) {
+        ctx.notify("notifications/progress", {
+          progressToken: token,
+          progress: k,
+          total,
+          message: `Indexed ${k}/${total}`,
+        });
+      }
+    }
+    return textResult(`Reindex complete: ${total} steps`);
+  }
+
+  // ------------------------------------------------------------ resources
+
+  private readResource(ctx: RequestContext): JsonObject {
+    const uri = requireString(ctx.params, "uri");
+    if (uri === INDEX_URI) {
+      const index = this.store.all().map((n) => ({ id: n.id, notebook: n.notebook, title: n.title }));
+      return {
+        resultType: "complete",
+        contents: [{ uri, mimeType: "application/json", text: JSON.stringify(index) }],
+        ...NOTE_CACHE,
+      };
+    }
+    if (uri.startsWith(NOTE_URI_PREFIX)) {
+      const note = this.store.get(uri.slice(NOTE_URI_PREFIX.length));
+      if (note) {
+        return {
+          resultType: "complete",
+          contents: [{ uri, mimeType: "text/markdown", text: noteMarkdown(note) }],
+          ...NOTE_CACHE,
+        };
+      }
+    }
+    throw new RpcError(INVALID_PARAMS, "Resource not found", { uri });
+  }
+
+  // -------------------------------------------------------------- prompts
+
+  private getPrompt(ctx: RequestContext): JsonObject {
+    const name = requireString(ctx.params, "name");
+    if (name !== "summarize_notebook") {
+      throw new RpcError(INVALID_PARAMS, `Unknown prompt: ${name}`);
+    }
+    const rawArgs = ctx.params.arguments;
+    if (rawArgs !== undefined && !isObject(rawArgs)) {
+      throw new RpcError(INVALID_PARAMS, "params.arguments must be an object");
+    }
+    const args = rawArgs ?? {};
+    const notebook = args.notebook;
+    if (typeof notebook !== "string" || notebook === "") {
+      throw new RpcError(INVALID_PARAMS, "Missing required argument: notebook");
+    }
+    const style = args.style ?? "brief";
+    if (style !== "brief" && style !== "detailed") {
+      throw new RpcError(INVALID_PARAMS, `Invalid argument style: ${JSON.stringify(style)} (expected "brief" or "detailed")`);
+    }
+    const instruction =
+      style === "brief"
+        ? `Summarize the notes in the "${notebook}" notebook in two sentences.`
+        : `Summarize the notes in the "${notebook}" notebook in detail, one paragraph per note.`;
+    const messages: JsonObject[] = [{ role: "user", content: { type: "text", text: instruction } }];
+    for (const note of this.store.all()) {
+      if (note.notebook !== notebook) continue;
+      messages.push({
+        role: "user",
+        content: {
+          type: "resource",
+          resource: { uri: noteUri(note.id), mimeType: "text/markdown", text: noteMarkdown(note) },
+        },
+      });
+    }
+    return { resultType: "complete", description: `Summarize the "${notebook}" notebook`, messages };
+  }
+
+  // -------------------------------------------------------- subscriptions
+
+  private listen(ctx: RequestContext): Promise<JsonObject> {
+    const filter = ctx.params.notifications;
+    if (!isObject(filter)) {
+      throw new RpcError(INVALID_PARAMS, "params.notifications must be an object", undefined, 400);
+    }
+    const requested = filter.resourceSubscriptions;
+    if (requested !== undefined && (!Array.isArray(requested) || !requested.every((u) => typeof u === "string"))) {
+      throw new RpcError(INVALID_PARAMS, "notifications.resourceSubscriptions must be an array of strings", undefined, 400);
+    }
+    // Tool, prompt and resource lists never change, so only resource
+    // subscriptions are honored.
+    const watched = [...new Set((requested ?? []) as string[])].filter(isWatchableUri);
+    const acknowledged: JsonObject = {};
+    if (requested !== undefined) acknowledged.resourceSubscriptions = watched;
+
+    const subscriptionId = ctx.id;
+    const meta = { [META_SUBSCRIPTION_ID]: subscriptionId };
+    ctx.notify("notifications/subscriptions/acknowledged", { _meta: meta, notifications: acknowledged });
+
+    return new Promise((resolve, reject) => {
+      const watchSet = new Set(watched);
+      const unsubscribe = this.store.onChange((uri) => {
+        if (watchSet.has(uri)) ctx.notify("notifications/resources/updated", { _meta: meta, uri });
+      });
+      const finish = () => {
+        unsubscribe();
+        if (ctx.shutdown.aborted) {
+          // Graceful closure: the server is ending the subscription.
+          resolve({ resultType: "complete", _meta: meta });
+        } else {
+          reject(ctx.signal.reason);
+        }
+      };
+      if (ctx.signal.aborted) finish();
+      else ctx.signal.addEventListener("abort", finish, { once: true });
+    });
+  }
+}
diff --git a/src/http.ts b/src/http.ts
new file mode 100644
index 0000000..b5d0715
--- /dev/null
+++ b/src/http.ts
@@ -0,0 +1,380 @@
+// Streamable HTTP transport (protocol revision 2026-07-28): one POST per
+// JSON-RPC message, answered with a JSON body or a per-request SSE stream.
+
+import { createServer, type IncomingMessage, type Server, type ServerResponse } from "node:http";
+import { FieldNotesHandlers, toolHeaderParams, type RequestContext } from "./handlers.js";
+import {
+  HEADER_MISMATCH,
+  INTERNAL_ERROR,
+  INVALID_PARAMS,
+  INVALID_REQUEST,
+  PARSE_ERROR,
+  META_SERVER_INFO,
+  SERVER_INFO,
+  SUPPORTED_VERSIONS,
+  RpcError,
+  isObject,
+  parseRequestMeta,
+  unsupportedVersion,
+  type JsonObject,
+  type RequestId,
+} from "./protocol.js";
+
+export const MCP_PATH = "/mcp";
+const MAX_BODY_BYTES = 1024 * 1024;
+const KEEPALIVE_MS = 15_000;
+
+/** Methods whose `Mcp-Name` header mirrors `params.name` / `params.uri`. */
+const NAME_SOURCES: Record<string, "name" | "uri"> = {
+  "tools/call": "name",
+  "prompts/get": "name",
+  "resources/read": "uri",
+};
+
+export interface McpHttpServerOptions {
+  handlers: FieldNotesHandlers;
+  /** Aborting this signal gracefully ends open subscriptions and in-flight work. */
+  shutdown: AbortSignal;
+  /** Returns the port the server is bound to (used for Origin validation). */
+  port: () => number;
+}
+
+function headerMismatch(message: string): RpcError {
+  return new RpcError(HEADER_MISMATCH, `Header mismatch: ${message}`, undefined, 400);
+}
+
+function sendJson(res: ServerResponse, status: number, body: unknown): void {
+  const text = JSON.stringify(body);
+  res.writeHead(status, {
+    "Content-Type": "application/json",
+    "Content-Length": Buffer.byteLength(text),
+  });
+  res.end(text);
+}
+
+function errorBody(id: RequestId | undefined, err: RpcError): JsonObject {
+  const error: JsonObject = { code: err.code, message: err.message };
+  if (err.data !== undefined) error.data = err.data;
+  return id === undefined ? { jsonrpc: "2.0", error } : { jsonrpc: "2.0", id, error };
+}
+
+function singleHeader(req: IncomingMessage, name: string): string | undefined {
+  const v = req.headers[name];
+  return Array.isArray(v) ? v.join(", ") : v;
+}
+
+/**
+ * Decodes an `Mcp-Name` / `Mcp-Param-*` header value, handling the
+ * `=?base64?...?=` sentinel. Returns undefined for invalid values.
+ */
+export function decodeHeaderValue(value: string): string | undefined {
+  if (!/^[\x20-\x7E\t]*$/.test(value)) return undefined;
+  const m = /^=\?base64\?(.*)\?=$/.exec(value);
+  if (!m) return value;
+  const b64 = m[1] ?? "";
+  if (!/^[A-Za-z0-9+/]*={0,2}$/.test(b64) || b64.length % 4 !== 0) return undefined;
+  try {
+    return new TextDecoder("utf-8", { fatal: true }).decode(Buffer.from(b64, "base64"));
+  } catch {
+    return undefined;
+  }
+}
+
+function headerMatchesValue(decoded: string, value: unknown): boolean {
+  if (typeof value === "string") return decoded === value;
+  if (typeof value === "boolean") return decoded === String(value);
+  if (typeof value === "number" && Number.isInteger(value)) {
+    // Compare integers numerically (e.g. "42.0" equals 42).
+    return decoded.trim() !== "" && Number(decoded) === value;
+  }
+  return false;
+}
+
+function mediaTypes(header: string | undefined): string[] {
+  return (header ?? "")
+    .split(",")
+    .map((p) => (p.split(";")[0] ?? "").trim().toLowerCase())
+    .filter((p) => p.length > 0);
+}
+
+function readBody(req: IncomingMessage): Promise<Buffer | undefined> {
+  return new Promise((resolve, reject) => {
+    const chunks: Buffer[] = [];
+    let size = 0;
+    let tooLarge = false;
+    req.on("data", (chunk: Buffer) => {
+      size += chunk.length;
+      if (size > MAX_BODY_BYTES) tooLarge = true;
+      else chunks.push(chunk);
+    });
+    req.on("end", () => resolve(tooLarge ? undefined : Buffer.concat(chunks)));
+    req.on("error", reject);
+  });
+}
+
+/** Checks the MCP request-metadata headers against the JSON-RPC body. */
+function validateRequestHeaders(req: IncomingMessage, method: string, params: JsonObject): void {
+  const versionHeader = singleHeader(req, "mcp-protocol-version");
+  if (versionHeader === undefined || versionHeader === "") {
+    throw headerMismatch("missing required MCP-Protocol-Version header");
+  }
+  if (!SUPPORTED_VERSIONS.includes(versionHeader)) throw unsupportedVersion(versionHeader);
+
+  const methodHeader = singleHeader(req, "mcp-method");
+  if (methodHeader === undefined) throw headerMismatch("missing required Mcp-Method header");
+  if (methodHeader !== method) {
+    throw headerMismatch(`Mcp-Method header value '${methodHeader}' does not match body value '${method}'`);
+  }
+
+  const meta = parseRequestMeta(params);
+  if (meta.protocolVersion !== versionHeader) {
+    throw headerMismatch(
+      `MCP-Protocol-Version header value '${versionHeader}' does not match _meta value '${meta.protocolVersion}'`,
+    );
+  }
+
+  const nameSource = NAME_SOURCES[method];
+  if (nameSource) {
+    const bodyName = params[nameSource];
+    if (typeof bodyName !== "string") {
+      throw new RpcError(INVALID_PARAMS, `params.${nameSource} must be a string`, undefined, 400);
+    }
+    const nameHeader = singleHeader(req, "mcp-name");
+    if (nameHeader === undefined) throw headerMismatch("missing required Mcp-Name header");
+    const decoded = decodeHeaderValue(nameHeader);
+    if (decoded === undefined) throw headerMismatch("Mcp-Name header contains invalid characters");
+    if (decoded !== bodyName) {
+      throw headerMismatch(`Mcp-Name header value '${decoded}' does not match body value '${bodyName}'`);
+    }
+  }
+
+  if (method === "tools/call" && typeof params.name === "string") {
+    const args = isObject(params.arguments) ? params.arguments : {};
+    for (const { path, header } of toolHeaderParams(params.name)) {
+      let value: unknown = args;
+      for (const key of path) value = isObject(value) ? value[key] : undefined;
+      const headerName = `Mcp-Param-${header}`;
+      const raw = singleHeader(req, headerName.toLowerCase());
+      if (value === undefined || value === null) {
+        if (raw !== undefined) throw headerMismatch(`${headerName} header present but argument '${path.join(".")}' is absent`);
+        continue;
+      }
+      if (raw === undefined) throw headerMismatch(`missing required ${headerName} header`);
+      const decoded = decodeHeaderValue(raw);
+      if (decoded === undefined) throw headerMismatch(`${headerName} header contains invalid characters`);
+      if (!headerMatchesValue(decoded, value)) {
+        throw headerMismatch(`${headerName} header value '${decoded}' does not match body value ${JSON.stringify(value)}`);
+      }
+    }
+  }
+}
+
+export function createMcpHttpServer(opts: McpHttpServerOptions): Server {
+  const { handlers, shutdown } = opts;
+
+  const isAllowedOrigin = (origin: string): boolean => {
+    const port = opts.port();
+    return origin === `http://localhost:${port}` || origin === `http://127.0.0.1:${port}`;
+  };
+
+  async function handle(req: IncomingMessage, res: ServerResponse): Promise<void> {
+    const path = new URL(req.url ?? "/", "http://localhost").pathname;
+    if (path !== MCP_PATH) {
+      sendJson(res, 404, { error: "Not found" });
+      return;
+    }
+
+    // DNS-rebinding protection.
+    const origin = req.headers.origin;
+    if (origin !== undefined && !isAllowedOrigin(origin)) {
+      sendJson(res, 403, errorBody(undefined, new RpcError(INVALID_REQUEST, "Forbidden: origin not allowed")));
+      return;
+    }
+
+    if (req.method !== "POST") {
+      // No GET stream or DELETE session in this revision.
+      res.writeHead(405, { Allow: "POST", "Content-Type": "application/json" });
+      res.end(JSON.stringify(errorBody(undefined, new RpcError(INVALID_REQUEST, "Method not allowed: use POST"))));
+      return;
+    }
+
+    const accepted = mediaTypes(req.headers.accept);
+    const anyAccept = accepted.length === 0 || accepted.includes("*/*");
+    const acceptsJson = anyAccept || accepted.includes("application/json") || accepted.includes("application/*");
+    const acceptsSse = anyAccept || accepted.includes("text/event-stream") || accepted.includes("text/*");
+    if (!acceptsJson && !acceptsSse) {
+      sendJson(res, 406, errorBody(undefined, new RpcError(INVALID_REQUEST,
+        "Not acceptable: Accept must include application/json and text/event-stream")));
+      return;
+    }
+
+    const contentType = mediaTypes(req.headers["content-type"])[0];
+    if (contentType !== "application/json") {
+      sendJson(res, 415, errorBody(undefined, new RpcError(INVALID_REQUEST, "Content-Type must be application/json")));
+      return;
+    }
+
+    const raw = await readBody(req);
+    if (raw === undefined) {
+      sendJson(res, 413, errorBody(undefined, new RpcError(INVALID_REQUEST, "Request body too large")));
+      return;
+    }
+
+    let msg: unknown;
+    try {
+      msg = JSON.parse(raw.toString("utf8"));
+    } catch {
+      sendJson(res, 400, errorBody(undefined, new RpcError(PARSE_ERROR, "Parse error: invalid JSON")));
+      return;
+    }
+
+    if (!isObject(msg) || msg.jsonrpc !== "2.0") {
+      sendJson(res, 400, errorBody(undefined, new RpcError(INVALID_REQUEST,
+        "Invalid Request: body must be a single JSON-RPC 2.0 request or notification")));
+      return;
+    }
+    if (typeof msg.method !== "string") {
+      const why = "result" in msg || "error" in msg ? "clients must not send JSON-RPC responses" : "missing method";
+      sendJson(res, 400, errorBody(undefined, new RpcError(INVALID_REQUEST, `Invalid Request: ${why}`)));
+      return;
+    }
+    const method = msg.method;
+    if (msg.params !== undefined && !isObject(msg.params)) {
+      const id = typeof msg.id === "string" || typeof msg.id === "number" ? msg.id : undefined;
+      sendJson(res, 400, errorBody(id, new RpcError(INVALID_PARAMS, "params must be an object")));
+      return;
+    }
+    const params = (msg.params ?? {}) as JsonObject;
+
+    if (!("id" in msg)) {
+      // Notification. None are defined for this transport (closing the
+      // stream is the cancellation signal), so accept and ignore.
+      res.writeHead(202).end();
+      return;
+    }
+    const id = msg.id;
+    if (!(typeof id === "string" || (typeof id === "number" && Number.isInteger(id)))) {
+      sendJson(res, 400, errorBody(undefined, new RpcError(INVALID_REQUEST, "Invalid Request: id must be a string or integer")));
+      return;
+    }
+
+    try {
+      if (method === "initialize") {
+        // Legacy handshake: name the versions we do support.
+        throw unsupportedVersion(params.protocolVersion ?? "unknown");
+      }
+      validateRequestHeaders(req, method, params);
+    } catch (err) {
+      const e = err instanceof RpcError ? err : new RpcError(INTERNAL_ERROR, "Internal error", undefined, 500);
+      sendJson(res, e.httpStatus, errorBody(id, e));
+      return;
+    }
+
+    if (method === "subscriptions/listen" && !acceptsSse) {
+      sendJson(res, 406, errorBody(id, new RpcError(INVALID_REQUEST,
+        "subscriptions/listen requires Accept: text/event-stream")));
+      return;
+    }
+
+    await runRequest(req, res, id, method, params, acceptsSse, acceptsJson);
+  }
+
+  async function runRequest(
+    _req: IncomingMessage,
+    res: ServerResponse,
+    id: RequestId,
+    method: string,
+    params: JsonObject,
+    acceptsSse: boolean,
+    acceptsJson: boolean,
+  ): Promise<void> {
+    // Closing the response stream (or the connection) is the cancellation
+    // signal. Node's HTTP server treats a peer half-close as an aborted
+    // request too, so watch the socket as well as the response.
+    const clientGone = new AbortController();
+    const socket = res.socket;
+    const onGone = () => {
+      if (res.writableFinished || clientGone.signal.aborted) return;
+      clientGone.abort(new Error("Client disconnected"));
+      res.destroy();
+    };
+    res.on("close", onGone);
+    socket?.on("end", onGone);
+    socket?.on("close", onGone);
+    res.on("finish", () => {
+      socket?.off("end", onGone);
+      socket?.off("close", onGone);
+    });
+    const signal = AbortSignal.any([clientGone.signal, shutdown]);
+
+    let streaming = false;
+    let keepalive: NodeJS.Timeout | undefined;
+    const startStream = () => {
+      if (streaming) return;
+      streaming = true;
+      res.writeHead(200, {
+        "Content-Type": "text/event-stream",
+        "Cache-Control": "no-cache, no-transform",
+        "X-Accel-Buffering": "no",
+      });
+      res.flushHeaders();
+      keepalive = setInterval(() => {
+        if (!res.writableEnded && !res.destroyed) res.write(":\n\n");
+      }, KEEPALIVE_MS);
+      keepalive.unref();
+    };
+    const writeEvent = (message: JsonObject) => {
+      if (res.writableEnded || res.destroyed) return;
+      res.write(`event: message\ndata: ${JSON.stringify(message)}\n\n`);
+    };
+    const finish = (message: JsonObject, status: number) => {
+      if (keepalive) clearInterval(keepalive);
+      if (clientGone.signal.aborted || res.writableEnded || res.destroyed) return;
+      if (!streaming && !acceptsJson) startStream();
+      if (streaming) {
+        writeEvent(message);
+        res.end();
+      } else {
+        sendJson(res, status, message);
+      }
+    };
+
+    const ctx: RequestContext = {
+      id,
+      method,
+      params,
+      meta: parseRequestMeta(params),
+      signal,
+      shutdown,
+      notify: (notifMethod, notifParams) => {
+        if (!acceptsSse || clientGone.signal.aborted) return;
+        startStream();
+        writeEvent({ jsonrpc: "2.0", method: notifMethod, params: notifParams });
+      },
+    };
+
+    try {
+      const result = await handlers.handle(ctx);
+      const meta = isObject(result._meta) ? result._meta : {};
+      finish({ jsonrpc: "2.0", id, result: { ...result, _meta: { ...meta, [META_SERVER_INFO]: SERVER_INFO } } }, 200);
+    } catch (err) {
+      if (clientGone.signal.aborted) return; // cancelled: send nothing further
+      let e: RpcError;
+      if (err instanceof RpcError) e = err;
+      else if (shutdown.aborted) e = new RpcError(INTERNAL_ERROR, "Server is shutting down", undefined, 503);
+      else {
+        console.error("Unhandled error while processing", method, err);
+        e = new RpcError(INTERNAL_ERROR, "Internal error", undefined, 500);
+      }
+      finish(errorBody(id, e), e.httpStatus);
+    }
+  }
+
+  return createServer((req, res) => {
+    handle(req, res).catch((err) => {
+      console.error("Request handling failed", err);
+      if (!res.headersSent) sendJson(res, 500, errorBody(undefined, new RpcError(INTERNAL_ERROR, "Internal error")));
+      else res.destroy();
+    });
+  });
+}
