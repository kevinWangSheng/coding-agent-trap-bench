@@ -0,0 +1,43 @@
+// Integrity-protected, self-contained MRTR requestState tokens.
+//
+// The server keeps no per-request state while waiting for the client to
+// retry: everything needed to resume is inside the token, which is
+// HMAC-SHA256 signed with a key that only lives in this process.
+
+import { createHmac, randomBytes, timingSafeEqual } from "node:crypto";
+
+export class RequestStateCodec {
+  private readonly key: Buffer;
+
+  constructor(key: Buffer = randomBytes(32)) {
+    this.key = key;
+  }
+
+  private mac(payload: string): Buffer {
+    return createHmac("sha256", this.key).update(payload).digest();
+  }
+
+  encode(data: Record<string, unknown>): string {
+    const payload = Buffer.from(JSON.stringify(data), "utf8").toString("base64url");
+    return `${payload}.${this.mac(payload).toString("base64url")}`;
+  }
+
+  /** Returns the decoded payload, or undefined if the token is malformed or forged. */
+  decode(token: string): Record<string, unknown> | undefined {
+    const parts = token.split(".");
+    if (parts.length !== 2) return undefined;
+    const [payload, sig] = parts as [string, string];
+    if (!/^[A-Za-z0-9_-]+$/.test(payload) || !/^[A-Za-z0-9_-]+$/.test(sig)) return undefined;
+    const given = Buffer.from(sig, "base64url");
+    const expected = this.mac(payload);
+    if (given.length !== expected.length || !timingSafeEqual(given, expected)) return undefined;
+    try {
+      const data: unknown = JSON.parse(Buffer.from(payload, "base64url").toString("utf8"));
+      return data && typeof data === "object" && !Array.isArray(data)
+        ? (data as Record<string, unknown>)
+        : undefined;
+    } catch {
+      return undefined;
+    }
+  }
+}
