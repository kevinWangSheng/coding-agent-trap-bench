@@ -0,0 +1,79 @@
+// In-memory notes store. Emits resource-change events so subscriptions/listen
+// streams can tell watchers which URIs changed.
+
+export interface Note {
+  id: string;
+  notebook: string;
+  title: string;
+  body: string;
+}
+
+export const INDEX_URI = "notes://index";
+export const NOTE_URI_PREFIX = "notes://notes/";
+
+export function noteUri(id: string): string {
+  return NOTE_URI_PREFIX + id;
+}
+
+export function noteMarkdown(note: Note): string {
+  return `# ${note.title}\n\n${note.body}\n`;
+}
+
+type ChangeListener = (uri: string) => void;
+
+export class NotesStore {
+  private notes = new Map<string, Note>();
+  private nextId = 1;
+  private listeners = new Set<ChangeListener>();
+
+  constructor(seed: Omit<Note, "id">[] = []) {
+    for (const n of seed) this.insert(n);
+  }
+
+  private insert(fields: Omit<Note, "id">): Note {
+    const note: Note = { id: `n${this.nextId++}`, ...fields };
+    this.notes.set(note.id, note);
+    return note;
+  }
+
+  get(id: string): Note | undefined {
+    return this.notes.get(id);
+  }
+
+  /** All notes ordered by numeric id (n1, n2, ..., n10). */
+  all(): Note[] {
+    return [...this.notes.values()].sort(
+      (a, b) => Number(a.id.slice(1)) - Number(b.id.slice(1)),
+    );
+  }
+
+  add(fields: Omit<Note, "id">): Note {
+    const note = this.insert(fields);
+    this.emit(INDEX_URI);
+    return note;
+  }
+
+  delete(id: string): boolean {
+    if (!this.notes.delete(id)) return false;
+    this.emit(INDEX_URI);
+    this.emit(noteUri(id));
+    return true;
+  }
+
+  onChange(listener: ChangeListener): () => void {
+    this.listeners.add(listener);
+    return () => this.listeners.delete(listener);
+  }
+
+  private emit(uri: string): void {
+    for (const l of this.listeners) l(uri);
+  }
+}
+
+export function createSeededStore(): NotesStore {
+  return new NotesStore([
+    { notebook: "work", title: "Standup", body: "Discussed the release schedule and blockers." },
+    { notebook: "work", title: "Retro actions", body: "Automate the changelog. Rotate the on-call." },
+    { notebook: "personal", title: "Groceries", body: "Eggs, flour, coffee." },
+  ]);
+}
diff --git a/test/helpers.ts b/test/helpers.ts
new file mode 100644
index 0000000..36e1045
--- /dev/null
+++ b/test/helpers.ts
@@ -0,0 +1,264 @@
+// Test helpers: spawn the built server and talk to it over real HTTP.
+
+import { spawn, type ChildProcess } from "node:child_process";
+import { request, type IncomingHttpHeaders } from "node:http";
+import { duplexPair, type Duplex } from "node:stream";
+import { fileURLToPath, pathToFileURL } from "node:url";
+
+export const PROTOCOL_VERSION = "2026-07-28";
+const SERVER_JS = fileURLToPath(new URL("../dist/server.js", import.meta.url));
+
+export interface RunningServer {
+  port: number;
+  url: string;
+  proc: ChildProcess;
+  stop(): Promise<void>;
+}
+
+// Fallback for sandboxes that forbid binding sockets (MCP_TEST_INPROCESS=1):
+// the same HTTP server runs in-process and each client connection is an
+// in-memory socket pair handed to it, so requests still go through Node's
+// HTTP parser and the transport exactly as over TCP.
+const inProcessConnectors = new Map<number, () => Duplex>();
+let nextFakePort = 41000;
+
+async function startInProcessServer(): Promise<RunningServer> {
+  const { createApp } = await import(pathToFileURL(fileURLToPath(new URL("../dist/app.js", import.meta.url))).href);
+  const port = nextFakePort++;
+  const app = createApp(port);
+  inProcessConnectors.set(port, () => {
+    const [client, serverSide] = duplexPair();
+    app.server.emit("connection", serverSide);
+    return client;
+  });
+  return {
+    port,
+    url: `http://127.0.0.1:${port}/mcp`,
+    proc: undefined as unknown as ChildProcess,
+    stop: () => app.stop(),
+  };
+}
+
+function connectOptions(port: number) {
+  const connect = inProcessConnectors.get(port);
+  return connect ? { createConnection: connect } : {};
+}
+
+export function startServer(): Promise<RunningServer> {
+  if (process.env.MCP_TEST_INPROCESS === "1") return startInProcessServer();
+  return new Promise((resolve, reject) => {
+    const proc = spawn(process.execPath, [SERVER_JS], {
+      env: { ...process.env, PORT: "0" },
+      stdio: ["ignore", "ignore", "pipe"],
+    });
+    let stderr = "";
+    const timer = setTimeout(() => reject(new Error(`server did not start: ${stderr}`)), 10_000);
+    proc.stderr!.setEncoding("utf8");
+    proc.stderr!.on("data", (chunk: string) => {
+      stderr += chunk;
+      const m = /listening on http:\/\/127\.0\.0\.1:(\d+)\/mcp/.exec(stderr);
+      if (m) {
+        clearTimeout(timer);
+        const port = Number(m[1]);
+        resolve({
+          port,
+          url: `http://127.0.0.1:${port}/mcp`,
+          proc,
+          stop: () =>
+            new Promise((done) => {
+              if (proc.exitCode !== null) return done();
+              proc.once("exit", () => done());
+              proc.kill("SIGTERM");
+            }),
+        });
+      }
+    });
+    proc.once("exit", (code) => {
+      clearTimeout(timer);
+      reject(new Error(`server exited early (${code}): ${stderr}`));
+    });
+  });
+}
+
+export interface HttpResult {
+  status: number;
+  headers: IncomingHttpHeaders;
+  body: string;
+  json?: any;
+}
+
+export function httpRequest(
+  port: number,
+  opts: { method?: string; path?: string; headers?: Record<string, string>; body?: string },
+): Promise<HttpResult> {
+  return new Promise((resolve, reject) => {
+    const req = request(
+      { host: "127.0.0.1", port, method: opts.method ?? "POST", path: opts.path ?? "/mcp", headers: opts.headers, ...connectOptions(port) },
+      (res) => {
+        let body = "";
+        res.setEncoding("utf8");
+        res.on("data", (c: string) => (body += c));
+        res.on("end", () => {
+          let json: any;
+          if ((res.headers["content-type"] ?? "").startsWith("application/json") && body) json = JSON.parse(body);
+          resolve({ status: res.statusCode!, headers: res.headers, body, json });
+        });
+      },
+    );
+    req.on("error", reject);
+    if (opts.body !== undefined) req.write(opts.body);
+    req.end();
+  });
+}
+
+let nextId = 1;
+
+export interface RpcOptions {
+  id?: string | number;
+  capabilities?: Record<string, unknown>;
+  meta?: Record<string, unknown>;
+  headers?: Record<string, string | undefined>;
+  accept?: string;
+}
+
+/** Builds a conforming modern request: body `_meta` plus mirrored MCP headers. */
+export function buildRequest(method: string, params: Record<string, unknown> = {}, opts: RpcOptions = {}) {
+  const id = opts.id ?? nextId++;
+  const body = {
+    jsonrpc: "2.0",
+    id,
+    method,
+    params: {
+      ...params,
+      _meta: {
+        "io.modelcontextprotocol/protocolVersion": PROTOCOL_VERSION,
+        "io.modelcontextprotocol/clientInfo": { name: "field-notes-tests", version: "0.0.0" },
+        "io.modelcontextprotocol/clientCapabilities": opts.capabilities ?? {},
+        ...opts.meta,
+      },
+    },
+  };
+  const headers: Record<string, string> = {
+    "Content-Type": "application/json",
+    Accept: opts.accept ?? "application/json, text/event-stream",
+    "MCP-Protocol-Version": PROTOCOL_VERSION,
+    "Mcp-Method": method,
+  };
+  if (typeof params.name === "string" && (method === "tools/call" || method === "prompts/get")) {
+    headers["Mcp-Name"] = params.name;
+  }
+  if (typeof params.uri === "string" && method === "resources/read") headers["Mcp-Name"] = params.uri;
+  if (method === "tools/call" && params.name === "add_note") {
+    const nb = (params.arguments as Record<string, unknown> | undefined)?.notebook;
+    if (typeof nb === "string") headers["Mcp-Param-Notebook"] = nb;
+  }
+  for (const [k, v] of Object.entries(opts.headers ?? {})) {
+    const existing = Object.keys(headers).find((h) => h.toLowerCase() === k.toLowerCase());
+    if (existing) delete headers[existing];
+    if (v !== undefined) headers[k] = v;
+  }
+  return { id, body, headers };
+}
+
+export async function rpc(
+  port: number,
+  method: string,
+  params: Record<string, unknown> = {},
+  opts: RpcOptions = {},
+): Promise<HttpResult> {
+  const { body, headers } = buildRequest(method, params, opts);
+  return httpRequest(port, { headers, body: JSON.stringify(body) });
+}
+
+export interface SseEvent {
+  event?: string;
+  data: any;
+}
+
+/** Opens an SSE request and exposes parsed events as they arrive. */
+export function openStream(port: number, method: string, params: Record<string, unknown>, opts: RpcOptions = {}) {
+  const { id, body, headers } = buildRequest(method, params, opts);
+  const events: SseEvent[] = [];
+  const waiters: (() => void)[] = [];
+  let ended = false;
+  let status = 0;
+  let contentType = "";
+  const req = request({ host: "127.0.0.1", port, method: "POST", path: "/mcp", headers, ...connectOptions(port) });
+  const ready = new Promise<void>((resolve, reject) => {
+    req.on("error", (err) => {
+      ended = true;
+      waiters.splice(0).forEach((w) => w());
+      if (status === 0) reject(err);
+    });
+    req.on("response", (res) => {
+      status = res.statusCode!;
+      contentType = res.headers["content-type"] ?? "";
+      resolve();
+      let buf = "";
+      res.setEncoding("utf8");
+      res.on("data", (chunk: string) => {
+        buf += chunk;
+        let idx: number;
+        while ((idx = buf.search(/\r?\n\r?\n/)) !== -1) {
+          const block = buf.slice(0, idx);
+          buf = buf.slice(idx).replace(/^\r?\n\r?\n/, "");
+          const ev: SseEvent = { data: undefined };
+          const dataLines: string[] = [];
+          for (const line of block.split(/\r?\n/)) {
+            if (line.startsWith(":")) continue;
+            if (line.startsWith("event:")) ev.event = line.slice(6).trim();
+            if (line.startsWith("data:")) dataLines.push(line.slice(5).replace(/^ /, ""));
+          }
+          if (dataLines.length > 0) {
+            ev.data = JSON.parse(dataLines.join("\n"));
+            events.push(ev);
+          }
+        }
+        waiters.splice(0).forEach((w) => w());
+      });
+      res.on("close", () => {
+        ended = true;
+        waiters.splice(0).forEach((w) => w());
+      });
+    });
+  });
+  req.end(JSON.stringify(body));
+
+  async function waitFor(pred: (events: SseEvent[]) => boolean, timeoutMs = 5000): Promise<SseEvent[]> {
+    const deadline = Date.now() + timeoutMs;
+    while (!pred(events)) {
+      if (ended) throw new Error(`stream ended before condition met; events: ${JSON.stringify(events)}`);
+      const remaining = deadline - Date.now();
+      if (remaining <= 0) throw new Error(`timed out; events so far: ${JSON.stringify(events)}`);
+      await new Promise<void>((resolve) => {
+        const t = setTimeout(resolve, remaining);
+        waiters.push(() => {
+          clearTimeout(t);
+          resolve();
+        });
+      });
+    }
+    return events;
+  }
+
+  return {
+    id,
+    events,
+    ready,
+    get status() {
+      return status;
+    },
+    get contentType() {
+      return contentType;
+    },
+    get ended() {
+      return ended;
+    },
+    waitFor,
+    close: () => req.destroy(),
+  };
+}
+
+export function sleep(ms: number): Promise<void> {
+  return new Promise((r) => setTimeout(r, ms));
+}
