+++ b/src/server.ts
@@ -0,0 +1,26 @@
+// Entry point: starts the Field Notes MCP server on 127.0.0.1:$PORT/mcp.
+
+import type { AddressInfo } from "node:net";
+import { createApp } from "./app.js";
+import { MCP_PATH } from "./http.js";
+
+const HOST = "127.0.0.1";
+const port = Number(process.env.PORT ?? 3000);
+if (!Number.isInteger(port) || port < 0 || port > 65535) {
+  console.error(`Invalid PORT: ${process.env.PORT}`);
+  process.exit(1);
+}
+
+const app = createApp(port);
+
+app.server.listen(port, HOST, () => {
+  const { port: bound } = app.server.address() as AddressInfo;
+  console.error(`field-notes MCP server listening on http://${HOST}:${bound}${MCP_PATH}`);
+});
+
+function stop(): void {
+  app.stop().then(() => process.exit(0));
+}
+
+process.on("SIGINT", stop);
+process.on("SIGTERM", stop);
