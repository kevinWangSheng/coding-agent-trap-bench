+++ b/testing/test_monkeypatch.py
@@ -52,6 +52,76 @@ def test_setattr() -> None:
         monkeypatch.setattr(A, "y")  # type: ignore[call-overload]
 
 
+def test_setattr_inherited_attribute_on_instance() -> None:
+    class A:
+        x = 1
+
+    a = A()
+    monkeypatch = MonkeyPatch()
+    monkeypatch.setattr(a, "x", 2)
+    assert a.x == 2
+    monkeypatch.setattr(a, "x", 3)
+    assert a.x == 3
+    monkeypatch.undo()
+    assert a.x == 1
+    assert "x" not in vars(a)
+
+
+def test_setattr_inherited_descriptor_on_instance() -> None:
+    class Counter:
+        """Non-data descriptor returning a new value on every lookup."""
+
+        def __init__(self) -> None:
+            self.count = 0
+
+        def __get__(self, obj: object, owner: type | None = None) -> int:
+            self.count += 1
+            return self.count
+
+    class A:
+        dyn = Counter()
+
+    a = A()
+    first = a.dyn
+    monkeypatch = MonkeyPatch()
+    monkeypatch.setattr(a, "dyn", 100)
+    assert a.dyn == 100
+    monkeypatch.undo()
+    assert "dyn" not in vars(a)
+    # The descriptor is still consulted dynamically after undo.
+    second = a.dyn
+    assert a.dyn == second + 1
+    assert second > first
+
+
+def test_setattr_own_attribute_on_instance() -> None:
+    class A:
+        x = 1
+
+    a = A()
+    a.x = 5
+    monkeypatch = MonkeyPatch()
+    monkeypatch.setattr(a, "x", 2)
+    assert a.x == 2
+    monkeypatch.undo()
+    assert vars(a) == {"x": 5}
+
+
+def test_setattr_inherited_attribute_on_slotted_instance() -> None:
+    class A:
+        __slots__ = ("x",)
+
+        def __init__(self) -> None:
+            self.x = 1
+
+    a = A()
+    monkeypatch = MonkeyPatch()
+    monkeypatch.setattr(a, "x", 2)
+    assert a.x == 2
+    monkeypatch.undo()
+    assert a.x == 1
+
+
