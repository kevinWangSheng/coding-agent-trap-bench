         if inspect.isclass(target):
             oldval = target.__dict__.get(name, NOTSET)
-        setattr(target, name, value)
+            setattr(target, name, value)
+        else:
+            had_own_attr = _has_own_attr(target, name)
+            setattr(target, name, value)
+            # If the attribute was inherited (e.g. from the class) and setting
+            # it created a new entry in the instance ``__dict__``, undo must
+            # delete that entry instead of storing the old value there, which
+            # would leave the target in a different state (and freeze the
+            # result of any ``__get__`` descriptor).
+            if not had_own_attr and _has_own_attr(target, name):
+                oldval = NOTSET
