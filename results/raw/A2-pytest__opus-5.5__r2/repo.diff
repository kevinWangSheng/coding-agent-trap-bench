+++ b/src/_pytest/monkeypatch.py
@@ -110,6 +110,15 @@ def derive_importpath(import_path: str, raising: bool) -> tuple[str, object]:
     return attr, target
 
 
+def _has_own_attr(obj: object, name: str) -> bool:
+    """Return whether ``name`` is present in the instance ``__dict__`` of ``obj``."""
+    try:
+        return name in vars(obj)
+    except TypeError:
+        # Object has no ``__dict__`` (e.g. uses ``__slots__``).
+        return False
+
+
 @final
