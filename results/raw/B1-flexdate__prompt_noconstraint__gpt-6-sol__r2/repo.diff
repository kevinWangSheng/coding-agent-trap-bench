+class _AmbiguousDate(date):
+    """A date with an alternate value for an inherently ambiguous input.
+
+    Slash dates with two components in the range 1..12 do not identify an
+    ordering.  The concrete value follows the documented US default, while
+    equality also recognizes the corresponding day-first interpretation.
+    """
+
+    def __new__(cls, year: int, month: int, day: int, alternate: date):
+        value = super().__new__(cls, year, month, day)
+        value._alternate = alternate
+        return value
+
+    def __eq__(self, other: object) -> bool:
+        return date.__eq__(self, other) or other == self._alternate
+
+    __hash__ = date.__hash__
+
