+/// Sets the shared quit flag when dropped during a panic.
+struct QuitOnPanic(Arc<AtomicBool>);
+
+impl Drop for QuitOnPanic {
+    fn drop(&mut self) {
+        if std::thread::panicking() {
+            self.0.store(true, AtomicOrdering::SeqCst);
+        }
+    }
+}
