+    fn panic_tree() -> TempDir {
+        let td = tmpdir();
+        for i in 0..10 {
+            mkdirp(td.path().join(format!("d{i}/sub")));
+            for j in 0..10 {
+                wfile(td.path().join(format!("d{i}/f{j}")), "");
+                wfile(td.path().join(format!("d{i}/sub/g{j}")), "");
+            }
+        }
+        wfile(td.path().join("boom"), "");
+        td
+    }
+
+    /// Runs the given function and asserts that it panics with a payload
+    /// containing "oops!".
+    fn assert_panics_with_oops<F: FnOnce()>(f: F) {
+        let err = std::panic::catch_unwind(std::panic::AssertUnwindSafe(f))
+            .expect_err("walk should have panicked");
+        let msg = err
+            .downcast_ref::<&str>()
+            .map(|s| s.to_string())
+            .or_else(|| err.downcast_ref::<String>().cloned())
+            .unwrap_or_default();
+        assert!(msg.contains("oops!"), "unexpected panic payload: {msg:?}");
+    }
+
+    #[test]
+    fn panic_in_visit_every_entry() {
+        let td = panic_tree();
+        for threads in [1, 2, 40] {
+            assert_panics_with_oops(|| {
+                WalkBuilder::new(td.path())
+                    .threads(threads)
+                    .build_parallel()
+                    .run(|| Box::new(|_| panic!("oops!")));
+            });
+        }
+    }
+
+    #[test]
+    fn panic_in_visit_single_entry() {
+        // Only one entry panics, so the other workers are likely to be idle
+        // (waiting for work) when the panic occurs.
+        let td = panic_tree();
+        for threads in [2, 40] {
+            assert_panics_with_oops(|| {
+                WalkBuilder::new(td.path())
+                    .threads(threads)
+                    .build_parallel()
+                    .run(|| {
+                        Box::new(|result| {
+                            let dent = result.unwrap();
+                            if dent.file_name() == "boom" {
+                                panic!("oops!");
+                            }
+                            WalkState::Continue
+                        })
+                    });
+            });
+        }
+    }
+
+    #[test]
+    fn panic_in_visit_root_error() {
+        // The first visitor is used for errors on root paths, before any
+        // worker threads are started.
+        let td = tmpdir();
+        assert_panics_with_oops(|| {
+            WalkBuilder::new(td.path().join("does-not-exist"))
+                .threads(4)
+                .build_parallel()
+                .run(|| Box::new(|_| panic!("oops!")));
+        });
+    }
+
+    #[test]
+    fn panic_in_build() {
+        let td = panic_tree();
+        // Panic on each possible call to the builder: the first call is used
+        // for the root paths, and then one call per worker thread.
+        for panic_at in 0..=4 {
+            let mut calls = 0;
+            assert_panics_with_oops(|| {
+                WalkBuilder::new(td.path()).threads(4).build_parallel().run(
+                    || {
+                        if calls == panic_at {
+                            panic!("oops!");
+                        }
+                        calls += 1;
+                        Box::new(|_| WalkState::Continue)
+                    },
+                );
+            });
+        }
+    }
+
+    #[test]
+    fn panic_in_visitor_drop() {
+        struct PanicOnDrop;
+
+        impl super::ParallelVisitor for PanicOnDrop {
+            fn visit(
+                &mut self,
+                _: Result<DirEntry, crate::Error>,
+            ) -> WalkState {
+                WalkState::Continue
+            }
+        }
+
+        impl Drop for PanicOnDrop {
+            fn drop(&mut self) {
+                if !std::thread::panicking() {
+                    panic!("oops!");
+                }
+            }
+        }
+
+        struct Builder;
+
+        impl<'s> super::ParallelVisitorBuilder<'s> for Builder {
+            fn build(&mut self) -> Box<dyn super::ParallelVisitor + 's> {
+                Box::new(PanicOnDrop)
+            }
+        }
+
+        let td = panic_tree();
+        assert_panics_with_oops(|| {
+            WalkBuilder::new(td.path())
+                .threads(8)
+                .build_parallel()
+                .visit(&mut Builder);
+        });
+    }
