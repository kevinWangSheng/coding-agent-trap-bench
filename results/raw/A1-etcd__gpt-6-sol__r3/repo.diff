+package storage
+
+import (
+	"testing"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+)
+
+func TestCostTxnIncludesNestedTransactions(t *testing.T) {
+	put := func(key, value string) *pb.RequestOp {
+		return &pb.RequestOp{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{
+			Key: []byte(key), Value: []byte(value),
+		}}}
+	}
+	nested := func(success, failure []*pb.RequestOp) *pb.RequestOp {
+		return &pb.RequestOp{Request: &pb.RequestOp_RequestTxn{RequestTxn: &pb.TxnRequest{
+			Success: success, Failure: failure,
+		}}}
+	}
+
+	innerPutCost := costPut(put("inner-key", "inner-value").GetRequestPut())
+	outerPutCost := costPut(put("outer-key", "outer-value").GetRequestPut())
+
+	tests := []struct {
+		name string
+		txn  *pb.TxnRequest
+		want int
+	}{
+		{
+			name: "nested success branch",
+			txn:  &pb.TxnRequest{Success: []*pb.RequestOp{nested([]*pb.RequestOp{put("inner-key", "inner-value")}, nil)}},
+			want: innerPutCost,
+		},
+		{
+			name: "nested failure branch",
+			txn:  &pb.TxnRequest{Failure: []*pb.RequestOp{nested(nil, []*pb.RequestOp{put("inner-key", "inner-value")})}},
+			want: innerPutCost,
+		},
+		{
+			name: "nested branch is compared with flat branch",
+			txn: &pb.TxnRequest{
+				Success: []*pb.RequestOp{put("outer-key", "outer-value")},
+				Failure: []*pb.RequestOp{nested([]*pb.RequestOp{put("inner-key", "inner-value")}, nil)},
+			},
+			want: maxInt(innerPutCost, outerPutCost),
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := costTxn(tt.txn); got != tt.want {
+				t.Fatalf("costTxn() = %d, want %d", got, tt.want)
+			}
+		})
+	}
+}
+
+func maxInt(a, b int) int {
+	if a > b {
+		return a
+	}
+	return b
+}
