+#[sqlx_macros::test]
+async fn it_executes_statements_larger_than_prepare_window() -> anyhow::Result<()> {
+    let mut conn = new::<Sqlite>().await?;
+    let value = "x;".repeat(3_000);
+    let script = format!(
+        "CREATE TEMPORARY TABLE large_values (value TEXT); INSERT INTO large_values VALUES ('{value}');"
+    );
+
+    sqlx::raw_sql(sqlx::AssertSqlSafe(script))
+        .execute(&mut conn)
+        .await?;
+
+    let (stored,): (String,) = sqlx::query_as("SELECT value FROM large_values")
+        .fetch_one(&mut conn)
+        .await?;
+    assert_eq!(stored, value);
+
+    Ok(())
+}
