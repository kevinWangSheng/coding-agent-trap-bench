+package storage
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"go.uber.org/zap/zaptest"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	betesting "go.etcd.io/etcd/server/v3/storage/backend/testing"
+)
+
+func putOp(key, val string) *pb.RequestOp {
+	return &pb.RequestOp{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte(key), Value: []byte(val)}}}
+}
+
+func txnOp(txn *pb.TxnRequest) *pb.RequestOp {
+	return &pb.RequestOp{Request: &pb.RequestOp_RequestTxn{RequestTxn: txn}}
+}
+
+func rangeOp(key string) *pb.RequestOp {
+	return &pb.RequestOp{Request: &pb.RequestOp_RequestRange{RequestRange: &pb.RangeRequest{Key: []byte(key)}}}
+}
+
+func TestBackendQuotaCost(t *testing.T) {
+	be, _ := betesting.NewDefaultTmpBackend(t)
+	defer betesting.Close(t, be)
+	q := NewBackendQuota(zaptest.NewLogger(t), 0, be, "test")
+
+	putA := putOp("foo", "bar")
+	putB := putOp("key", "longer-value")
+	costA := kvOverhead + len("foo") + len("bar")
+	costB := kvOverhead + len("key") + len("longer-value")
+
+	tests := []struct {
+		name string
+		req  any
+		want int
+	}{
+		{"put", &pb.PutRequest{Key: []byte("foo"), Value: []byte("bar")}, costA},
+		{"lease grant", &pb.LeaseGrantRequest{}, leaseOverhead},
+		{"empty txn", &pb.TxnRequest{}, 0},
+		{"txn range only", &pb.TxnRequest{Success: []*pb.RequestOp{rangeOp("foo")}}, 0},
+		{"flat txn success", &pb.TxnRequest{Success: []*pb.RequestOp{putA, putB}}, costA + costB},
+		{"flat txn failure", &pb.TxnRequest{Failure: []*pb.RequestOp{putA, putB}}, costA + costB},
+		{"flat txn max of branches", &pb.TxnRequest{Success: []*pb.RequestOp{putA}, Failure: []*pb.RequestOp{putB}}, costB},
+		{
+			"nested txn in success",
+			&pb.TxnRequest{Success: []*pb.RequestOp{txnOp(&pb.TxnRequest{Success: []*pb.RequestOp{putA, putB}})}},
+			costA + costB,
+		},
+		{
+			"nested txn in failure",
+			&pb.TxnRequest{Failure: []*pb.RequestOp{txnOp(&pb.TxnRequest{Success: []*pb.RequestOp{putA, putB}})}},
+			costA + costB,
+		},
+		{
+			"nested txn inner failure branch",
+			&pb.TxnRequest{Success: []*pb.RequestOp{txnOp(&pb.TxnRequest{Failure: []*pb.RequestOp{putA, putB}})}},
+			costA + costB,
+		},
+		{
+			"nested txn mixed with flat put",
+			&pb.TxnRequest{Success: []*pb.RequestOp{putA, txnOp(&pb.TxnRequest{Success: []*pb.RequestOp{putB}})}},
+			costA + costB,
+		},
+		{
+			"deeply nested txn",
+			&pb.TxnRequest{Failure: []*pb.RequestOp{txnOp(&pb.TxnRequest{Success: []*pb.RequestOp{
+				txnOp(&pb.TxnRequest{Failure: []*pb.RequestOp{putA, putB}}),
+			}})}},
+			costA + costB,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			assert.Equal(t, tt.want, q.Cost(tt.req))
+		})
+	}
+}
+
+func TestBackendQuotaAvailableNestedTxn(t *testing.T) {
+	be, _ := betesting.NewDefaultTmpBackend(t)
+	defer betesting.Close(t, be)
+	// Quota just above the current backend size, so any put exceeds it.
+	q := NewBackendQuota(zaptest.NewLogger(t), be.Size()+1, be, "test")
+
+	put := putOp("foo", "bar")
+	nested := txnOp(&pb.TxnRequest{Success: []*pb.RequestOp{put}})
+
+	reqs := map[string]any{
+		"put":                   &pb.PutRequest{Key: []byte("foo"), Value: []byte("bar")},
+		"flat txn success":      &pb.TxnRequest{Success: []*pb.RequestOp{put}},
+		"flat txn failure":      &pb.TxnRequest{Failure: []*pb.RequestOp{put}},
+		"nested txn in success": &pb.TxnRequest{Success: []*pb.RequestOp{nested}},
+		"nested txn in failure": &pb.TxnRequest{Failure: []*pb.RequestOp{nested}},
+	}
+	for name, req := range reqs {
+		t.Run(name, func(t *testing.T) {
+			assert.False(t, q.Available(req), "request should exceed quota")
+		})
+	}
+
+	assert.True(t, q.Available(&pb.TxnRequest{Success: []*pb.RequestOp{txnOp(&pb.TxnRequest{Success: []*pb.RequestOp{rangeOp("foo")}})}}),
+		"read-only nested txn should not be charged")
+}
