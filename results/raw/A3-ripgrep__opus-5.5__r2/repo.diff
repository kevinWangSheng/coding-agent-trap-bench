+
+    #[test]
+    fn parallel_visitor_builder_panic_does_not_hang() {
+        use std::sync::atomic::{AtomicUsize, Ordering};
+
+        let td = Arc::new(mk_panic_tree());
+        // Panic on various build() calls: the first one is used for the root
+        // paths, the rest are used for each worker thread.
+        for panic_at in [0, 1, 2, 5, 39] {
+            let td = td.clone();
+            assert_panics_without_hang("build oops!", move || {
+                let count = AtomicUsize::new(0);
+                WalkBuilder::new(td.path()).threads(40).build_parallel().run(
+                    || {
+                        if count.fetch_add(1, Ordering::SeqCst) == panic_at {
+                            panic!("build oops!");
+                        }
+                        Box::new(|_| WalkState::Continue)
+                    },
+                );
+            });
+        }
+    }
+
