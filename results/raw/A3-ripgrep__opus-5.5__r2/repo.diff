+impl<'s> Drop for Worker<'s> {
+    fn drop(&mut self) {
+        // If this worker is being dropped because the caller's callback
+        // panicked, then this worker will never deactivate itself. Without
+        // intervention, the other workers would then wait forever for it to
+        // do so. So tell all workers to quit instead, which lets the panic
+        // propagate to the caller of `WalkParallel::visit`.
+        if std::thread::panicking() {
+            self.quit_now();
+            self.send_quit();
+        }
+    }
+}
