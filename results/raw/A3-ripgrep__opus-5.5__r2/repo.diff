+    /// Creates a directory tree with enough entries to keep many parallel
+    /// workers busy.
+    fn mk_panic_tree() -> TempDir {
+        let td = tmpdir();
+        for i in 0..10 {
+            for j in 0..10 {
+                let dir = td.path().join(format!("d{i}/e{j}"));
+                mkdirp(&dir);
+                for k in 0..5 {
+                    wfile(dir.join(format!("f{k}")), "");
+                }
+            }
+        }
+        td
+    }
+
+    /// Runs `f` on a separate thread and asserts that it panics with a
+    /// message containing `expected` within a generous timeout. A timeout
+    /// indicates a deadlock, which is reported as a test failure instead of
+    /// hanging the test suite.
+    fn assert_panics_without_hang<F>(expected: &str, f: F)
+    where
+        F: FnOnce() + Send + 'static,
+    {
+        use std::panic::{AssertUnwindSafe, catch_unwind};
+        use std::sync::mpsc;
+        use std::time::Duration;
+
+        let (tx, rx) = mpsc::channel();
+        std::thread::spawn(move || {
+            let result = catch_unwind(AssertUnwindSafe(f));
+            let _ = tx.send(result.map_err(|payload| {
+                if let Some(s) = payload.downcast_ref::<&str>() {
+                    s.to_string()
+                } else if let Some(s) = payload.downcast_ref::<String>() {
+                    s.clone()
+                } else {
+                    "<non-string panic payload>".to_string()
+                }
+            }));
+        });
+        match rx.recv_timeout(Duration::from_secs(30)) {
+            Ok(Ok(())) => panic!("expected parallel walk to panic"),
+            Ok(Err(msg)) => assert!(
+                msg.contains(expected),
+                "unexpected panic message: {msg:?}",
+            ),
+            Err(_) => panic!("parallel walk deadlocked after a panic"),
+        }
+    }
+
+    #[test]
+    fn parallel_visitor_panic_does_not_hang() {
+        let td = Arc::new(mk_panic_tree());
+        for threads in [1, 2, 8, 40] {
+            for _ in 0..5 {
+                let td = td.clone();
+                assert_panics_without_hang("oops!", move || {
+                    WalkBuilder::new(td.path())
+                        .threads(threads)
+                        .build_parallel()
+                        .run(|| Box::new(|_| panic!("oops!")));
+                });
+            }
+        }
+    }
+
