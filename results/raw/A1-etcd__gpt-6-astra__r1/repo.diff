+// Copyright 2026 The etcd Authors
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+
+package storage
+
+import (
+	"testing"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+)
+
+func putOp(key, value string) *pb.RequestOp {
+	return &pb.RequestOp{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte(key), Value: []byte(value)}}}
+}
+
+func txnOp(success, failure []*pb.RequestOp) *pb.RequestOp {
+	return &pb.RequestOp{Request: &pb.RequestOp_RequestTxn{RequestTxn: &pb.TxnRequest{Success: success, Failure: failure}}}
+}
+
+func TestCostTxnIncludesNestedTransactions(t *testing.T) {
+	inner := txnOp([]*pb.RequestOp{putOp("nested", "value")}, []*pb.RequestOp{putOp("failure", "value")})
+	outer := &pb.TxnRequest{Success: []*pb.RequestOp{inner}, Failure: []*pb.RequestOp{putOp("failure", "value")}}
+
+	// The nested transaction's largest branch must contribute to the outer
+	// transaction's cost, just like a flat transaction.
+	want := costTxn(inner.GetRequestTxn())
+	if got := costTxn(outer); got != want {
+		t.Fatalf("costTxn() = %d, want %d", got, want)
+	}
+}
