+#[sqlx_macros::test]
+async fn it_stops_executing_many_statements_at_error() -> anyhow::Result<()> {
+    use sqlx::AssertSqlSafe;
+
+    let mut conn = new::<Sqlite>().await?;
+
+    conn.execute("CREATE TEMPORARY TABLE many (id INTEGER PRIMARY KEY)")
+        .await?;
+
+    let mut script = String::new();
+    for i in 1..=3000 {
+        script.push_str(&format!("INSERT INTO many (id) VALUES ({i});\n"));
+        if i == 2000 {
+            script.push_str("INSERT INTO does_not_exist (id) VALUES (1);\n");
+        }
+    }
+
+    let err = sqlx::raw_sql(AssertSqlSafe(script))
+        .execute(&mut conn)
+        .await
+        .unwrap_err();
+    assert_eq!(
+        err.to_string(),
+        "error returned from database: (code: 1) no such table: does_not_exist"
+    );
+
+    let count: i64 = sqlx::query_scalar("SELECT count(*) FROM many")
+        .fetch_one(&mut conn)
+        .await?;
+    assert_eq!(count, 2000);
+
+    Ok(())
+}
