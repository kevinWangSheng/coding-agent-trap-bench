+#[sqlx_macros::test]
+async fn it_can_execute_many_statements_in_one_string() -> anyhow::Result<()> {
+    use sqlx::{AssertSqlSafe, Either};
+
+    let mut conn = new::<Sqlite>().await?;
+
+    const N: i64 = 5000;
+
+    let mut script =
+        String::from("CREATE TEMPORARY TABLE many (id INTEGER PRIMARY KEY, v INTEGER);\n");
+    for i in 1..=N {
+        script.push_str(&format!("INSERT INTO many (v) VALUES ({i});\n"));
+        if i % 100 == 0 {
+            // comments, empty statements and a statement returning rows
+            script.push_str(&format!(
+                "-- checkpoint {i}\n;; SELECT count(*) FROM many;\n"
+            ));
+        }
+    }
+    script.push_str("UPDATE many SET v = v + 1 WHERE id <= 10; /* trailing comment */");
+
+    let results: Vec<_> = sqlx::raw_sql(AssertSqlSafe(script.as_str()))
+        .fetch_many(&mut conn)
+        .try_collect()
+        .await?;
+
+    // CREATE + N inserts + N/100 selects + UPDATE
+    let done: Vec<_> = results.iter().filter_map(|r| r.as_ref().left()).collect();
+    assert_eq!(done.len() as i64, 1 + N + N / 100 + 1);
+    assert_eq!(done[0].rows_affected(), 0);
+    assert!(done[1..=100].iter().all(|d| d.rows_affected() == 1));
+    assert_eq!(done[101].rows_affected(), 0);
+    assert_eq!(done.last().unwrap().rows_affected(), 10);
+
+    let counts: Vec<i64> = results
+        .iter()
+        .filter_map(|r| match r {
+            Either::Right(row) => Some(row.get(0)),
+            _ => None,
+        })
+        .collect();
+    assert_eq!(counts, (1..=N / 100).map(|i| i * 100).collect::<Vec<_>>());
+
+    let sum: i64 = sqlx::query_scalar("SELECT sum(v) FROM many")
+        .fetch_one(&mut conn)
+        .await?;
+    assert_eq!(sum, N * (N + 1) / 2 + 10);
+
+    // `execute()` reports the total rows affected
+    let mut script = String::new();
+    for i in 1..=N {
+        script.push_str(&format!("UPDATE many SET v = 0 WHERE id = {i};"));
+    }
+    let done = sqlx::raw_sql(AssertSqlSafe(script))
+        .execute(&mut conn)
+        .await?;
+    assert_eq!(done.rows_affected(), N as u64);
+
+    Ok(())
+}
