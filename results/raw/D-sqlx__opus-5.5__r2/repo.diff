+#[sqlx_macros::test]
+async fn it_enforces_sql_length_limit_on_multiple_statements() -> anyhow::Result<()> {
+    use libsqlite3_sys::{sqlite3_limit, SQLITE_LIMIT_SQL_LENGTH};
+
+    let mut conn = new::<Sqlite>().await?;
+
+    // SQLite's own schema SQL is also subject to the limit, so make sure it's loaded first
+    conn.execute("SELECT 1").await?;
+
+    {
+        let mut handle = conn.lock_handle().await?;
+        unsafe { sqlite3_limit(handle.as_raw_handle().as_ptr(), SQLITE_LIMIT_SQL_LENGTH, 64) };
+    }
+
+    // shorter than the limit
+    conn.execute("SELECT 1; SELECT 2;").await?;
+
+    // each statement is short, but the whole string exceeds the limit
+    let err = sqlx::raw_sql(sqlx::AssertSqlSafe("SELECT 1;".repeat(20)))
+        .execute(&mut conn)
+        .await
+        .unwrap_err();
+    assert_eq!(
+        err.to_string(),
+        "error returned from database: (code: 18) statement too long"
+    );
+
+    Ok(())
+}
