+#[sqlx_macros::test]
+async fn it_executes_large_multi_statement_script() -> anyhow::Result<()> {
+    let mut conn = new::<Sqlite>().await?;
+
+    const N: i64 = 20_000;
+
+    let mut script =
+        String::from("CREATE TEMPORARY TABLE big_script (id INTEGER PRIMARY KEY, n INTEGER);\n");
+    for i in 1..=N {
+        script.push_str(&format!(
+            "INSERT INTO big_script (id, n) VALUES ({i}, {i}); -- row {i}\n"
+        ));
+    }
+    script.push_str("UPDATE big_script SET n = n + 1 WHERE id % 2 = 0;\n");
+    script.push_str("SELECT count(*), sum(n) FROM big_script;\n");
+
+    // `execute()` sums the rows affected over every statement
+    let res = sqlx::raw_sql(sqlx::AssertSqlSafe(script.clone()))
+        .execute(&mut conn)
+        .await?;
+    assert_eq!(res.rows_affected(), (N + N / 2) as u64);
+
+    sqlx::raw_sql("DROP TABLE big_script")
+        .execute(&mut conn)
+        .await?;
+
+    // every statement yields its own result, in order
+    let results = sqlx::raw_sql(sqlx::AssertSqlSafe(script))
+        .fetch_many(&mut conn)
+        .try_collect::<Vec<_>>()
+        .await?;
+    assert_eq!(results.len(), 1 + N as usize + 1 + 2);
+
+    let mut results = results.into_iter();
+    // `CREATE TABLE` (not asserted: DDL reports `sqlite3_changes()` of the last DML statement)
+    assert!(results.next().unwrap().is_left());
+    for i in 1..=N {
+        let done = results.next().unwrap().left().unwrap();
+        assert_eq!(done.rows_affected(), 1);
+        assert_eq!(done.last_insert_rowid(), i);
+    }
+    let update = results.next().unwrap().left().unwrap();
+    assert_eq!(update.rows_affected(), (N / 2) as u64);
+    let row = results.next().unwrap().right().unwrap();
+    assert_eq!(row.get::<i64, _>(0), N);
+    assert_eq!(row.get::<i64, _>(1), N * (N + 1) / 2 + N / 2);
+    assert_eq!(results.next().unwrap().left().unwrap().rows_affected(), 0);
+
+    Ok(())
+}
