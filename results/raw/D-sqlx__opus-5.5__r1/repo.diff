+#[sqlx_macros::test]
+async fn it_stops_multi_statement_script_at_nul() -> anyhow::Result<()> {
+    let mut conn = new::<Sqlite>().await?;
+
+    // SQLite stops parsing at a NUL byte; nothing after it is executed.
+    for (sql, expected) in [
+        ("SELECT 1; SELECT 2;\0", &[1, 2][..]),
+        ("SELECT 1;\0SELECT 2", &[1][..]),
+        ("SELECT 1\0garbage", &[1][..]),
+        ("\0SELECT 1", &[][..]),
+    ] {
+        let rows: Vec<i64> = sqlx::raw_sql(sqlx::AssertSqlSafe(sql))
+            .fetch_all(&mut conn)
+            .await?
+            .iter()
+            .map(|row| row.get(0))
+            .collect();
+        assert_eq!(rows, expected, "{sql:?}");
+    }
+
+    Ok(())
+}
