+#[sqlx_macros::test]
+async fn it_reports_error_late_in_large_multi_statement_script() -> anyhow::Result<()> {
+    let mut conn = new::<Sqlite>().await?;
+
+    let mut script = String::from("CREATE TEMPORARY TABLE big_err (id INTEGER PRIMARY KEY);\n");
+    for i in 1..=5_000 {
+        script.push_str(&format!("INSERT INTO big_err (id) VALUES ({i});\n"));
+    }
+    script.push_str("INSERT INTO big_err (id) VALUES (1);\n");
+    script.push_str("INSERT INTO big_err (id) VALUES (5001);\n");
+
+    let err = sqlx::raw_sql(sqlx::AssertSqlSafe(script))
+        .execute(&mut conn)
+        .await
+        .unwrap_err();
+    assert!(
+        err.to_string().contains("UNIQUE constraint failed"),
+        "unexpected error: {err}"
+    );
+
+    // statements before the failing one ran; the ones after it did not
+    let count: i64 = sqlx::query_scalar("SELECT count(*) FROM big_err")
+        .fetch_one(&mut conn)
+        .await?;
+    assert_eq!(count, 5_000);
+
+    Ok(())
+}
