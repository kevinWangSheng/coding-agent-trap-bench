+/// Splits a script at statement terminators without treating terminators inside
+/// SQLite string literals, quoted identifiers, or comments as separators. Trigger
+/// bodies are kept together until their closing `END`.
+fn split_statements(sql: &Bytes) -> Vec<Bytes> {
+    let bytes = sql.as_ref();
+    let mut result = Vec::new();
+    let mut start = 0;
+    let mut i = 0;
+    let mut quote = None;
+    let mut trigger = false;
+    let mut trigger_end = false;
+    let mut word_start = None;
+    let mut saw_create = false;
+
+    while i < bytes.len() {
+        let b = bytes[i];
+        if let Some(q) = quote {
+            if b == q {
+                if i + 1 < bytes.len() && bytes[i + 1] == q {
+                    i += 2;
+                    continue;
+                }
+                quote = None;
+            }
+            i += 1;
+            continue;
+        }
+
+        if b == b'\'' || b == b'"' || b == b'`' {
+            quote = Some(b);
+            word_start = None;
+            i += 1;
+            continue;
+        }
+        if b == b'[' {
+            i += 1;
+            while i < bytes.len() {
+                if bytes[i] == b']' {
+                    if i + 1 < bytes.len() && bytes[i + 1] == b']' {
+                        i += 2;
+                        continue;
+                    }
+                    break;
+                }
+                i += 1;
+            }
+            if i < bytes.len() {
+                i += 1;
+            }
+            word_start = None;
+            continue;
+        }
+        if b == b'-' && i + 1 < bytes.len() && bytes[i + 1] == b'-' {
+            while i < bytes.len() && bytes[i] != b'\n' {
+                i += 1;
+            }
+            word_start = None;
+            continue;
+        }
+        if b == b'/' && i + 1 < bytes.len() && bytes[i + 1] == b'*' {
+            i += 2;
+            while i + 1 < bytes.len() && !(bytes[i] == b'*' && bytes[i + 1] == b'/') {
+                i += 1;
+            }
+            i = (i + 2).min(bytes.len());
+            word_start = None;
+            continue;
+        }
+
+        if b.is_ascii_alphabetic() || b == b'_' {
+            word_start.get_or_insert(i);
+        } else if let Some(ws) = word_start.take() {
+            let word = bytes[ws..i].to_ascii_uppercase();
+            if word == b"CREATE" {
+                saw_create = true;
+            }
+            if saw_create && word == b"TRIGGER" {
+                trigger = true;
+            }
+            if trigger && word == b"END" {
+                trigger_end = true;
+            }
+        }
+
+        if b == b';' && (!trigger || trigger_end) {
+            result.push(sql.slice(start..=i));
+            start = i + 1;
+            trigger = false;
+            trigger_end = false;
+            saw_create = false;
+        }
+        i += 1;
+    }
+    if start < bytes.len() {
+        result.push(sql.slice(start..));
+    }
+    result
+}
+
+#[cfg(test)]
+mod tests {
+    use super::split_statements;
+    use sqlx_core::bytes::Bytes;
+
+    #[test]
+    fn split_ignores_quoted_semicolons_and_comments() {
+        let sql = Bytes::from("INSERT INTO t VALUES ('a; b'); -- comment;\nSELECT 1;");
+        let statements = split_statements(&sql);
+        assert_eq!(statements.len(), 2);
+        assert_eq!(&statements[0][..], b"INSERT INTO t VALUES ('a; b');");
+    }
+
+    #[test]
+    fn split_keeps_trigger_body_together() {
+        let sql = Bytes::from(
+            "CREATE TRIGGER tr AFTER INSERT ON t BEGIN INSERT INTO log VALUES (1); END; SELECT 1;",
+        );
+        assert_eq!(split_statements(&sql).len(), 2);
+    }
+}
