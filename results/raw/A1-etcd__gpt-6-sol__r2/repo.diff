+package storage
+
+import (
+	"testing"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+)
+
+func quotaPut(key, value string) *pb.RequestOp {
+	return &pb.RequestOp{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{
+		Key: []byte(key), Value: []byte(value),
+	}}}
+}
+
+func quotaTxn(txn *pb.TxnRequest) *pb.RequestOp {
+	return &pb.RequestOp{Request: &pb.RequestOp_RequestTxn{RequestTxn: txn}}
+}
+
+func TestCostTxnNestedTransactions(t *testing.T) {
+	tests := []struct {
+		name string
+		txn  *pb.TxnRequest
+		want int
+	}{
+		{
+			name: "nested success branch",
+			txn: &pb.TxnRequest{
+				Success: []*pb.RequestOp{quotaTxn(&pb.TxnRequest{
+					Success: []*pb.RequestOp{quotaPut("success", "value")},
+				})},
+				Failure: []*pb.RequestOp{quotaPut("failure", "value")},
+			},
+			want: costPut(&pb.PutRequest{Key: []byte("success"), Value: []byte("value")}),
+		},
+		{
+			name: "nested failure branch",
+			txn: &pb.TxnRequest{
+				Success: []*pb.RequestOp{quotaPut("success", "value")},
+				Failure: []*pb.RequestOp{quotaTxn(&pb.TxnRequest{
+					Failure: []*pb.RequestOp{quotaPut("failure", "value")},
+				})},
+			},
+			want: costPut(&pb.PutRequest{Key: []byte("failure"), Value: []byte("value")}),
+		},
+		{
+			name: "deeply nested",
+			txn: &pb.TxnRequest{Success: []*pb.RequestOp{quotaTxn(&pb.TxnRequest{
+				Success: []*pb.RequestOp{quotaTxn(&pb.TxnRequest{
+					Success: []*pb.RequestOp{quotaPut("deep", "value")},
+				})},
+			})}},
+			want: costPut(&pb.PutRequest{Key: []byte("deep"), Value: []byte("value")}),
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := costTxn(tt.txn); got != tt.want {
+				t.Fatalf("costTxn() = %d, want %d", got, tt.want)
+			}
+		})
+	}
+}
