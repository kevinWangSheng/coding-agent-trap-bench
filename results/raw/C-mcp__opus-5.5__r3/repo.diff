--- /dev/null
+++ b/src/server.ts
@@ -0,0 +1,319 @@
+import http from "node:http";
+import { pathToFileURL } from "node:url";
+import { decodeHeaderValue, validateParamHeaders } from "./headers.js";
+import { FieldNotesServer } from "./mcp.js";
+import {
+  INTERNAL_ERROR,
+  INVALID_PARAMS,
+  INVALID_REQUEST,
+  META_CLIENT_CAPABILITIES,
+  META_PROTOCOL_VERSION,
+  META_SERVER_INFO,
+  McpError,
+  PARSE_ERROR,
+  SERVER_INFO,
+  SUPPORTED_VERSIONS,
+  UNSUPPORTED_PROTOCOL_VERSION,
+  headerMismatch,
+  isObject,
+  isRequestId,
+  type JsonObject,
+  type RequestId,
+} from "./protocol.js";
+import { createSeededStore } from "./store.js";
+
+const MCP_PATH = "/mcp";
+const MAX_BODY_BYTES = 1024 * 1024;
+const KEEPALIVE_MS = 15_000;
+
+/** Methods whose `Mcp-Name` header mirrors `params.name` or `params.uri`. */
+const NAME_SOURCE: Record<string, "name" | "uri"> = {
+  "tools/call": "name",
+  "prompts/get": "name",
+  "resources/read": "uri",
+};
+
+function header(req: http.IncomingMessage, name: string): string | undefined {
+  const v = req.headers[name];
+  return Array.isArray(v) ? v.join(", ") : v;
+}
+
+function sendJson(res: http.ServerResponse, status: number, body: unknown): void {
+  const data = JSON.stringify(body);
+  res.writeHead(status, {
+    "Content-Type": "application/json",
+    "Content-Length": Buffer.byteLength(data),
+  });
+  res.end(data);
+}
+
+function sendError(res: http.ServerResponse, err: McpError, id: RequestId | null): void {
+  sendJson(res, err.httpStatus, err.toJson(id));
+}
+
+function acceptsBoth(accept: string | undefined): boolean {
+  if (!accept) return false;
+  const types = accept.split(",").map((p) => p.split(";")[0]!.trim().toLowerCase());
+  const has = (t: string) => types.includes(t) || types.includes("*/*") || types.includes(t.split("/")[0] + "/*");
+  return has("application/json") && has("text/event-stream");
+}
+
+function readBody(req: http.IncomingMessage): Promise<Buffer | null> {
+  return new Promise((resolve, reject) => {
+    const chunks: Buffer[] = [];
+    let size = 0;
+    req.on("data", (chunk: Buffer) => {
+      size += chunk.length;
+      if (size > MAX_BODY_BYTES) {
+        resolve(null);
+        req.destroy();
+        return;
+      }
+      chunks.push(chunk);
+    });
+    req.on("end", () => resolve(Buffer.concat(chunks)));
+    req.on("error", reject);
+  });
+}
+
+/**
+ * Checks the per-request `_meta` fields and the mirrored HTTP headers.
+ * Returns the declared client capabilities.
+ */
+function validateRequestMetadata(req: http.IncomingMessage, method: string, params: JsonObject): JsonObject {
+  const meta = params._meta;
+  const bodyVersion = isObject(meta) ? meta[META_PROTOCOL_VERSION] : undefined;
+  const headerVersion = header(req, "mcp-protocol-version");
+  const unsupported = (requested: string) =>
+    new McpError(
+      UNSUPPORTED_PROTOCOL_VERSION,
+      `Unsupported protocol version: ${requested} (supported: ${SUPPORTED_VERSIONS.join(", ")})`,
+      { supported: SUPPORTED_VERSIONS, requested },
+      400,
+    );
+
+  if (typeof bodyVersion !== "string") {
+    // A legacy client announces its version only in the header; tell it
+    // which versions are supported instead of a generic complaint.
+    if (headerVersion !== undefined && !SUPPORTED_VERSIONS.includes(headerVersion)) {
+      throw unsupported(headerVersion);
+    }
+    throw new McpError(INVALID_PARAMS, `Missing required _meta field: ${META_PROTOCOL_VERSION}`, undefined, 400);
+  }
+  if (headerVersion === undefined) {
+    throw headerMismatch("Header mismatch: required header MCP-Protocol-Version is missing");
+  }
+  if (headerVersion !== bodyVersion) {
+    throw headerMismatch(
+      `Header mismatch: MCP-Protocol-Version header value '${headerVersion}' does not match body value '${bodyVersion}'`,
+    );
+  }
+  if (!SUPPORTED_VERSIONS.includes(bodyVersion)) throw unsupported(bodyVersion);
+
+  const caps = (meta as JsonObject)[META_CLIENT_CAPABILITIES];
+  if (!isObject(caps)) {
+    throw new McpError(INVALID_PARAMS, `Missing required _meta field: ${META_CLIENT_CAPABILITIES}`, undefined, 400);
+  }
+
+  const methodHeader = header(req, "mcp-method");
+  if (methodHeader === undefined) {
+    throw headerMismatch("Header mismatch: required header Mcp-Method is missing");
+  }
+  if (methodHeader !== method) {
+    throw headerMismatch(`Header mismatch: Mcp-Method header value '${methodHeader}' does not match body value '${method}'`);
+  }
+  return caps;
+}
+
+function validateNameHeader(req: http.IncomingMessage, method: string, params: JsonObject): void {
+  const source = NAME_SOURCE[method];
+  if (!source) return;
+  const raw = header(req, "mcp-name");
+  if (raw === undefined) throw headerMismatch("Header mismatch: required header Mcp-Name is missing");
+  const bodyValue = params[source];
+  if (typeof bodyValue !== "string") throw new McpError(INVALID_PARAMS, `Missing required parameter: ${source}`);
+  const decoded = decodeHeaderValue("Mcp-Name", raw);
+  if (decoded !== bodyValue) {
+    throw headerMismatch(`Header mismatch: Mcp-Name header value '${decoded}' does not match body value '${bodyValue}'`);
+  }
+}
+
+export function createHttpServer(port: number, mcp = new FieldNotesServer(createSeededStore())): http.Server {
+  const allowedOrigins = new Set([`http://localhost:${port}`, `http://127.0.0.1:${port}`]);
+
+  async function handlePost(req: http.IncomingMessage, res: http.ServerResponse): Promise<void> {
+    if (!acceptsBoth(header(req, "accept"))) {
+      sendError(
+        res,
+        new McpError(INVALID_REQUEST, "Not Acceptable: Accept must list application/json and text/event-stream", undefined, 406),
+        null,
+      );
+      return;
+    }
+    const raw = await readBody(req);
+    if (raw === null) {
+      sendError(res, new McpError(INVALID_REQUEST, "Request body too large", undefined, 413), null);
+      return;
+    }
+    let msg: unknown;
+    try {
+      msg = JSON.parse(raw.toString("utf8"));
+    } catch {
+      sendError(res, new McpError(PARSE_ERROR, "Parse error: body is not valid JSON", undefined, 400), null);
+      return;
+    }
+    if (!isObject(msg) || msg.jsonrpc !== "2.0" || typeof msg.method !== "string") {
+      const id = isObject(msg) && isRequestId(msg.id) ? msg.id : null;
+      const why = Array.isArray(msg)
+        ? "batches are not supported"
+        : "body must be a single JSON-RPC request or notification";
+      sendError(res, new McpError(INVALID_REQUEST, `Invalid Request: ${why}`, undefined, 400), id);
+      return;
+    }
+    if (msg.params !== undefined && !isObject(msg.params)) {
+      const id = isRequestId(msg.id) ? msg.id : null;
+      sendError(res, new McpError(INVALID_REQUEST, "Invalid Request: params must be an object", undefined, 400), id);
+      return;
+    }
+    const method = msg.method;
+    const params = (msg.params ?? {}) as JsonObject;
+
+    if (!("id" in msg)) {
+      // Notifications (e.g. notifications/cancelled) need no reply; on HTTP,
+      // cancellation is signalled by closing the response stream instead.
+      res.writeHead(202).end();
+      return;
+    }
+    if (!isRequestId(msg.id)) {
+      sendError(res, new McpError(INVALID_REQUEST, "Invalid Request: id must be a string or integer", undefined, 400), null);
+      return;
+    }
+    const id = msg.id;
+
+    let clientCapabilities: JsonObject;
+    try {
+      if (method === "initialize") {
+        // Legacy handshake: say which versions this server speaks.
+        const requested = typeof params.protocolVersion === "string" ? params.protocolVersion : "unknown";
+        throw new McpError(
+          UNSUPPORTED_PROTOCOL_VERSION,
+          `Unsupported protocol version: this server does not support the initialize handshake; supported versions: ${SUPPORTED_VERSIONS.join(", ")}`,
+          { supported: SUPPORTED_VERSIONS, requested },
+          400,
+        );
+      }
+      clientCapabilities = validateRequestMetadata(req, method, params);
+      if (!mcp.hasMethod(method)) {
+        throw new McpError(-32601, `Method not found: ${method}`, undefined, 404);
+      }
+      validateNameHeader(req, method, params);
+      if (method === "tools/call" && typeof params.name === "string") {
+        const headerParams = mcp.headerParamsFor(params.name);
+        if (headerParams) validateParamHeaders(headerParams, params.arguments, (n) => header(req, n));
+      }
+    } catch (err) {
+      sendError(res, err instanceof McpError ? err : new McpError(INTERNAL_ERROR, "Internal error"), id);
+      return;
+    }
+
+    // The reply is plain JSON unless the handler emits a notification first,
+    // in which case it becomes an SSE stream scoped to this request.
+    const cancel = new AbortController();
+    let streaming = false;
+    let keepalive: NodeJS.Timeout | undefined;
+    res.on("close", () => {
+      clearInterval(keepalive);
+      if (!res.writableFinished) cancel.abort();
+    });
+    const writeEvent = (payload: unknown) => {
+      res.write(`event: message\ndata: ${JSON.stringify(payload)}\n\n`);
+    };
+    const notify = (notifMethod: string, notifParams: JsonObject) => {
+      if (cancel.signal.aborted || res.writableEnded) return;
+      if (!streaming) {
+        streaming = true;
+        res.writeHead(200, {
+          "Content-Type": "text/event-stream",
+          "Cache-Control": "no-cache, no-transform",
+          Connection: "keep-alive",
+          "X-Accel-Buffering": "no",
+        });
+        keepalive = setInterval(() => res.write(":\n\n"), KEEPALIVE_MS);
+      }
+      writeEvent({ jsonrpc: "2.0", method: notifMethod, params: notifParams });
+    };
+
+    let reply: JsonObject;
+    try {
+      const result = await mcp.handle(method, { id, params, clientCapabilities, signal: cancel.signal, notify });
+      if (result === null || cancel.signal.aborted) {
+        if (!res.writableEnded) res.end();
+        return;
+      }
+      result._meta = { ...(isObject(result._meta) ? result._meta : {}), [META_SERVER_INFO]: SERVER_INFO };
+      reply = { jsonrpc: "2.0", id, result };
+    } catch (err) {
+      const e = err instanceof McpError ? err : new McpError(INTERNAL_ERROR, "Internal error");
+      if (!(err instanceof McpError)) console.error(err);
+      if (!streaming) return sendError(res, e, id);
+      reply = e.toJson(id);
+    }
+    if (cancel.signal.aborted || res.writableEnded) return;
+    if (streaming) {
+      clearInterval(keepalive);
+      writeEvent(reply);
+      res.end();
+    } else {
+      sendJson(res, 200, reply);
+    }
+  }
+
+  return http.createServer((req, res) => {
+    const url = new URL(req.url ?? "/", "http://localhost");
+    const origin = header(req, "origin");
+    if (origin !== undefined && !allowedOrigins.has(origin)) {
+      sendError(res, new McpError(INVALID_REQUEST, "Forbidden: origin not allowed", undefined, 403), null);
+      return;
+    }
+    if (url.pathname !== MCP_PATH) {
+      sendJson(res, 404, { error: "Not found" });
+      return;
+    }
+    if (req.method !== "POST") {
+      res.writeHead(405, { Allow: "POST", "Content-Type": "application/json" });
+      res.end(JSON.stringify(new McpError(INVALID_REQUEST, "Method not allowed: use POST").toJson(null)));
+      return;
+    }
+    handlePost(req, res).catch((err) => {
+      console.error(err);
+      if (!res.headersSent) sendError(res, new McpError(INTERNAL_ERROR, "Internal error", undefined, 500), null);
+      else res.end();
+    });
+  });
+}
+
+function main(): void {
+  const port = Number(process.env.PORT ?? 3000);
+  if (!Number.isInteger(port) || port < 0 || port > 65535) {
+    console.error(`Invalid PORT: ${process.env.PORT}`);
+    process.exit(1);
+  }
+  const mcp = new FieldNotesServer(createSeededStore());
+  const server = createHttpServer(port, mcp);
+  server.listen(port, "127.0.0.1", () => {
+    console.error(`field-notes MCP server listening on http://127.0.0.1:${port}${MCP_PATH}`);
+  });
+  const shutdown = () => {
+    // End subscriptions gracefully, then stop accepting connections.
+    mcp.close();
+    server.close(() => process.exit(0));
+    setTimeout(() => {
+      server.closeAllConnections();
+      process.exit(0);
+    }, 1000).unref();
+  };
+  process.on("SIGINT", shutdown);
+  process.on("SIGTERM", shutdown);
+}
+
+if (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) main();
diff --git a/src/store.ts b/src/store.ts
new file mode 100644
index 0000000..642e5a2
--- /dev/null
+++ b/src/store.ts
@@ -0,0 +1,83 @@
+import { EventEmitter } from "node:events";
+
+export interface Note {
+  id: string;
+  notebook: string;
+  title: string;
+  body: string;
+}
+
+export const NOTEBOOK_PATTERN = /^[A-Za-z0-9_-]{1,64}$/;
+export const TITLE_MAX_LENGTH = 200;
+
+export const INDEX_URI = "notes://index";
+export const NOTE_URI_PREFIX = "notes://notes/";
+
+export function noteUri(id: string): string {
+  return NOTE_URI_PREFIX + id;
+}
+
+/** Markdown rendering shared by the note resource and the prompt. */
+export function renderNote(note: Note): string {
+  return `# ${note.title}\n\n${note.body}\n`;
+}
+
+/**
+ * In-memory note store. Emits `updated` with a resource URI whenever the
+ * content behind that URI changes.
+ */
+export class NoteStore extends EventEmitter<{ updated: [uri: string] }> {
+  private notes = new Map<string, Note>();
+  private nextId = 1;
+
+  constructor(seed: Omit<Note, "id">[] = []) {
+    super();
+    for (const n of seed) this.insert(n);
+  }
+
+  private insert(fields: Omit<Note, "id">): Note {
+    const note: Note = { id: `n${this.nextId++}`, ...fields };
+    this.notes.set(note.id, note);
+    return note;
+  }
+
+  add(fields: Omit<Note, "id">): Note {
+    const note = this.insert(fields);
+    this.emit("updated", INDEX_URI);
+    return note;
+  }
+
+  get(id: string): Note | undefined {
+    return this.notes.get(id);
+  }
+
+  delete(id: string): boolean {
+    if (!this.notes.delete(id)) return false;
+    this.emit("updated", INDEX_URI);
+    this.emit("updated", noteUri(id));
+    return true;
+  }
+
+  /** All notes ordered by numeric id. */
+  list(): Note[] {
+    return [...this.notes.values()].sort(
+      (a, b) => Number(a.id.slice(1)) - Number(b.id.slice(1)),
+    );
+  }
+}
+
+export function createSeededStore(): NoteStore {
+  return new NoteStore([
+    {
+      notebook: "work",
+      title: "Standup",
+      body: "Discussed the release schedule and blockers.",
+    },
+    {
+      notebook: "work",
+      title: "Retro actions",
+      body: "Automate the changelog. Rotate the on-call.",
+    },
+    { notebook: "personal", title: "Groceries", body: "Eggs, flour, coffee." },
+  ]);
+}
diff --git a/test/server.test.ts b/test/server.test.ts
new file mode 100644
index 0000000..27978de
--- /dev/null
+++ b/test/server.test.ts
@@ -0,0 +1,949 @@
+import { after, before, describe, test } from "node:test";
+import assert from "node:assert/strict";
+import { execFileSync, spawn } from "node:child_process";
+import { once } from "node:events";
+import http from "node:http";
+import net from "node:net";
+import path from "node:path";
+import { Readable, duplexPair, type Duplex } from "node:stream";
+import { fileURLToPath, pathToFileURL } from "node:url";
+
+const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
+const VERSION = "2026-07-28";
+
+/**
+ * By default each server is `node dist/server.js` listening on a real TCP
+ * port. With MCP_TEST_INPROCESS=1 the same HTTP server is created in-process
+ * and connections are in-memory duplex streams through Node's HTTP stack —
+ * for sandboxes that forbid binding ports.
+ */
+const IN_PROCESS = process.env.MCP_TEST_INPROCESS === "1";
+
+type Json = Record<string, any>;
+
+interface Server {
+  port: number;
+  url: string;
+  stderr: () => string;
+  /** Asks the server to shut down (SIGTERM). */
+  shutdown: () => void;
+  stop: () => Promise<void>;
+}
+
+/** In-process connection factories, keyed by port. */
+const connectors = new Map<string, () => Duplex>();
+
+async function freePort(): Promise<number> {
+  const srv = net.createServer();
+  srv.listen(0, "127.0.0.1");
+  await once(srv, "listening");
+  const port = (srv.address() as net.AddressInfo).port;
+  srv.close();
+  await once(srv, "close");
+  return port;
+}
+
+let inProcessLog = "";
+let fakePort = 41000;
+
+async function startInProcessServer(): Promise<Server> {
+  const dist = (f: string) => pathToFileURL(path.join(ROOT, "dist", f)).href;
+  const { createHttpServer } = await import(dist("server.js"));
+  const { FieldNotesServer } = await import(dist("mcp.js"));
+  const { createSeededStore } = await import(dist("store.js"));
+  if (!inProcessLog) {
+    const orig = console.error;
+    inProcessLog = " ";
+    console.error = (...args: unknown[]) => {
+      inProcessLog += args.join(" ") + "\n";
+      if (process.env.MCP_TEST_VERBOSE) orig(...args);
+    };
+  }
+  const port = fakePort++;
+  const mcp = new FieldNotesServer(createSeededStore());
+  const srv: http.Server = createHttpServer(port, mcp);
+  connectors.set(String(port), () => {
+    const [serverSide, clientSide] = duplexPair();
+    clientSide.on("close", () => serverSide.destroy());
+    serverSide.on("close", () => clientSide.destroy());
+    srv.emit("connection", serverSide);
+    return clientSide;
+  });
+  return {
+    port,
+    url: `http://127.0.0.1:${port}/mcp`,
+    stderr: () => inProcessLog,
+    shutdown: () => mcp.close(),
+    stop: async () => {
+      mcp.close();
+      connectors.delete(String(port));
+    },
+  };
+}
+
+async function startServer(): Promise<Server> {
+  if (IN_PROCESS) return startInProcessServer();
+  const port = await freePort();
+  const proc = spawn(process.execPath, ["dist/server.js"], {
+    cwd: ROOT,
+    env: { ...process.env, PORT: String(port) },
+    stdio: ["ignore", "ignore", "pipe"],
+  });
+  let log = "";
+  proc.stderr!.setEncoding("utf8");
+  await new Promise<void>((resolve, reject) => {
+    proc.stderr!.on("data", (chunk: string) => {
+      log += chunk;
+      if (log.includes("listening")) resolve();
+    });
+    proc.on("exit", (code) => reject(new Error(`server exited early (${code}): ${log}`)));
+  });
+  return {
+    port,
+    url: `http://127.0.0.1:${port}/mcp`,
+    stderr: () => log,
+    shutdown: () => proc.kill("SIGTERM"),
+    stop: async () => {
+      if (proc.exitCode !== null || proc.signalCode !== null) return;
+      proc.kill("SIGTERM");
+      await once(proc, "exit");
+    },
+  };
+}
+
+async function stopServer(s: Server): Promise<void> {
+  await s.stop();
+}
