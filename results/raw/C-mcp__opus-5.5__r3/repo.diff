diff --git a/src/headers.ts b/src/headers.ts
new file mode 100644
index 0000000..7fe1dd4
--- /dev/null
+++ b/src/headers.ts
@@ -0,0 +1,111 @@
+import { headerMismatch, isObject, type JsonObject } from "./protocol.js";
+
+const SENTINEL = /^=\?base64\?([A-Za-z0-9+/]*={0,2})\?=$/;
+const utf8 = new TextDecoder("utf-8", { fatal: true });
+
+/**
+ * Decodes an `Mcp-Name` / `Mcp-Param-*` header value: plain visible ASCII is
+ * taken as-is, `=?base64?...?=` is Base64-decoded UTF-8. Throws HeaderMismatch
+ * for values with invalid characters or a malformed encoding.
+ */
+export function decodeHeaderValue(headerName: string, raw: string): string {
+  // Node decodes header bytes as latin1, so any byte outside visible ASCII,
+  // space and tab shows up here as a character outside that range.
+  if (!/^[\t\x20-\x7e]*$/.test(raw)) {
+    throw headerMismatch(`Header ${headerName} contains invalid characters`);
+  }
+  if (!raw.startsWith("=?base64?") || !raw.endsWith("?=")) return raw;
+  const m = SENTINEL.exec(raw);
+  const b64 = m?.[1];
+  if (b64 === undefined || b64.length % 4 !== 0) {
+    throw headerMismatch(`Header ${headerName} has a malformed Base64 value`);
+  }
+  const bytes = Buffer.from(b64, "base64");
+  if (bytes.toString("base64") !== b64) {
+    throw headerMismatch(`Header ${headerName} has a malformed Base64 value`);
+  }
+  try {
+    return utf8.decode(bytes);
+  } catch {
+    throw headerMismatch(`Header ${headerName} is not valid UTF-8`);
+  }
+}
+
+export interface HeaderParam {
+  /** Chain of `properties` keys from the schema root. */
+  path: string[];
+  /** Name part of the `Mcp-Param-{name}` header. */
+  name: string;
+}
+
+/** Collects `x-mcp-header` annotations statically reachable via `properties`. */
+export function collectHeaderParams(schema: JsonObject, path: string[] = []): HeaderParam[] {
+  const out: HeaderParam[] = [];
+  const props = schema.properties;
+  if (!isObject(props)) return out;
+  for (const [key, sub] of Object.entries(props)) {
+    if (!isObject(sub)) continue;
+    const name = sub["x-mcp-header"];
+    if (typeof name === "string") out.push({ path: [...path, key], name });
+    out.push(...collectHeaderParams(sub, [...path, key]));
+  }
+  return out;
+}
+
+function valueAt(args: unknown, path: string[]): unknown {
+  let cur: unknown = args;
+  for (const key of path) {
+    if (!isObject(cur)) return undefined;
+    cur = cur[key];
+  }
+  return cur;
+}
+
+function matches(decoded: string, value: unknown): boolean {
+  switch (typeof value) {
+    case "string":
+      return decoded === value;
+    case "boolean":
+      return decoded === String(value);
+    case "number":
+      return decoded.trim() !== "" && Number(decoded) === value;
+    default:
+      // Objects/arrays cannot be mirrored into a header.
+      return false;
+  }
+}
+
+/**
+ * Enforces the `Mcp-Param-*` consistency rules for one tool call: a value in
+ * the body requires a matching header; a header requires a matching value.
+ */
+export function validateParamHeaders(
+  params: HeaderParam[],
+  args: unknown,
+  getHeader: (lowerName: string) => string | undefined,
+): void {
+  for (const p of params) {
+    const headerName = `Mcp-Param-${p.name}`;
+    const raw = getHeader(headerName.toLowerCase());
+    const value = valueAt(args, p.path);
+    if (value === undefined || value === null) {
+      if (raw !== undefined) {
+        throw headerMismatch(
+          `Header mismatch: ${headerName} header is present but argument '${p.path.join(".")}' is absent from the body`,
+        );
+      }
+      continue;
+    }
+    if (raw === undefined) {
+      throw headerMismatch(
+        `Header mismatch: required header ${headerName} is missing for argument '${p.path.join(".")}'`,
+      );
+    }
+    const decoded = decodeHeaderValue(headerName, raw);
+    if (!matches(decoded, value)) {
+      throw headerMismatch(
+        `Header mismatch: ${headerName} header value '${decoded}' does not match body value ${JSON.stringify(value)}`,
+      );
+    }
+  }
+}
diff --git a/src/mcp.ts b/src/mcp.ts
new file mode 100644
index 0000000..54a3371
--- /dev/null
+++ b/src/mcp.ts
@@ -0,0 +1,510 @@
+import { setTimeout as sleep } from "node:timers/promises";
+import { collectHeaderParams, type HeaderParam } from "./headers.js";
+import {
+  INSTRUCTIONS,
+  INVALID_PARAMS,
+  META_SUBSCRIPTION_ID,
+  METHOD_NOT_FOUND,
+  MISSING_REQUIRED_CLIENT_CAPABILITY,
+  McpError,
+  SUPPORTED_VERSIONS,
+  invalidParams,
+  isObject,
+  type JsonObject,
+  type RequestId,
+} from "./protocol.js";
+import { RequestStateCodec } from "./request-state.js";
+import {
+  INDEX_URI,
+  NOTEBOOK_PATTERN,
+  NOTE_URI_PREFIX,
+  TITLE_MAX_LENGTH,
+  noteUri,
+  renderNote,
+  type NoteStore,
+} from "./store.js";
+
+/** Everything a handler needs about one request; nothing is connection-scoped. */
+export interface RequestContext {
+  id: RequestId;
+  params: JsonObject;
+  clientCapabilities: JsonObject;
+  /** Aborted when the client goes away (cancellation). */
+  signal: AbortSignal;
+  /** Sends a notification scoped to this request (on its response stream). */
+  notify(method: string, params: JsonObject): void;
+}
+
+/** A handler resolves to a result, or null when no response should be sent. */
+type Handler = (ctx: RequestContext) => Promise<JsonObject | null>;
+
+const LIST_TTL_MS = 5 * 60 * 1000;
+const CONFIRM_KEY = "confirm_delete";
+
+const TOOLS = [
+  {
+    name: "add_note",
+    title: "Add note",
+    description: "Create a note in a notebook. Returns the new note's id and resource URI.",
+    inputSchema: {
+      type: "object",
+      properties: {
+        notebook: {
+          type: "string",
+          description: "Notebook name: 1-64 characters from A-Z, a-z, 0-9, '_' and '-'.",
+          pattern: "^[A-Za-z0-9_-]{1,64}$",
+          minLength: 1,
+          maxLength: 64,
+          "x-mcp-header": "Notebook",
+        },
+        title: {
+          type: "string",
+          description: "Note title (non-empty, at most 200 characters).",
+          minLength: 1,
+          maxLength: TITLE_MAX_LENGTH,
+        },
+        body: { type: "string", description: "Note body (may be empty)." },
+      },
+      required: ["notebook", "title", "body"],
+    },
+    outputSchema: {
+      type: "object",
+      properties: {
+        id: { type: "string" },
+        uri: { type: "string" },
+        notebook: { type: "string" },
+        wordCount: { type: "integer", minimum: 0 },
+      },
+      required: ["id", "uri", "notebook", "wordCount"],
+    },
+    annotations: { readOnlyHint: false, destructiveHint: false, openWorldHint: false },
+  },
+  {
+    name: "delete_note",
+    title: "Delete note",
+    description: "Delete a note by id. The user is asked to confirm before anything is deleted.",
+    inputSchema: {
+      type: "object",
+      properties: {
+        id: { type: "string", description: "Note id, e.g. n1." },
+      },
+      required: ["id"],
+    },
+    annotations: { readOnlyHint: false, destructiveHint: true, idempotentHint: true, openWorldHint: false },
+  },
+  {
+    name: "reindex",
+    title: "Rebuild search index",
+    description: "Rebuild the search index. Slow; reports progress after each step.",
+    inputSchema: {
+      type: "object",
+      properties: {
+        steps: { type: "integer", minimum: 1, maximum: 20, default: 5, description: "Number of steps." },
+        delayMs: {
+          type: "integer",
+          minimum: 0,
+          maximum: 1000,
+          default: 200,
+          description: "Time spent on each step, in milliseconds.",
+        },
+      },
+    },
+    annotations: { readOnlyHint: false, destructiveHint: false, idempotentHint: true, openWorldHint: false },
+  },
+];
+
+const HEADER_PARAMS = new Map<string, HeaderParam[]>(
+  TOOLS.map((t) => [t.name, collectHeaderParams(t.inputSchema)]),
+);
+
+const PROMPTS = [
+  {
+    name: "summarize_notebook",
+    title: "Summarize notebook",
+    description: "Ask the model to summarize all notes in a notebook.",
+    arguments: [
+      { name: "notebook", description: "Notebook to summarize.", required: true },
+      { name: "style", description: "`brief` (default) or `detailed`.", required: false },
+    ],
+  },
+];
+
+const INDEX_RESOURCE = {
+  uri: INDEX_URI,
+  name: "index",
+  title: "All notes",
+  mimeType: "application/json",
+};
+
+const NOTE_TEMPLATE = {
+  uriTemplate: `${NOTE_URI_PREFIX}{id}`,
+  name: "note",
+  title: "A single note",
+  mimeType: "text/markdown",
+};
+
+const WATCHABLE_NOTE_URI = /^notes:\/\/notes\/[^/]+$/;
+
+function text(t: string): JsonObject {
+  return { type: "text", text: t };
+}
+
+function toolResult(t: string, isError = false): JsonObject {
+  const r: JsonObject = { resultType: "complete", content: [text(t)] };
+  if (isError) r.isError = true;
+  return r;
+}
+
+function checkNoCursor(params: JsonObject): void {
+  // Every list fits on a single page, so no cursor is ever valid.
+  if (params.cursor !== undefined) throw invalidParams("Invalid cursor");
+}
+
+function supportsFormElicitation(caps: JsonObject): boolean {
+  const e = caps.elicitation;
+  if (!isObject(e)) return false;
+  if (e.form !== undefined) return isObject(e.form);
+  // An empty elicitation object means form mode only.
+  return e.url === undefined;
+}
+
+export class FieldNotesServer {
+  private readonly store: NoteStore;
+  private readonly states: RequestStateCodec;
+  private readonly shutdown = new AbortController();
+  private readonly handlers: Record<string, Handler>;
+  private readonly tools: Record<string, (ctx: RequestContext, args: JsonObject) => Promise<JsonObject | null>>;
+
+  constructor(store: NoteStore, states = new RequestStateCodec()) {
+    this.store = store;
+    this.states = states;
+    this.handlers = {
+      "server/discover": async () => this.discover(),
+      "tools/list": async (ctx) => {
+        checkNoCursor(ctx.params);
+        return { resultType: "complete", tools: TOOLS, ttlMs: LIST_TTL_MS, cacheScope: "public" };
+      },
+      "tools/call": (ctx) => this.callTool(ctx),
+      "resources/list": async (ctx) => {
+        checkNoCursor(ctx.params);
+        return { resultType: "complete", resources: [INDEX_RESOURCE], ttlMs: LIST_TTL_MS, cacheScope: "public" };
+      },
+      "resources/templates/list": async (ctx) => {
+        checkNoCursor(ctx.params);
+        return {
+          resultType: "complete",
+          resourceTemplates: [NOTE_TEMPLATE],
+          ttlMs: LIST_TTL_MS,
+          cacheScope: "public",
+        };
+      },
+      "resources/read": async (ctx) => this.readResource(ctx),
+      "prompts/list": async (ctx) => {
+        checkNoCursor(ctx.params);
+        return { resultType: "complete", prompts: PROMPTS, ttlMs: LIST_TTL_MS, cacheScope: "public" };
+      },
+      "prompts/get": async (ctx) => this.getPrompt(ctx),
+      "subscriptions/listen": (ctx) => this.listen(ctx),
+    };
+    this.tools = {
+      add_note: async (_ctx, args) => this.addNote(args),
+      delete_note: async (ctx, args) => this.deleteNote(ctx, args),
+      reindex: (ctx, args) => this.reindex(ctx, args),
+    };
+  }
+
+  hasMethod(method: string): boolean {
+    return Object.hasOwn(this.handlers, method);
+  }
+
+  /** `x-mcp-header` parameters of a tool, or undefined for unknown tools. */
+  headerParamsFor(tool: string): HeaderParam[] | undefined {
+    return HEADER_PARAMS.get(tool);
+  }
+
+  handle(method: string, ctx: RequestContext): Promise<JsonObject | null> {
+    const handler = this.handlers[method];
+    if (!handler) {
+      return Promise.reject(new McpError(METHOD_NOT_FOUND, `Method not found: ${method}`, undefined, 404));
+    }
+    return handler(ctx);
+  }
+
+  /** Ends all subscriptions gracefully. */
+  close(): void {
+    this.shutdown.abort();
+  }
+
+  private discover(): JsonObject {
+    return {
+      resultType: "complete",
+      supportedVersions: SUPPORTED_VERSIONS,
+      capabilities: { tools: {}, resources: { subscribe: true }, prompts: {} },
+      instructions: INSTRUCTIONS,
+      ttlMs: LIST_TTL_MS,
+      cacheScope: "public",
+    };
+  }
+
+  // ---- Resources -------------------------------------------------------
+
+  private readResource(ctx: RequestContext): JsonObject {
+    const uri = ctx.params.uri;
+    if (typeof uri !== "string") throw invalidParams("Missing required parameter: uri");
+    let content: JsonObject | undefined;
+    if (uri === INDEX_URI) {
+      const index = this.store.list().map(({ id, notebook, title }) => ({ id, notebook, title }));
+      content = { uri, mimeType: "application/json", text: JSON.stringify(index) };
+    } else if (uri.startsWith(NOTE_URI_PREFIX)) {
+      const note = this.store.get(uri.slice(NOTE_URI_PREFIX.length));
+      if (note) content = { uri, mimeType: "text/markdown", text: renderNote(note) };
+    }
+    if (!content) throw invalidParams("Resource not found", { uri });
+    // Note data is per-user and must always be re-fetched.
+    return { resultType: "complete", contents: [content], ttlMs: 0, cacheScope: "private" };
+  }
+
+  // ---- Prompts ---------------------------------------------------------
+
+  private getPrompt(ctx: RequestContext): JsonObject {
+    const { name, arguments: args = {} } = ctx.params;
+    if (typeof name !== "string") throw invalidParams("Missing required parameter: name");
+    if (name !== "summarize_notebook") throw invalidParams(`Unknown prompt: ${name}`);
+    if (!isObject(args)) throw invalidParams("Prompt arguments must be an object");
+    for (const [k, v] of Object.entries(args)) {
+      if (typeof v !== "string") throw invalidParams(`Prompt argument '${k}' must be a string`);
+    }
+    const notebook = args.notebook as string | undefined;
+    if (notebook === undefined || notebook === "") {
+      throw invalidParams("Missing required argument: notebook");
+    }
+    const style = (args.style as string | undefined) ?? "brief";
+    let instruction: string;
+    if (style === "brief") {
+      instruction = `Summarize the notes in the "${notebook}" notebook in two sentences.`;
+    } else if (style === "detailed") {
+      instruction = `Summarize the notes in the "${notebook}" notebook in detail, one paragraph per note.`;
+    } else {
+      throw invalidParams(`Invalid style '${style}': expected 'brief' or 'detailed'`);
+    }
+    const messages: JsonObject[] = [{ role: "user", content: text(instruction) }];
+    for (const note of this.store.list()) {
+      if (note.notebook !== notebook) continue;
+      messages.push({
+        role: "user",
+        content: {
+          type: "resource",
+          resource: { uri: noteUri(note.id), mimeType: "text/markdown", text: renderNote(note) },
+        },
+      });
+    }
+    return { resultType: "complete", description: `Summary of the "${notebook}" notebook`, messages };
+  }
+
+  // ---- Tools -----------------------------------------------------------
+
+  private async callTool(ctx: RequestContext): Promise<JsonObject | null> {
+    const { name, arguments: args = {} } = ctx.params;
+    if (typeof name !== "string") throw invalidParams("Missing required parameter: name");
+    const tool = Object.hasOwn(this.tools, name) ? this.tools[name] : undefined;
+    if (!tool) throw invalidParams(`Unknown tool: ${name}`);
+    if (!isObject(args)) throw invalidParams("Tool arguments must be an object");
+    return tool(ctx, args);
+  }
+
+  private addNote(args: JsonObject): JsonObject {
+    const { notebook, title, body } = args;
+    const problems: string[] = [];
+    if (notebook === undefined) problems.push("'notebook' is required");
+    else if (typeof notebook !== "string") problems.push("'notebook' must be a string");
+    else if (!NOTEBOOK_PATTERN.test(notebook)) {
+      problems.push(
+        `'notebook' must be 1-64 characters from A-Z, a-z, 0-9, '_' and '-' (got ${JSON.stringify(notebook)})`,
+      );
+    }
+    if (title === undefined) problems.push("'title' is required");
+    else if (typeof title !== "string") problems.push("'title' must be a string");
+    else if (title.trim() === "") problems.push("'title' must not be empty");
+    else if ([...title].length > TITLE_MAX_LENGTH) {
+      problems.push(`'title' must be at most ${TITLE_MAX_LENGTH} characters (got ${[...title].length})`);
+    }
+    if (body === undefined) problems.push("'body' is required (use an empty string for no body)");
+    else if (typeof body !== "string") problems.push("'body' must be a string");
+    if (problems.length > 0) {
+      return toolResult(`Invalid arguments for add_note: ${problems.join("; ")}.`, true);
+    }
+    const note = this.store.add({
+      notebook: notebook as string,
+      title: title as string,
+      body: body as string,
+    });
+    const output = {
+      id: note.id,
+      uri: noteUri(note.id),
+      notebook: note.notebook,
+      wordCount: note.body.split(/\s+/).filter((w) => w !== "").length,
+    };
+    return { resultType: "complete", content: [text(JSON.stringify(output))], structuredContent: output };
+  }
+
+  private deleteNote(ctx: RequestContext, args: JsonObject): JsonObject {
+    const { id } = args;
+    if (typeof id !== "string" || id === "") {
+      return toolResult("Invalid arguments for delete_note: 'id' is required and must be a string.", true);
+    }
+    const note = this.store.get(id);
+    if (!note) return toolResult(`Note ${id} not found`, true);
+
+    if (!supportsFormElicitation(ctx.clientCapabilities)) {
+      throw new McpError(
+        MISSING_REQUIRED_CLIENT_CAPABILITY,
+        "Server requires the elicitation capability (form mode) for delete_note",
+        { requiredCapabilities: { elicitation: { form: {} } } },
+        400,
+      );
+    }
+
+    // The confirmation is bound to this tool and note id and signed, so it
+    // cannot be forged, altered, or replayed against a different note.
+    const bind = { id };
+    const { requestState, inputResponses } = ctx.params;
+    if (requestState !== undefined) {
+      if (typeof requestState !== "string" || !this.states.verify(requestState, "tools/call", "delete_note", bind)) {
+        throw invalidParams("Invalid or expired requestState for delete_note");
+      }
+      const answer = isObject(inputResponses) ? inputResponses[CONFIRM_KEY] : undefined;
+      if (answer !== undefined) {
+        if (!isObject(answer) || !["accept", "decline", "cancel"].includes(answer.action as string)) {
+          throw invalidParams(`Invalid elicitation result for '${CONFIRM_KEY}'`);
+        }
+        if (answer.action !== "accept") return toolResult("Deletion cancelled");
+        const confirm = isObject(answer.content) ? answer.content.confirm : undefined;
+        if (typeof confirm !== "boolean") {
+          throw invalidParams(`Elicitation result for '${CONFIRM_KEY}' must contain a boolean 'confirm'`);
+        }
+        if (!confirm) return toolResult("Deletion cancelled");
+        this.store.delete(id);
+        return toolResult(`Deleted note ${id}`);
+      }
+      // Valid state but no answer: ask again.
+    }
+
+    return {
+      resultType: "input_required",
+      inputRequests: {
+        [CONFIRM_KEY]: {
+          method: "elicitation/create",
+          params: {
+            mode: "form",
+            message: `Delete note "${note.title}"?`,
+            requestedSchema: {
+              type: "object",
+              properties: {
+                confirm: {
+                  type: "boolean",
+                  title: "Confirm deletion",
+                  description: `Delete note ${id} permanently`,
+                },
+              },
+              required: ["confirm"],
+            },
+          },
+        },
+      },
+      requestState: this.states.issue("tools/call", "delete_note", bind),
+    };
+  }
+
+  private async reindex(ctx: RequestContext, args: JsonObject): Promise<JsonObject | null> {
+    const steps = args.steps ?? 5;
+    const delayMs = args.delayMs ?? 200;
+    const problems: string[] = [];
+    if (!Number.isInteger(steps) || (steps as number) < 1 || (steps as number) > 20) {
+      problems.push(`'steps' must be an integer from 1 to 20 (got ${JSON.stringify(steps)})`);
+    }
+    if (!Number.isInteger(delayMs) || (delayMs as number) < 0 || (delayMs as number) > 1000) {
+      problems.push(`'delayMs' must be an integer from 0 to 1000 (got ${JSON.stringify(delayMs)})`);
+    }
+    if (problems.length > 0) {
+      return toolResult(`Invalid arguments for reindex: ${problems.join("; ")}.`, true);
+    }
+    const total = steps as number;
+    const meta = ctx.params._meta;
+    const token = isObject(meta) ? meta.progressToken : undefined;
+    const progressToken =
+      typeof token === "string" || (typeof token === "number" && Number.isInteger(token)) ? token : undefined;
+
+    for (let k = 1; k <= total; k++) {
+      try {
+        await sleep(delayMs as number, undefined, { signal: ctx.signal });
+      } catch {
+        console.error(`reindex: request ${JSON.stringify(ctx.id)} cancelled after ${k - 1}/${total} steps`);
+        return null;
+      }
+      if (progressToken !== undefined) {
+        ctx.notify("notifications/progress", {
+          progressToken,
+          progress: k,
+          total,
+          message: `Indexed ${k}/${total}`,
+        });
+      }
+    }
+    if (ctx.signal.aborted) return null;
+    return toolResult(`Reindex complete: ${total} steps`);
+  }
+
+  // ---- Subscriptions ---------------------------------------------------
+
+  private async listen(ctx: RequestContext): Promise<JsonObject | null> {
+    const filter = ctx.params.notifications;
+    if (!isObject(filter)) throw invalidParams("Missing required parameter: notifications");
+    const requested = filter.resourceSubscriptions;
+    const acknowledged: JsonObject = {};
+    const watched = new Set<string>();
+    if (requested !== undefined) {
+      if (!Array.isArray(requested) || requested.some((u) => typeof u !== "string")) {
+        throw new McpError(INVALID_PARAMS, "resourceSubscriptions must be an array of URIs");
+      }
+      for (const uri of requested as string[]) {
+        if (uri === INDEX_URI || WATCHABLE_NOTE_URI.test(uri)) watched.add(uri);
+      }
+      acknowledged.resourceSubscriptions = [...watched];
+    }
+    // No list-changed notifications are offered: those lists never change.
+
+    const subscriptionId = ctx.id;
+    ctx.notify("notifications/subscriptions/acknowledged", {
+      _meta: { [META_SUBSCRIPTION_ID]: subscriptionId },
+      notifications: acknowledged,
+    });
+
+    const onUpdate = (uri: string) => {
+      if (!watched.has(uri)) return;
+      ctx.notify("notifications/resources/updated", {
+        _meta: { [META_SUBSCRIPTION_ID]: subscriptionId },
+        uri,
+      });
+    };
+    this.store.on("updated", onUpdate);
+    try {
+      const graceful = await new Promise<boolean>((resolve) => {
+        if (ctx.signal.aborted) return resolve(false);
+        if (this.shutdown.signal.aborted) return resolve(true);
+        const done = (value: boolean) => {
+          ctx.signal.removeEventListener("abort", onClientGone);
+          this.shutdown.signal.removeEventListener("abort", onShutdown);
+          resolve(value);
+        };
+        const onClientGone = () => done(false);
+        const onShutdown = () => done(true);
+        ctx.signal.addEventListener("abort", onClientGone);
+        this.shutdown.signal.addEventListener("abort", onShutdown);
+      });
+      if (!graceful) return null;
+      return { resultType: "complete", _meta: { [META_SUBSCRIPTION_ID]: subscriptionId } };
+    } finally {
+      this.store.off("updated", onUpdate);
+    }
+  }
+}
