+interface HttpResponse {
+  status: number;
+  headers: { get(name: string): string | null };
+  readonly body: ReadableStream<Uint8Array>;
+  text(): Promise<string>;
+  json(): Promise<any>;
+}
+
+/** Minimal fetch-alike on node:http, so it can also use in-process connections. */
+function httpFetch(
+  url: string,
+  init: { method?: string; headers?: Record<string, string>; body?: string; signal?: AbortSignal } = {},
+): Promise<HttpResponse> {
+  const u = new URL(url);
+  return new Promise((resolve, reject) => {
+    const req = http.request(
+      {
+        method: init.method ?? "GET",
+        host: u.hostname,
+        port: u.port,
+        path: u.pathname,
+        headers: init.headers,
+        signal: init.signal,
+        createConnection: connectors.get(u.port),
+      },
+      (res) => {
+        let web: ReadableStream<Uint8Array> | undefined;
+        const text = async () => {
+          let s = "";
+          res.setEncoding("utf8");
+          for await (const chunk of res) s += chunk;
+          return s;
+        };
+        resolve({
+          status: res.statusCode!,
+          headers: {
+            get: (name: string) => {
+              const v = res.headers[name.toLowerCase()];
+              return v === undefined ? null : Array.isArray(v) ? v.join(", ") : String(v);
+            },
+          },
+          get body() {
+            web ??= Readable.toWeb(res) as ReadableStream<Uint8Array>;
+            return web;
+          },
+          text,
+          json: async () => JSON.parse(await text()),
+        });
+      },
+    );
+    req.on("error", reject);
+    req.end(init.body);
+  });
+}
+
+let nextId = 1;
+
+function meta(caps: Json = {}, extra: Json = {}): Json {
+  return {
+    "io.modelcontextprotocol/protocolVersion": VERSION,
+    "io.modelcontextprotocol/clientInfo": { name: "test-client", version: "0.0.1" },
+    "io.modelcontextprotocol/clientCapabilities": caps,
+    ...extra,
+  };
+}
+
+interface RpcOptions {
+  caps?: Json;
+  metaExtra?: Json;
+  headers?: Record<string, string | undefined>;
+  signal?: AbortSignal;
+  /** Replace the whole body (headers are still derived from method/params). */
+  rawParams?: Json;
+}
+
+function standardHeaders(method: string, params: Json): Record<string, string> {
+  const h: Record<string, string> = {
+    "Content-Type": "application/json",
+    Accept: "application/json, text/event-stream",
+    "MCP-Protocol-Version": VERSION,
+    "Mcp-Method": method,
+  };
+  if (method === "tools/call" || method === "prompts/get") h["Mcp-Name"] = params.name;
+  if (method === "resources/read") h["Mcp-Name"] = params.uri;
+  if (method === "tools/call" && params.name === "add_note" && typeof params.arguments?.notebook === "string") {
+    h["Mcp-Param-Notebook"] = params.arguments.notebook;
+  }
+  return h;
+}
+
+async function post(url: string, method: string, params: Json, opts: RpcOptions = {}) {
+  const id = nextId++;
+  const fullParams = opts.rawParams ?? { ...params, _meta: meta(opts.caps, opts.metaExtra) };
+  const headers: Record<string, string> = { ...standardHeaders(method, params) };
+  for (const [k, v] of Object.entries(opts.headers ?? {})) {
+    const existing = Object.keys(headers).find((h) => h.toLowerCase() === k.toLowerCase());
+    if (existing) delete headers[existing];
+    if (v !== undefined) headers[k] = v;
+  }
+  const res = await httpFetch(url, {
+    method: "POST",
+    headers,
+    body: JSON.stringify({ jsonrpc: "2.0", id, method, params: fullParams }),
+    signal: opts.signal,
+  });
+  return { id, res };
+}
+
+/** Parses a complete SSE body into its JSON messages. */
+function parseSse(text: string): Json[] {
+  return text
+    .split(/\n\n/)
+    .map((block) =>
+      block
+        .split("\n")
+        .filter((l) => l.startsWith("data:"))
+        .map((l) => l.slice(5).trimStart())
+        .join("\n"),
+    )
+    .filter((d) => d !== "")
+    .map((d) => JSON.parse(d));
+}
+
+/** Sends a request and returns every message received (notifications + final response). */
+async function rpcAll(url: string, method: string, params: Json = {}, opts: RpcOptions = {}) {
+  const { id, res } = await post(url, method, params, opts);
+  const ct = res.headers.get("content-type") ?? "";
+  const text = await res.text();
+  const messages = ct.startsWith("text/event-stream") ? parseSse(text) : text ? [JSON.parse(text)] : [];
+  const response = messages.find((m) => m.id === id);
+  return { status: res.status, contentType: ct, messages, response: response as Json, id };
+}
+
+async function rpc(url: string, method: string, params: Json = {}, opts: RpcOptions = {}) {
+  const r = await rpcAll(url, method, params, opts);
+  return { status: r.status, body: r.response, contentType: r.contentType };
+}
+
+/** Incremental reader for a long-lived SSE stream. */
+class SseReader {
+  private buf = "";
+  private queue: Json[] = [];
+  private waiters: ((m: Json | null) => void)[] = [];
+  private ended = false;
+
+  constructor(body: ReadableStream<Uint8Array>) {
+    const reader = body.getReader();
+    const decoder = new TextDecoder();
+    (async () => {
+      try {
+        for (;;) {
+          const { value, done } = await reader.read();
+          if (done) break;
+          this.buf += decoder.decode(value, { stream: true });
+          let idx;
+          while ((idx = this.buf.indexOf("\n\n")) >= 0) {
+            const block = this.buf.slice(0, idx);
+            this.buf = this.buf.slice(idx + 2);
+            for (const m of parseSse(block + "\n\n")) this.push(m);
+          }
+        }
+      } catch {
+        // aborted
+      }
+      this.ended = true;
+      for (const w of this.waiters.splice(0)) w(null);
+    })();
+  }
+
+  private push(m: Json) {
+    const w = this.waiters.shift();
+    if (w) w(m);
+    else this.queue.push(m);
+  }
+
+  next(timeoutMs = 2000): Promise<Json | null> {
+    const m = this.queue.shift();
+    if (m) return Promise.resolve(m);
+    if (this.ended) return Promise.resolve(null);
+    return new Promise((resolve, reject) => {
+      const t = setTimeout(() => {
+        this.waiters.splice(this.waiters.indexOf(fn), 1);
+        reject(new Error("timed out waiting for SSE message"));
+      }, timeoutMs);
+      const fn = (v: Json | null) => {
+        clearTimeout(t);
+        resolve(v);
+      };
+      this.waiters.push(fn);
+    });
+  }
+
+  /** Resolves true if no message arrives within `ms`. */
+  async quiet(ms: number): Promise<boolean> {
+    if (this.queue.length > 0) return false;
+    try {
+      const m = await this.next(ms);
+      if (m) this.queue.unshift(m);
+      return m === null;
+    } catch {
+      return true;
+    }
+  }
+}
+
+async function listen(url: string, notifications: Json) {
+  const controller = new AbortController();
+  const { id, res } = await post(url, "subscriptions/listen", { notifications }, { signal: controller.signal });
+  assert.equal(res.status, 200);
+  assert.match(res.headers.get("content-type") ?? "", /^text\/event-stream/);
+  return { id, reader: new SseReader(res.body!), close: () => controller.abort() };
+}
