index 0000000..19d4251
--- /dev/null
+++ b/src/request-state.ts
@@ -0,0 +1,79 @@
+import { createHmac, randomBytes, timingSafeEqual } from "node:crypto";
+
+/**
+ * Integrity-protected, self-contained `requestState` tokens for the MRTR
+ * pattern. The server keeps nothing in memory between rounds: everything it
+ * needs is in the token, which is HMAC-signed with a per-process secret so the
+ * client cannot forge or modify it.
+ */
+export interface StatePayload {
+  /** Method and tool name the state was issued for. */
+  method: string;
+  tool: string;
+  /** Salient request parameters the state is bound to. */
+  bind: Record<string, string>;
+  /** Expiry, epoch milliseconds. */
+  exp: number;
+  /** Random nonce so identical requests get distinct tokens. */
+  nonce: string;
+}
+
+const STATE_TTL_MS = 10 * 60 * 1000;
+
+export class RequestStateCodec {
+  private readonly key: Buffer;
+
+  constructor(key: Buffer = randomBytes(32)) {
+    this.key = key;
+  }
+
+  private sign(data: string): Buffer {
+    return createHmac("sha256", this.key).update(data).digest();
+  }
+
+  issue(method: string, tool: string, bind: Record<string, string>): string {
+    const payload: StatePayload = {
+      method,
+      tool,
+      bind,
+      exp: Date.now() + STATE_TTL_MS,
+      nonce: randomBytes(12).toString("base64url"),
+    };
+    const data = Buffer.from(JSON.stringify(payload)).toString("base64url");
+    return `${data}.${this.sign(data).toString("base64url")}`;
+  }
+
+  /**
+   * Returns null unless the token is authentic, unexpired, and was issued for
+   * exactly this method, tool and bound parameters.
+   */
+  verify(
+    token: string,
+    method: string,
+    tool: string,
+    bind: Record<string, string>,
+  ): StatePayload | null {
+    const parts = token.split(".");
+    if (parts.length !== 2) return null;
+    const [data, sig] = parts as [string, string];
+    const expected = this.sign(data);
+    const given = Buffer.from(sig, "base64url");
+    if (given.length !== expected.length || !timingSafeEqual(given, expected)) {
+      return null;
+    }
+    let payload: StatePayload;
+    try {
+      payload = JSON.parse(Buffer.from(data, "base64url").toString("utf8"));
+    } catch {
+      return null;
+    }
+    if (payload.method !== method || payload.tool !== tool) return null;
+    if (typeof payload.exp !== "number" || payload.exp < Date.now()) return null;
+    const boundKeys = Object.keys(payload.bind ?? {});
+    if (boundKeys.length !== Object.keys(bind).length) return null;
+    for (const k of boundKeys) {
+      if (payload.bind[k] !== bind[k]) return null;
+    }
+    return payload;
+  }
+}
