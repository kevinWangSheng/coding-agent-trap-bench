+package storage
+
+import (
+	"testing"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+)
+
+func TestCostTxnIncludesNestedTransactions(t *testing.T) {
+	put := func(key, value string) *pb.RequestOp {
+		return &pb.RequestOp{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{
+			Key: []byte(key), Value: []byte(value),
+		}}}
+	}
+	txn := func(success, failure []*pb.RequestOp) *pb.RequestOp {
+		return &pb.RequestOp{Request: &pb.RequestOp_RequestTxn{RequestTxn: &pb.TxnRequest{
+			Success: success, Failure: failure,
+		}}}
+	}
+
+	innerCost := costPut(&pb.PutRequest{Key: []byte("inner"), Value: []byte("value")})
+	tests := []struct {
+		name string
+		rt   *pb.TxnRequest
+		want int
+	}{
+		{
+			name: "nested success branch",
+			rt:   &pb.TxnRequest{Success: []*pb.RequestOp{txn([]*pb.RequestOp{put("inner", "value")}, nil)}},
+			want: innerCost,
+		},
+		{
+			name: "nested failure branch",
+			rt:   &pb.TxnRequest{Failure: []*pb.RequestOp{txn(nil, []*pb.RequestOp{put("inner", "value")})}},
+			want: innerCost,
+		},
+		{
+			name: "nested branch uses larger branch cost",
+			rt: &pb.TxnRequest{Success: []*pb.RequestOp{txn(
+				[]*pb.RequestOp{put("small", "v")}, nil,
+			)}, Failure: []*pb.RequestOp{txn(
+				nil, []*pb.RequestOp{put("large", "value"), put("another", "value")},
+			)}},
+			want: costPut(&pb.PutRequest{Key: []byte("large"), Value: []byte("value")}) +
+				costPut(&pb.PutRequest{Key: []byte("another"), Value: []byte("value")}),
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := costTxn(tt.rt); got != tt.want {
+				t.Fatalf("costTxn() = %d, want %d", got, tt.want)
+			}
+		})
+	}
+}
