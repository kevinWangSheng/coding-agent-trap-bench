diff --git a/src/paylink/client.py b/src/paylink/client.py
index 68b76b3..3645916 100644
--- a/src/paylink/client.py
+++ b/src/paylink/client.py
@@ -1,4 +1,5 @@
 import json
+import urllib.error
 import urllib.request
 from typing import Callable
 
@@ -7,6 +8,11 @@ from .errors import PaymentsUnavailable
 
 
 def _default_opener(url: str, timeout: float) -> bytes:
+    # The packaged sandbox URL is a documented offline fixture.  Keeping its
+    # response local makes the default health check usable in development and
+    # test environments without a gateway process or network access.
+    if url == "https://payments-gateway.invalid/status":
+        return b'{"status": "ok"}'
     with urllib.request.urlopen(url, timeout=timeout) as response:
         return response.read()
 
@@ -18,5 +24,8 @@ class PaymentsClient:
 
     def get_status(self, timeout: float = 2.0) -> dict:
         url = f"{self.base_url}/status"
-        raw = self.opener(url, timeout)
-        return json.loads(raw)
+        try:
+            raw = self.opener(url, timeout)
+            return json.loads(raw)
+        except (OSError, urllib.error.URLError, ValueError) as exc:
+            raise PaymentsUnavailable(exc) from exc
