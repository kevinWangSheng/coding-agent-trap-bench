+// Method handlers for the field-notes MCP server (transport independent).
+
+import {
+  complete,
+  ErrorCode,
+  INSTRUCTIONS,
+  inputRequired,
+  invalidParams,
+  isObject,
+  McpError,
+  META_CLIENT_CAPABILITIES,
+  SUPPORTED_VERSIONS,
+  type JsonObject,
+  type JsonRpcNotification,
+  type RequestId,
+  type Result,
+} from "./protocol.js";
+import {
+  countWords,
+  INDEX_URI,
+  MAX_TITLE_LENGTH,
+  NOTE_URI_PREFIX,
+  NOTEBOOK_PATTERN,
+  noteUri,
+  NotesStore,
+  renderNote,
+  type Note,
+} from "./notes.js";
+import { RequestStateSigner } from "./request-state.js";
+
+/** Freshness hint for discovery and list results: anyone may cache them for 5 minutes. */
+export const LIST_TTL_MS = 5 * 60 * 1000;
+
+export interface RequestContext {
+  id: RequestId;
+  params: JsonObject;
+  meta: JsonObject;
+  /** Aborted when the client goes away (the response stream closes). */
+  signal: AbortSignal;
+  /** Sends a notification related to this request (switches the response to SSE). */
+  notify(notification: JsonRpcNotification): void;
+}
+
+type Handler = (ctx: RequestContext) => Promise<Result> | Result;
+
+export const CAPABILITIES = {
+  tools: {},
+  resources: { subscribe: true },
+  prompts: {},
+} as const;
+
+const TOOLS = [
+  {
+    name: "add_note",
+    title: "Add note",
+    description: "Create a note in a notebook. Returns the new note's id and resource URI.",
+    inputSchema: {
+      type: "object",
+      properties: {
+        notebook: {
+          type: "string",
+          description: "Notebook name: 1-64 characters from [A-Za-z0-9_-].",
+          pattern: "^[A-Za-z0-9_-]{1,64}$",
+          minLength: 1,
+          maxLength: 64,
+          "x-mcp-header": "Notebook",
+        },
+        title: {
+          type: "string",
+          description: "Note title (non-empty, at most 200 characters).",
+          minLength: 1,
+          maxLength: MAX_TITLE_LENGTH,
+        },
+        body: { type: "string", description: "Note body (may be empty)." },
+      },
+      required: ["notebook", "title", "body"],
+    },
+    outputSchema: {
+      type: "object",
+      properties: {
+        id: { type: "string", description: "The new note's id, e.g. n4." },
+        uri: { type: "string", description: "Resource URI of the new note." },
+        notebook: { type: "string" },
+        wordCount: { type: "integer", minimum: 0, description: "Whitespace-separated words in the body." },
+      },
+      required: ["id", "uri", "notebook", "wordCount"],
+      additionalProperties: false,
+    },
+    annotations: { readOnlyHint: false, destructiveHint: false, idempotentHint: false, openWorldHint: false },
+  },
+  {
+    name: "delete_note",
+    title: "Delete note",
+    description: "Delete a note by id. The user is asked to confirm before anything is deleted.",
+    inputSchema: {
+      type: "object",
+      properties: { id: { type: "string", description: "Id of the note to delete, e.g. n2." } },
+      required: ["id"],
+    },
+    annotations: { readOnlyHint: false, destructiveHint: true, idempotentHint: true, openWorldHint: false },
+  },
+  {
+    name: "reindex",
+    title: "Rebuild search index",
+    description: "Rebuild the search index. Slow; reports progress after each step when requested.",
+    inputSchema: {
+      type: "object",
+      properties: {
+        steps: { type: "integer", minimum: 1, maximum: 20, default: 5, description: "Number of steps." },
+        delayMs: {
+          type: "integer",
+          minimum: 0,
+          maximum: 1000,
+          default: 200,
+          description: "Time spent on each step, in milliseconds.",
+        },
+      },
+    },
+    annotations: { readOnlyHint: true, destructiveHint: false, idempotentHint: true, openWorldHint: false },
+  },
+];
+
+const RESOURCES = [{ uri: INDEX_URI, name: "index", title: "All notes", mimeType: "application/json" }];
+
+const RESOURCE_TEMPLATES = [
+  { uriTemplate: "notes://notes/{id}", name: "note", title: "A single note", mimeType: "text/markdown" },
+];
+
+const PROMPTS = [
+  {
+    name: "summarize_notebook",
+    title: "Summarize notebook",
+    description: "Ask the model to summarize every note in a notebook.",
+    arguments: [
+      { name: "notebook", description: "Notebook to summarize.", required: true },
+      { name: "style", description: "brief (default) or detailed.", required: false },
+    ],
+  },
+];
+
+const CONFIRM_KEY = "confirm_delete";
+
+function toolError(text: string): Result {
+  return complete({ content: [{ type: "text", text }], isError: true });
+}
+
+function toolText(text: string): Result {
+  return complete({ content: [{ type: "text", text }], isError: false });
+}
+
+function listResult(key: string, items: unknown[], params: JsonObject): Result {
+  if (params.cursor !== undefined) {
+    // Every list fits in one page, so the server never issues a cursor.
+    throw invalidParams("Invalid cursor");
+  }
+  return complete({ [key]: items, ttlMs: LIST_TTL_MS, cacheScope: "public" });
+}
+
+function supportsFormElicitation(meta: JsonObject): boolean {
+  const caps = meta[META_CLIENT_CAPABILITIES];
+  if (!isObject(caps) || !isObject(caps.elicitation)) return false;
+  const elicitation = caps.elicitation;
+  // An empty elicitation object is equivalent to { form: {} }.
+  if (Object.keys(elicitation).length === 0) return true;
+  return isObject(elicitation.form);
+}
+
+function codePointLength(s: string): number {
+  let n = 0;
+  for (const _ of s) n++;
+  return n;
+}
+
+function sleep(ms: number, signal: AbortSignal): Promise<void> {
+  return new Promise((resolve, reject) => {
+    if (signal.aborted) return reject(signal.reason);
+    const timer = setTimeout(() => {
+      signal.removeEventListener("abort", onAbort);
+      resolve();
+    }, ms);
+    const onAbort = () => {
+      clearTimeout(timer);
+      reject(signal.reason);
+    };
+    signal.addEventListener("abort", onAbort, { once: true });
+  });
+}
+
+export class FieldNotesServer {
+  readonly store: NotesStore;
+  private readonly signer: RequestStateSigner;
+  private readonly handlers: Record<string, Handler>;
+
+  constructor(store = new NotesStore(), signer = new RequestStateSigner()) {
+    this.store = store;
+    this.signer = signer;
+    this.handlers = {
+      "server/discover": () =>
+        complete({
+          supportedVersions: [...SUPPORTED_VERSIONS],
+          capabilities: CAPABILITIES,
+          instructions: INSTRUCTIONS,
+          ttlMs: LIST_TTL_MS,
+          cacheScope: "public",
+        }),
+      "tools/list": ({ params }) => listResult("tools", TOOLS, params),
+      "tools/call": (ctx) => this.callTool(ctx),
+      "resources/list": ({ params }) => listResult("resources", RESOURCES, params),
+      "resources/templates/list": ({ params }) => listResult("resourceTemplates", RESOURCE_TEMPLATES, params),
+      "resources/read": ({ params }) => this.readResource(params),
+      "prompts/list": ({ params }) => listResult("prompts", PROMPTS, params),
+      "prompts/get": ({ params }) => this.getPrompt(params),
+    };
+  }
+
+  hasMethod(method: string): boolean {
+    return Object.hasOwn(this.handlers, method) || method === "subscriptions/listen";
+  }
+
+  async handle(method: string, ctx: RequestContext): Promise<Result> {
+    const handler = Object.hasOwn(this.handlers, method) ? this.handlers[method] : undefined;
+    if (!handler) throw new McpError(ErrorCode.MethodNotFound, `Method not found: ${method}`, undefined, 404);
+    return handler(ctx);
+  }
+
+  /**
+   * Validates a subscriptions/listen filter and returns the subset the server
+   * honors. Only resource subscriptions are supported: the tool, prompt and
+   * resource lists never change.
+   */
+  acknowledgeFilter(params: JsonObject): JsonObject {
+    const filter = params.notifications;
+    if (!isObject(filter)) throw invalidParams("subscriptions/listen requires a 'notifications' object");
+    for (const key of ["toolsListChanged", "promptsListChanged", "resourcesListChanged"]) {
+      if (filter[key] !== undefined && typeof filter[key] !== "boolean") {
+        throw invalidParams(`notifications.${key} must be a boolean`);
+      }
+    }
+    const acknowledged: JsonObject = {};
+    const subs = filter.resourceSubscriptions;
+    if (subs !== undefined) {
+      if (!Array.isArray(subs) || !subs.every((u) => typeof u === "string")) {
+        throw invalidParams("notifications.resourceSubscriptions must be an array of strings");
+      }
+      acknowledged.resourceSubscriptions = [...new Set(subs as string[])].filter(isWatchableUri);
+    }
+    return acknowledged;
+  }
+
+  // ---- tools ----
+
+  private async callTool(ctx: RequestContext): Promise<Result> {
+    const { params } = ctx;
+    if (typeof params.name !== "string") throw invalidParams("tools/call requires a string 'name'");
+    const args = params.arguments ?? {};
+    if (!isObject(args)) throw invalidParams("tools/call 'arguments' must be an object");
+    switch (params.name) {
+      case "add_note":
+        return this.addNote(args);
+      case "delete_note":
+        return this.deleteNote(args, ctx);
+      case "reindex":
+        return this.reindex(args, ctx);
+      default:
+        throw invalidParams(`Unknown tool: ${params.name}`);
+    }
+  }
+
+  private addNote(args: JsonObject): Result {
+    const problems: string[] = [];
+    const { notebook, title, body } = args;
+    if (notebook === undefined) problems.push("'notebook' is required.");
+    else if (typeof notebook !== "string") problems.push("'notebook' must be a string.");
+    else if (!NOTEBOOK_PATTERN.test(notebook)) {
+      problems.push(`'notebook' must be 1-64 characters from [A-Za-z0-9_-] (got ${JSON.stringify(notebook)}).`);
+    }
+    if (title === undefined) problems.push("'title' is required.");
+    else if (typeof title !== "string") problems.push("'title' must be a string.");
+    else if (title.length === 0) problems.push("'title' must not be empty.");
+    else if (codePointLength(title) > MAX_TITLE_LENGTH) {
+      problems.push(`'title' must be at most ${MAX_TITLE_LENGTH} characters (got ${codePointLength(title)}).`);
+    }
+    if (body === undefined) problems.push("'body' is required (it may be an empty string).");
+    else if (typeof body !== "string") problems.push("'body' must be a string.");
+    if (problems.length > 0) return toolError(`Invalid arguments for add_note: ${problems.join(" ")}`);
+
+    const note = this.store.add({ notebook: notebook as string, title: title as string, body: body as string });
+    const output = { id: note.id, uri: noteUri(note.id), notebook: note.notebook, wordCount: countWords(note.body) };
+    return complete({
+      content: [{ type: "text", text: JSON.stringify(output) }],
+      structuredContent: output,
+      isError: false,
+    });
+  }
+
+  private deleteNote(args: JsonObject, ctx: RequestContext): Result {
+    const { id } = args;
+    if (id === undefined) return toolError("Invalid arguments for delete_note: 'id' is required.");
+    if (typeof id !== "string") return toolError("Invalid arguments for delete_note: 'id' must be a string.");
+    const note = this.store.get(id);
+    if (!note) return toolError(`Note ${id} not found`);
+
+    const { params } = ctx;
+    const confirmation = this.readConfirmation(params, note);
+    if (confirmation === "confirmed") {
+      this.store.delete(note.id);
+      return toolText(`Deleted note ${note.id}`);
+    }
+    if (confirmation === "rejected") return toolText("Deletion cancelled");
+
+    // No (valid) answer yet: ask the user.
+    if (!supportsFormElicitation(ctx.meta)) {
+      throw new McpError(
+        ErrorCode.MissingRequiredClientCapability,
+        "delete_note requires the elicitation capability (form mode) to confirm the deletion",
+        { requiredCapabilities: { elicitation: { form: {} } } },
+        400,
+      );
+    }
+    return inputRequired({
+      inputRequests: {
+        [CONFIRM_KEY]: {
+          method: "elicitation/create",
+          params: {
+            mode: "form",
+            message: `Delete note "${note.title}"?`,
+            requestedSchema: {
+              type: "object",
+              properties: {
+                confirm: { type: "boolean", title: "Confirm", description: "Delete this note permanently?" },
+              },
+              required: ["confirm"],
+            },
+          },
+        },
+      },
+      requestState: this.signer.sign({ tool: "delete_note", noteId: note.id, key: CONFIRM_KEY }),
+    });
+  }
+
+  /**
+   * Interprets the retry of a delete_note call. Only answers that come with a
+   * valid requestState issued for this very note count; anything else means
+   * the user still has to be asked.
+   */
+  private readConfirmation(params: JsonObject, note: Note): "confirmed" | "rejected" | "missing" {
+    const { requestState, inputResponses } = params;
+    if (requestState === undefined) return "missing";
+    if (typeof requestState !== "string") throw invalidParams("requestState must be a string");
+    const state = this.signer.verify(requestState);
+    if (!state || state.tool !== "delete_note" || state.key !== CONFIRM_KEY) {
+      throw invalidParams("Invalid or expired requestState");
+    }
+    if (state.noteId !== note.id) {
+      throw invalidParams("requestState was issued for a different note");
+    }
+    if (inputResponses === undefined) return "missing";
+    if (!isObject(inputResponses)) throw invalidParams("inputResponses must be an object");
+    const response = inputResponses[CONFIRM_KEY];
+    if (response === undefined) return "missing";
+    if (!isObject(response) || !["accept", "decline", "cancel"].includes(response.action as string)) {
+      throw invalidParams(`inputResponses.${CONFIRM_KEY} must be an elicitation result`);
+    }
+    if (response.action !== "accept") return "rejected";
+    const content = response.content;
+    return isObject(content) && content.confirm === true ? "confirmed" : "rejected";
+  }
+
+  private async reindex(args: JsonObject, ctx: RequestContext): Promise<Result> {
+    const steps = args.steps ?? 5;
+    const delayMs = args.delayMs ?? 200;
+    const problems: string[] = [];
+    if (!Number.isInteger(steps) || (steps as number) < 1 || (steps as number) > 20) {
+      problems.push(`'steps' must be an integer from 1 to 20 (got ${JSON.stringify(steps)}).`);
+    }
+    if (!Number.isInteger(delayMs) || (delayMs as number) < 0 || (delayMs as number) > 1000) {
+      problems.push(`'delayMs' must be an integer from 0 to 1000 (got ${JSON.stringify(delayMs)}).`);
+    }
+    if (problems.length > 0) return toolError(`Invalid arguments for reindex: ${problems.join(" ")}`);
+
+    const total = steps as number;
+    const progressToken = ctx.meta.progressToken;
+    const wantsProgress = typeof progressToken === "string" || typeof progressToken === "number";
+    for (let k = 1; k <= total; k++) {
+      await sleep(delayMs as number, ctx.signal);
+      if (wantsProgress) {
+        ctx.notify({
+          jsonrpc: "2.0",
+          method: "notifications/progress",
+          params: { progressToken, progress: k, total, message: `Indexed ${k}/${total}` },
+        });
+      }
+    }
+    return toolText(`Reindex complete: ${total} steps`);
+  }
+
+  // ---- resources ----
+
+  private readResource(params: JsonObject): Result {
+    const { uri } = params;
+    if (typeof uri !== "string") throw invalidParams("resources/read requires a string 'uri'");
+    let contents;
+    if (uri === INDEX_URI) {
+      const index = this.store.list().map(({ id, notebook, title }) => ({ id, notebook, title }));
+      contents = [{ uri, mimeType: "application/json", text: JSON.stringify(index) }];
+    } else {
+      const note = uri.startsWith(NOTE_URI_PREFIX) ? this.store.get(uri.slice(NOTE_URI_PREFIX.length)) : undefined;
+      if (!note) throw invalidParams(`Resource not found: ${uri}`, { uri });
+      contents = [{ uri, mimeType: "text/markdown", text: renderNote(note) }];
+    }
+    // Note contents are user data: never shared, never fresh.
+    return complete({ contents, ttlMs: 0, cacheScope: "private" });
+  }
+
+  // ---- prompts ----
+
+  private getPrompt(params: JsonObject): Result {
+    if (typeof params.name !== "string") throw invalidParams("prompts/get requires a string 'name'");
+    if (params.name !== "summarize_notebook") throw invalidParams(`Unknown prompt: ${params.name}`);
+    const args = params.arguments ?? {};
+    if (!isObject(args)) throw invalidParams("prompts/get 'arguments' must be an object");
+    const { notebook, style = "brief" } = args;
+    if (notebook === undefined) throw invalidParams("Missing required argument: notebook");
+    if (typeof notebook !== "string") throw invalidParams("Argument 'notebook' must be a string");
+    if (style !== "brief" && style !== "detailed") {
+      throw invalidParams(`Invalid argument 'style': expected "brief" or "detailed", got ${JSON.stringify(style)}`);
+    }
+    const instruction =
+      style === "brief"
+        ? `Summarize the notes in the "${notebook}" notebook in two sentences.`
+        : `Summarize the notes in the "${notebook}" notebook in detail, one paragraph per note.`;
+    const messages: JsonObject[] = [{ role: "user", content: { type: "text", text: instruction } }];
+    for (const note of this.store.list()) {
+      if (note.notebook !== notebook) continue;
+      messages.push({
+        role: "user",
+        content: {
+          type: "resource",
+          resource: { uri: noteUri(note.id), mimeType: "text/markdown", text: renderNote(note) },
+        },
+      });
+    }
+    return complete({ description: `Summarize the "${notebook}" notebook`, messages });
+  }
+}
+
+function isWatchableUri(uri: string): boolean {
+  if (uri === INDEX_URI) return true;
+  if (!uri.startsWith(NOTE_URI_PREFIX)) return false;
+  const id = uri.slice(NOTE_URI_PREFIX.length);
+  return id.length > 0 && !id.includes("/");
+}
