+describe("subscriptions/listen", () => {
+  test("acknowledges, then notifies only watchers of changed URIs", async () => {
+    const all = await listen(server, { resourceSubscriptions: ["notes://index", "notes://notes/n2", "https://elsewhere"], toolsListChanged: true }, "sub-all");
+    assert.equal(all.res.statusCode, 200);
+    assert.match(all.res.headers["content-type"]!, /^text\/event-stream/);
+    const ack = await all.reader.next();
+    assert.equal(ack.method, "notifications/subscriptions/acknowledged");
+    assert.equal(ack.params._meta["io.modelcontextprotocol/subscriptionId"], "sub-all");
+    assert.deepEqual(ack.params.notifications, { resourceSubscriptions: ["notes://index", "notes://notes/n2"] });
+
+    const other = await listen(server, { resourceSubscriptions: ["notes://notes/n1"] }, 42);
+    const ack2 = await other.reader.next();
+    assert.equal(ack2.params._meta["io.modelcontextprotocol/subscriptionId"], 42);
+
+    // Adding a note updates the index only.
+    await call(server, "tools/call", { name: "add_note", arguments: { notebook: "work", title: "New", body: "" } });
+    const added = await all.reader.next();
+    assert.equal(added.method, "notifications/resources/updated");
+    assert.equal(added.params.uri, "notes://index");
+    assert.equal(added.params._meta["io.modelcontextprotocol/subscriptionId"], "sub-all");
+    assert.ok(await other.reader.quiet(300), "watcher of n1 must not hear about the index");
+
+    // Deleting n2 updates the index and n2.
+    const ask = await call(server, "tools/call", { name: "delete_note", arguments: { id: "n2" } }, { capabilities: FORM });
+    const key = Object.keys(ask.body.result.inputRequests)[0]!;
+    const done = await call(
+      server,
+      "tools/call",
+      {
+        name: "delete_note",
+        arguments: { id: "n2" },
+        inputResponses: { [key]: { action: "accept", content: { confirm: true } } },
+        requestState: ask.body.result.requestState,
+      },
+      { capabilities: FORM },
+    );
+    assert.equal(text(done.body.result), "Deleted note n2");
+    const uris = [(await all.reader.next()).params.uri, (await all.reader.next()).params.uri].sort();
+    assert.deepEqual(uris, ["notes://index", "notes://notes/n2"]);
+    assert.ok(await other.reader.quiet(300));
+
+    all.reader.close();
+    other.reader.close();
+  });
+
+  test("a malformed filter is invalid params", async () => {
+    const { res } = await listen(server, { resourceSubscriptions: "notes://index" } as any, 5);
+    const { body } = await readResponse(res);
+    assert.equal(body.error.code, -32602);
+  });
+
+  test("server shutdown ends subscriptions gracefully", async () => {
+    const own = await startServer();
+    const sub = await listen(own, { resourceSubscriptions: ["notes://index"] }, "bye");
+    await sub.reader.next();
+    own.terminate();
+    const final = await sub.reader.next();
+    assert.equal(final.id, "bye");
+    assert.equal(final.result.resultType, "complete");
+    assert.equal(final.result._meta["io.modelcontextprotocol/subscriptionId"], "bye");
+    assert.equal(await sub.reader.next(), undefined);
+    await own.stop();
+  });
+});
