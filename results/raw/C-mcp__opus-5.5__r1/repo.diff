+// Streamable HTTP transport (MCP revision 2026-07-28): one POST per message,
+// responses as JSON or as an SSE stream scoped to the request.
+
+import { createServer, type IncomingMessage, type Server, type ServerResponse } from "node:http";
+import type { AddressInfo } from "node:net";
+import { FieldNotesServer, type RequestContext } from "./mcp.js";
+import {
+  ErrorCode,
+  headerMismatch,
+  invalidParams,
+  isObject,
+  McpError,
+  META_CLIENT_CAPABILITIES,
+  META_PROTOCOL_VERSION,
+  META_SUBSCRIPTION_ID,
+  serverMeta,
+  SUPPORTED_VERSIONS,
+  unsupportedVersion,
+  type JsonObject,
+  type JsonRpcNotification,
+  type JsonRpcRequest,
+  type RequestId,
+} from "./protocol.js";
+
+export const MCP_PATH = "/mcp";
+const MAX_BODY_BYTES = 1024 * 1024;
+const KEEPALIVE_MS = 15_000;
+
+/** Methods whose `Mcp-Name` header mirrors a body field. */
+const NAME_FIELDS: Record<string, "name" | "uri"> = {
+  "tools/call": "name",
+  "prompts/get": "name",
+  "resources/read": "uri",
+};
+
+/** Tool parameters mirrored into `Mcp-Param-*` headers (from `x-mcp-header` in the tool schemas). */
+const PARAM_HEADERS: Record<string, Array<{ header: string; argument: string }>> = {
+  add_note: [{ header: "Notebook", argument: "notebook" }],
+};
+
+const CACHEABLE_PUBLIC = new Set([
+  "server/discover",
+  "tools/list",
+  "resources/list",
+  "resources/templates/list",
+  "prompts/list",
+]);
+
+interface Subscriber {
+  id: RequestId;
+  uris: Set<string>;
+  channel: ResponseChannel;
+  stop(): void;
+}
+
+export interface McpHttpServer {
+  server: Server;
+  app: FieldNotesServer;
+  /** Ends every subscription gracefully and stops the HTTP server. */
+  shutdown(): Promise<void>;
+}
+
+/**
+ * Writes the response for one request: either a single JSON body, or (once a
+ * notification is sent) an SSE stream that ends with the final response.
+ */
+class ResponseChannel {
+  private readonly res: ServerResponse;
+  private sse = false;
+  private readonly controller = new AbortController();
+
+  constructor(res: ServerResponse) {
+    this.res = res;
+    // Closing the response stream before we finish it is the cancellation signal.
+    res.on("close", () => {
+      if (!res.writableEnded) this.controller.abort(new Error("client disconnected"));
+    });
+  }
+
+  get signal(): AbortSignal {
+    return this.controller.signal;
+  }
+
+  get open(): boolean {
+    return !this.controller.signal.aborted && !this.res.writableEnded;
+  }
+
+  startSse(): void {
+    if (this.sse || !this.open) return;
+    this.sse = true;
+    this.res.writeHead(200, {
+      "Content-Type": "text/event-stream",
+      "Cache-Control": "no-store",
+      "X-Accel-Buffering": "no",
+      Connection: "keep-alive",
+    });
+    this.res.flushHeaders();
+  }
+
+  send(message: JsonObject): void {
+    if (!this.open) return;
+    this.startSse();
+    this.res.write(`event: message\ndata: ${JSON.stringify(message)}\n\n`);
+  }
+
+  comment(): void {
+    if (this.open && this.sse) this.res.write(":\n\n");
+  }
+
+  finish(message: JsonObject, status = 200, cacheControl = "no-store"): void {
+    if (!this.open) return;
+    if (this.sse) {
+      this.res.end(`event: message\ndata: ${JSON.stringify(message)}\n\n`);
+      return;
+    }
+    const body = JSON.stringify(message);
+    this.res.writeHead(status, {
+      "Content-Type": "application/json",
+      "Content-Length": Buffer.byteLength(body),
+      "Cache-Control": cacheControl,
+    });
+    this.res.end(body);
+  }
+}
+
+function errorResponse(id: RequestId | undefined, error: McpError): JsonObject {
+  const response: JsonObject = { jsonrpc: "2.0", error: error.toJson() };
+  if (id !== undefined) response.id = id;
+  return response;
+}
+
+function sendError(res: ServerResponse, status: number, error: McpError, id?: RequestId, headers: JsonObject = {}): void {
+  const body = JSON.stringify(errorResponse(id, error));
+  res.writeHead(status, {
+    ...headers,
+    "Content-Type": "application/json",
+    "Content-Length": Buffer.byteLength(body),
+    "Cache-Control": "no-store",
+  } as Record<string, string | number>);
+  res.end(body);
+}
+
+function readBody(req: IncomingMessage): Promise<Buffer | undefined> {
+  return new Promise((resolve, reject) => {
+    const chunks: Buffer[] = [];
+    let size = 0;
+    req.on("data", (chunk: Buffer) => {
+      size += chunk.length;
+      if (size > MAX_BODY_BYTES) {
+        resolve(undefined);
+        req.destroy();
+        return;
+      }
+      chunks.push(chunk);
+    });
+    req.on("end", () => resolve(Buffer.concat(chunks)));
+    req.on("error", reject);
+  });
+}
+
+function singleHeader(req: IncomingMessage, name: string): string | undefined {
+  const value = req.headers[name.toLowerCase()];
+  return Array.isArray(value) ? value.join(", ") : value;
+}
+
+/**
+ * Decodes a header value that may use the `=?base64?...?=` sentinel encoding.
+ * Returns undefined when the value contains characters not allowed in a header
+ * or is not valid Base64 / UTF-8.
+ */
+export function decodeHeaderValue(raw: string): string | undefined {
+  for (let i = 0; i < raw.length; i++) {
+    const c = raw.charCodeAt(i);
+    if (!(c === 0x09 || (c >= 0x20 && c <= 0x7e))) return undefined;
+  }
+  if (raw.startsWith("=?base64?") && raw.endsWith("?=") && raw.length >= 11) {
+    const encoded = raw.slice("=?base64?".length, -2);
+    if (encoded.length % 4 !== 0 || !/^[A-Za-z0-9+/]*={0,2}$/.test(encoded)) return undefined;
+    try {
+      return new TextDecoder("utf-8", { fatal: true }).decode(Buffer.from(encoded, "base64"));
+    } catch {
+      return undefined;
+    }
+  }
+  return raw;
+}
+
+/** String form of a primitive argument, as a client would mirror it into a header. */
+function headerForm(value: unknown): string | undefined {
+  if (typeof value === "string") return value;
+  if (typeof value === "boolean") return value ? "true" : "false";
+  if (typeof value === "number" && Number.isFinite(value)) return String(value);
+  return undefined;
+}
+
+function validateHeaders(req: IncomingMessage, request: JsonRpcRequest): void {
+  const { method, params } = request;
+
+  const version = singleHeader(req, "mcp-protocol-version");
+  if (version === undefined) throw headerMismatch("missing required MCP-Protocol-Version header");
+  const methodHeader = singleHeader(req, "mcp-method");
+  if (methodHeader === undefined) throw headerMismatch("missing required Mcp-Method header");
+  if (methodHeader !== method) {
+    throw headerMismatch(`Mcp-Method header value '${methodHeader}' does not match body value '${method}'`);
+  }
+
+  // Per-request protocol fields.
+  const meta = params._meta;
+  if (!isObject(meta)) throw invalidParams("Missing required params._meta", undefined, 400);
+  const bodyVersion = meta[META_PROTOCOL_VERSION];
+  if (typeof bodyVersion !== "string") {
+    throw invalidParams(`Missing required _meta field ${META_PROTOCOL_VERSION}`, undefined, 400);
+  }
+  if (!isObject(meta[META_CLIENT_CAPABILITIES])) {
+    throw invalidParams(`Missing required _meta field ${META_CLIENT_CAPABILITIES}`, undefined, 400);
+  }
+  if (version !== bodyVersion) {
+    throw headerMismatch(`MCP-Protocol-Version header value '${version}' does not match body value '${bodyVersion}'`);
+  }
+  if (!SUPPORTED_VERSIONS.includes(bodyVersion)) throw unsupportedVersion(bodyVersion);
+
+  const nameField = NAME_FIELDS[method];
+  if (nameField) {
+    const raw = singleHeader(req, "mcp-name");
+    if (raw === undefined) throw headerMismatch(`missing required Mcp-Name header for ${method}`);
+    const decoded = decodeHeaderValue(raw);
+    if (decoded === undefined) throw headerMismatch("Mcp-Name header contains invalid characters or encoding");
+    const bodyValue = params[nameField];
+    if (decoded !== bodyValue) {
+      throw headerMismatch(
+        `Mcp-Name header value '${decoded}' does not match body value '${String(bodyValue)}' (params.${nameField})`,
+      );
+    }
+  }
+
+  if (method === "tools/call" && typeof params.name === "string") {
+    const mirrored = Object.hasOwn(PARAM_HEADERS, params.name) ? PARAM_HEADERS[params.name] : undefined;
+    const args = isObject(params.arguments) ? params.arguments : {};
+    for (const { header, argument } of mirrored ?? []) {
+      const headerName = `Mcp-Param-${header}`;
+      const raw = singleHeader(req, headerName);
+      const value = args[argument];
+      if (raw === undefined) {
+        if (value !== undefined && value !== null && headerForm(value) !== undefined) {
+          throw headerMismatch(`missing required ${headerName} header for argument '${argument}'`);
+        }
+        continue;
+      }
+      const decoded = decodeHeaderValue(raw);
+      if (decoded === undefined) throw headerMismatch(`${headerName} header contains invalid characters or encoding`);
+      const expected = headerForm(value);
+      if (expected === undefined || decoded !== expected) {
+        throw headerMismatch(
+          `${headerName} header value '${decoded}' does not match body value ${JSON.stringify(value ?? null)}`,
+        );
+      }
+    }
+  }
+}
+
+function acceptsJsonOrSse(req: IncomingMessage): boolean {
+  const accept = singleHeader(req, "accept");
+  if (accept === undefined) return true;
+  return /application\/json|text\/event-stream|\*\/\*|application\/\*|text\/\*/i.test(accept);
+}
+
+export interface McpHttpServerOptions {
+  /**
+   * Port used to build the allowed browser origins. Defaults to the port the
+   * server is actually listening on.
+   */
+  originPort?: number;
+}
+
+export function createMcpHttpServer(app = new FieldNotesServer(), options: McpHttpServerOptions = {}): McpHttpServer {
+  const subscribers = new Set<Subscriber>();
+
+  app.store.on("updated", (uri) => {
+    for (const sub of subscribers) {
+      if (!sub.uris.has(uri)) continue;
+      sub.channel.send({
+        jsonrpc: "2.0",
+        method: "notifications/resources/updated",
+        params: { _meta: { [META_SUBSCRIPTION_ID]: sub.id }, uri },
+      });
+    }
+  });
+
+  const server = createServer((req, res) => {
+    handle(req, res).catch((err) => {
+      console.error("Unhandled error:", err);
+      if (!res.headersSent) {
+        sendError(res, 500, new McpError(ErrorCode.InternalError, "Internal error"));
+      } else {
+        res.destroy();
+      }
+    });
+  });
+
+  function allowedOrigins(): Set<string> {
+    const port = options.originPort ?? (server.address() as AddressInfo | null)?.port;
+    return new Set([`http://localhost:${port}`, `http://127.0.0.1:${port}`]);
+  }
+
+  async function handle(req: IncomingMessage, res: ServerResponse): Promise<void> {
+    // DNS-rebinding protection: browser requests only from our own origin.
+    const origin = req.headers.origin;
+    if (origin !== undefined && !allowedOrigins().has(origin)) {
+      sendError(res, 403, new McpError(ErrorCode.InvalidRequest, `Forbidden: origin '${origin}' is not allowed`));
+      return;
+    }
+
+    const path = new URL(req.url ?? "/", "http://localhost").pathname;
+    if (path !== MCP_PATH) {
+      sendError(res, 404, new McpError(ErrorCode.InvalidRequest, `Not found: the MCP endpoint is ${MCP_PATH}`));
+      return;
+    }
+    if (req.method !== "POST") {
+      // No GET stream or DELETE session teardown in this protocol revision.
+      sendError(res, 405, new McpError(ErrorCode.InvalidRequest, "Method not allowed: use POST"), undefined, {
+        Allow: "POST",
+      });
+      return;
+    }
+    const contentType = singleHeader(req, "content-type") ?? "";
+    if (!/^application\/json\s*(;|$)/i.test(contentType)) {
+      sendError(res, 415, new McpError(ErrorCode.InvalidRequest, "Content-Type must be application/json"));
+      return;
+    }
+    if (!acceptsJsonOrSse(req)) {
+      sendError(res, 406, new McpError(ErrorCode.InvalidRequest, "Accept must include application/json and text/event-stream"));
+      return;
+    }
+
+    const raw = await readBody(req);
+    if (raw === undefined) {
+      sendError(res, 413, new McpError(ErrorCode.InvalidRequest, "Request body too large"));
+      return;
+    }
+    let message: unknown;
+    try {
+      message = JSON.parse(raw.toString("utf8"));
+    } catch {
+      sendError(res, 400, new McpError(ErrorCode.ParseError, "Parse error: body is not valid JSON"));
+      return;
+    }
+    if (!isObject(message)) {
+      const what = Array.isArray(message) ? "batches are not supported" : "expected a JSON-RPC object";
+      sendError(res, 400, new McpError(ErrorCode.InvalidRequest, `Invalid request: ${what}`));
+      return;
+    }
+    const id = message.id;
+    const validId = typeof id === "string" || (typeof id === "number" && Number.isInteger(id));
+    const replyId = validId ? (id as RequestId) : undefined;
+    if (message.jsonrpc !== "2.0") {
+      sendError(res, 400, new McpError(ErrorCode.InvalidRequest, "Invalid request: jsonrpc must be \"2.0\""), replyId);
+      return;
+    }
+    if (typeof message.method !== "string") {
+      const what = "result" in message || "error" in message ? "servers do not accept JSON-RPC responses" : "missing method";
+      sendError(res, 400, new McpError(ErrorCode.InvalidRequest, `Invalid request: ${what}`), replyId);
+      return;
+    }
+    if (message.params !== undefined && !isObject(message.params)) {
+      sendError(res, 400, new McpError(ErrorCode.InvalidRequest, "Invalid request: params must be an object"), replyId);
+      return;
+    }
+
+    if (!("id" in message)) {
+      // Notification (e.g. notifications/cancelled). Nothing to do over HTTP.
+      res.writeHead(202).end();
+      return;
+    }
+    if (!validId) {
+      sendError(res, 400, new McpError(ErrorCode.InvalidRequest, "Invalid request: id must be a string or integer"));
+      return;
+    }
+
+    const request: JsonRpcRequest = {
+      jsonrpc: "2.0",
+      id: id as RequestId,
+      method: message.method,
+      params: (message.params as JsonObject | undefined) ?? {},
+    };
+    await dispatch(req, res, request);
+  }
+
+  async function dispatch(req: IncomingMessage, res: ServerResponse, request: JsonRpcRequest): Promise<void> {
+    const { id, method, params } = request;
+    try {
+      if (method === "initialize") {
+        // Legacy handshake: name the versions we do support.
+        const requested = typeof params.protocolVersion === "string" ? params.protocolVersion : "unknown";
+        throw unsupportedVersion(requested);
+      }
+      validateHeaders(req, request);
+      if (!app.hasMethod(method)) {
+        throw new McpError(ErrorCode.MethodNotFound, `Method not found: ${method}`, undefined, 404);
+      }
+    } catch (err) {
+      if (!(err instanceof McpError)) throw err;
+      sendError(res, err.httpStatus, err, id);
+      return;
+    }
+
+    const channel = new ResponseChannel(res);
+    if (method === "subscriptions/listen") {
+      listen(request, channel);
+      return;
+    }
+
+    const ctx: RequestContext = {
+      id,
+      params,
+      meta: params._meta as JsonObject,
+      signal: channel.signal,
+      notify: (n: JsonRpcNotification) => channel.send(n as unknown as JsonObject),
+    };
+    try {
+      const result = await app.handle(method, ctx);
+      let cacheControl = "no-store";
+      if (result.resultType === "complete") {
+        if (CACHEABLE_PUBLIC.has(method)) cacheControl = `public, max-age=${Math.floor(Number(result.ttlMs) / 1000)}`;
+        else if (method === "resources/read") cacheControl = "private, no-cache";
+      }
+      channel.finish({ jsonrpc: "2.0", id, result }, 200, cacheControl);
+    } catch (err) {
+      if (channel.signal.aborted) return; // cancelled: send nothing further
+      const error =
+        err instanceof McpError ? err : (console.error(err), new McpError(ErrorCode.InternalError, "Internal error"));
+      channel.finish(errorResponse(id, error), error.httpStatus);
+    }
+  }
+
+  function listen(request: JsonRpcRequest, channel: ResponseChannel): void {
+    const { id, params } = request;
+    let acknowledged: JsonObject;
+    try {
+      acknowledged = app.acknowledgeFilter(params);
+    } catch (err) {
+      if (!(err instanceof McpError)) throw err;
+      channel.finish(errorResponse(id, err), err.httpStatus);
+      return;
+    }
+    const keepAlive = setInterval(() => channel.comment(), KEEPALIVE_MS);
+    const sub: Subscriber = {
+      id,
+      uris: new Set((acknowledged.resourceSubscriptions as string[] | undefined) ?? []),
+      channel,
+      stop: () => {
+        clearInterval(keepAlive);
+        subscribers.delete(sub);
+      },
+    };
+    channel.send({
+      jsonrpc: "2.0",
+      method: "notifications/subscriptions/acknowledged",
+      params: { _meta: { [META_SUBSCRIPTION_ID]: id }, notifications: acknowledged },
+    });
+    subscribers.add(sub);
+    channel.signal.addEventListener("abort", () => sub.stop());
+  }
+
+  async function shutdown(): Promise<void> {
+    for (const sub of [...subscribers]) {
+      sub.stop();
+      sub.channel.finish({
+        jsonrpc: "2.0",
+        id: sub.id,
+        result: { resultType: "complete", _meta: { ...serverMeta(), [META_SUBSCRIPTION_ID]: sub.id } },
+      });
+    }
+    await new Promise<void>((resolve) => {
+      server.close(() => resolve());
+      server.closeIdleConnections();
+      setTimeout(() => server.closeAllConnections(), 2000).unref();
+    });
+  }
+
+  return { server, app, shutdown };
+}
