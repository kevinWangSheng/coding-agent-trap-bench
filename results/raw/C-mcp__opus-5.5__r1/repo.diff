+describe("delete_note (multi round-trip confirmation)", () => {
+  async function newNote(title: string): Promise<string> {
+    const { body } = await call(server, "tools/call", { name: "add_note", arguments: { notebook: "tmp", title, body: "b" } });
+    return body.result.structuredContent.id;
+  }
+
+  async function exists(id: string): Promise<boolean> {
+    const { body } = await call(server, "resources/read", { uri: `notes://notes/${id}` });
+    return body.result !== undefined;
+  }
+
+  test("unknown note is a tool error", async () => {
+    const { body } = await call(server, "tools/call", { name: "delete_note", arguments: { id: "n9999" } }, { capabilities: FORM });
+    assert.equal(body.result.isError, true);
+    assert.equal(text(body.result), "Note n9999 not found");
+  });
+
+  test("clients without form elicitation get MissingRequiredClientCapability", async () => {
+    const id = await newNote("keep me");
+    for (const capabilities of [{}, { elicitation: { url: {} } }]) {
+      const { status, body } = await call(server, "tools/call", { name: "delete_note", arguments: { id } }, { capabilities });
+      assert.equal(status, 400);
+      assert.equal(body.error.code, -32021);
+      assert.ok(body.error.data.requiredCapabilities.elicitation);
+    }
+    assert.ok(await exists(id));
+  });
+
+  test("asks for confirmation, then deletes on confirm: true", async () => {
+    const id = await newNote("Doomed");
+    const first = await call(server, "tools/call", { name: "delete_note", arguments: { id } }, { capabilities: { elicitation: {} } });
+    const r = first.body.result;
+    assert.equal(r.resultType, "input_required");
+    assert.equal(typeof r.requestState, "string");
+    const [key, request] = Object.entries(r.inputRequests as Record<string, any>)[0]!;
+    assert.equal(request.method, "elicitation/create");
+    assert.equal(request.params.mode, "form");
+    assert.equal(request.params.message, 'Delete note "Doomed"?');
+    assert.deepEqual(request.params.requestedSchema.required, ["confirm"]);
+    assert.equal(request.params.requestedSchema.properties.confirm.type, "boolean");
+    assert.equal(r.ttlMs, undefined);
+    assert.ok(await exists(id));
+
+    const retry = await call(
+      server,
+      "tools/call",
+      {
+        name: "delete_note",
+        arguments: { id },
+        inputResponses: { [key]: { action: "accept", content: { confirm: true } } },
+        requestState: r.requestState,
+      },
+      { capabilities: FORM },
+    );
+    assert.equal(retry.body.result.resultType, "complete");
+    assert.equal(text(retry.body.result), `Deleted note ${id}`);
+    assert.equal(await exists(id), false);
+
+    // Replaying the same confirmation cannot delete anything else.
+    const replay = await call(
+      server,
+      "tools/call",
+      { name: "delete_note", arguments: { id }, inputResponses: { [key]: { action: "accept", content: { confirm: true } } }, requestState: r.requestState },
+      { capabilities: FORM },
+    );
+    assert.equal(text(replay.body.result), `Note ${id} not found`);
+  });
+
+  test("decline, cancel and confirm: false leave the note alone", async () => {
+    const id = await newNote("Survivor");
+    for (const answer of [{ action: "decline" }, { action: "cancel" }, { action: "accept", content: { confirm: false } }]) {
+      const first = await call(server, "tools/call", { name: "delete_note", arguments: { id } }, { capabilities: FORM });
+      const { inputRequests, requestState } = first.body.result;
+      const key = Object.keys(inputRequests)[0]!;
+      const retry = await call(
+        server,
+        "tools/call",
+        { name: "delete_note", arguments: { id }, inputResponses: { [key]: answer }, requestState },
+        { capabilities: FORM },
+      );
+      assert.notEqual(retry.body.result.isError, true);
+      assert.equal(text(retry.body.result), "Deletion cancelled", JSON.stringify(answer));
+    }
+    assert.ok(await exists(id));
+  });
+
+  test("confirmation for one note cannot delete another, nor be forged", async () => {
+    const a = await newNote("A");
+    const b = await newNote("B");
+    const first = await call(server, "tools/call", { name: "delete_note", arguments: { id: a } }, { capabilities: FORM });
+    const { inputRequests, requestState } = first.body.result;
+    const key = Object.keys(inputRequests)[0]!;
+    const yes = { [key]: { action: "accept", content: { confirm: true } } };
+
+    // Reusing A's confirmation for B.
+    let r = await call(server, "tools/call", { name: "delete_note", arguments: { id: b }, inputResponses: yes, requestState }, { capabilities: FORM });
+    assert.equal(r.body.error?.code, -32602);
+
+    // Tampered state.
+    const [payload, mac] = requestState.split(".");
+    const forged = Buffer.from(JSON.stringify({ ...JSON.parse(Buffer.from(payload, "base64url").toString()), noteId: b })).toString("base64url");
+    r = await call(server, "tools/call", { name: "delete_note", arguments: { id: b }, inputResponses: yes, requestState: `${forged}.${mac}` }, { capabilities: FORM });
+    assert.equal(r.body.error?.code, -32602);
+    r = await call(server, "tools/call", { name: "delete_note", arguments: { id: b }, inputResponses: yes, requestState: "garbage" }, { capabilities: FORM });
+    assert.equal(r.body.error?.code, -32602);
+
+    // Answers without any server-issued state just trigger a fresh confirmation.
+    r = await call(server, "tools/call", { name: "delete_note", arguments: { id: b }, inputResponses: yes }, { capabilities: FORM });
+    assert.equal(r.body.result.resultType, "input_required");
+
+    assert.ok(await exists(a));
+    assert.ok(await exists(b));
+  });
+
+  test("a retry without the answer asks again", async () => {
+    const id = await newNote("Again");
+    const first = await call(server, "tools/call", { name: "delete_note", arguments: { id } }, { capabilities: FORM });
+    const r = await call(
+      server,
+      "tools/call",
+      { name: "delete_note", arguments: { id }, inputResponses: {}, requestState: first.body.result.requestState },
+      { capabilities: FORM },
+    );
+    assert.equal(r.body.result.resultType, "input_required");
+    assert.ok(await exists(id));
+  });
+});
