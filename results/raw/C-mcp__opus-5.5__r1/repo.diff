+// Cancellation: when the client closes the response stream, the server stops
+// working on the request. Runs the built server in-process so the test can
+// observe the handler.
+
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { createMcpHttpServer } from "../dist/http.js";
+import { FieldNotesServer } from "../dist/mcp.js";
+import { post, requestMeta, SseReader, standardHeaders, startServer } from "./helpers.ts";
+
+test("closing the SSE stream stops a running reindex", async () => {
+  const app = new FieldNotesServer();
+  let progressCalls = 0;
+  let signal: AbortSignal | undefined;
+  const handle = app.handle.bind(app);
+  app.handle = (method: string, ctx: any) => {
+    signal = ctx.signal;
+    const notify = ctx.notify;
+    return handle(method, { ...ctx, notify: (n: any) => (progressCalls++, notify(n)) });
+  };
+
+  const server = await startServer(() => createMcpHttpServer(app, { originPort: 3000 }));
+
+  try {
+    const controller = new AbortController();
+    const params = { name: "reindex", arguments: { steps: 20, delayMs: 50 } };
+    const res = await post(
+      server,
+      { jsonrpc: "2.0", id: 1, method: "tools/call", params: { ...params, _meta: requestMeta({}, { progressToken: "p" }) } },
+      standardHeaders("tools/call", params),
+      controller.signal,
+    );
+    const reader = new SseReader(res);
+    assert.equal((await reader.next()).params.progress, 1);
+    controller.abort();
+
+    await new Promise((r) => setTimeout(r, 150));
+    assert.equal(signal?.aborted, true, "request signal is aborted once the client goes away");
+    const seen = progressCalls;
+    await new Promise((r) => setTimeout(r, 400));
+    assert.equal(progressCalls, seen, "no further steps run after cancellation");
+    assert.ok(seen < 20);
+  } finally {
+    await server.stop();
+  }
+});
