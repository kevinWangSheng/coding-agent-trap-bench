@@ -0,0 +1,79 @@
+import { EventEmitter } from "node:events";
+
+export interface Note {
+  id: string;
+  notebook: string;
+  title: string;
+  body: string;
+}
+
+export const NOTEBOOK_PATTERN = /^[A-Za-z0-9_-]{1,64}$/;
+export const MAX_TITLE_LENGTH = 200;
+
+export const INDEX_URI = "notes://index";
+export const NOTE_URI_PREFIX = "notes://notes/";
+
+export function noteUri(id: string): string {
+  return NOTE_URI_PREFIX + id;
+}
+
+export function renderNote(note: Note): string {
+  return `# ${note.title}\n\n${note.body}\n`;
+}
+
+export function countWords(text: string): number {
+  const trimmed = text.trim();
+  return trimmed === "" ? 0 : trimmed.split(/\s+/).length;
+}
+
+function numericId(id: string): number {
+  return Number(id.slice(1));
+}
+
+/**
+ * In-memory notes store. Emits "updated" with the URI of every resource whose
+ * content changed.
+ */
+export class NotesStore extends EventEmitter<{ updated: [uri: string] }> {
+  private readonly notes = new Map<string, Note>();
+  private nextId = 1;
+
+  constructor(seed: Array<Omit<Note, "id">> = DEFAULT_NOTES) {
+    super();
+    for (const note of seed) this.insert(note);
+  }
+
+  private insert(fields: Omit<Note, "id">): Note {
+    const note: Note = { id: `n${this.nextId++}`, ...fields };
+    this.notes.set(note.id, note);
+    return note;
+  }
+
+  add(fields: Omit<Note, "id">): Note {
+    const note = this.insert(fields);
+    this.emit("updated", INDEX_URI);
+    return note;
+  }
+
+  get(id: string): Note | undefined {
+    return this.notes.get(id);
+  }
+
+  delete(id: string): boolean {
+    if (!this.notes.delete(id)) return false;
+    this.emit("updated", INDEX_URI);
+    this.emit("updated", noteUri(id));
+    return true;
+  }
+
+  /** All notes ordered by numeric id. */
+  list(): Note[] {
+    return [...this.notes.values()].sort((a, b) => numericId(a.id) - numericId(b.id));
+  }
+}
+
+export const DEFAULT_NOTES: Array<Omit<Note, "id">> = [
+  { notebook: "work", title: "Standup", body: "Discussed the release schedule and blockers." },
+  { notebook: "work", title: "Retro actions", body: "Automate the changelog. Rotate the on-call." },
+  { notebook: "personal", title: "Groceries", body: "Eggs, flour, coffee." },
+];
