+// End-to-end tests: start the built server and exercise it over HTTP.
+
+import assert from "node:assert/strict";
+import { after, before, describe, test } from "node:test";
+import {
+  call,
+  http,
+  listen,
+  post,
+  readJson,
+  readText,
+  PROTOCOL_VERSION,
+  readResponse,
+  requestMeta,
+  SseReader,
+  standardHeaders,
+  startServer,
+  type RunningServer,
+} from "./helpers.ts";
+
+const FORM = { elicitation: { form: {} } };
+const SERVER_INFO = { name: "field-notes", version: "1.0.0" };
+
+let server: RunningServer;
+
+before(async () => {
+  server = await startServer();
+});
+
+after(async () => {
+  await server?.stop();
+});
+
+function text(result: any): string {
+  return result.content.map((c: any) => c.text).join("");
+}
+
+describe("transport and protocol envelope", () => {
+  test("server/discover advertises version, capabilities, identity and instructions", async () => {
+    const { status, body, headers } = await call(server, "server/discover");
+    assert.equal(status, 200);
+    assert.match(headers["content-type"]!, /^application\/json/);
+    const r = body.result;
+    assert.equal(r.resultType, "complete");
+    assert.deepEqual(r.supportedVersions, [PROTOCOL_VERSION]);
+    assert.deepEqual(r.capabilities, { tools: {}, resources: { subscribe: true }, prompts: {} });
+    assert.deepEqual(r._meta["io.modelcontextprotocol/serverInfo"], SERVER_INFO);
+    assert.equal(
+      r.instructions,
+      "Field Notes stores short notes grouped into notebooks. Use add_note to save a note, read notes://index to see what exists.",
+    );
+    assert.equal(r.ttlMs, 300000);
+    assert.equal(r.cacheScope, "public");
+  });
+
+  test("every result identifies the server", async () => {
+    const { body } = await call(server, "tools/list");
+    assert.deepEqual(body.result._meta["io.modelcontextprotocol/serverInfo"], SERVER_INFO);
+  });
+
+  test("missing _meta is invalid params with 400", async () => {
+    const res = await post(server, { jsonrpc: "2.0", id: 1, method: "tools/list", params: {} }, standardHeaders("tools/list", {}));
+    const { status, body } = await readResponse(res);
+    assert.equal(status, 400);
+    assert.equal(body.id, 1);
+    assert.equal(body.error.code, -32602);
+  });
+
+  test("missing clientCapabilities is invalid params with 400", async () => {
+    const params = { _meta: { "io.modelcontextprotocol/protocolVersion": PROTOCOL_VERSION } };
+    const res = await post(server, { jsonrpc: "2.0", id: 2, method: "tools/list", params }, standardHeaders("tools/list", params));
+    const { status, body } = await readResponse(res);
+    assert.equal(status, 400);
+    assert.equal(body.error.code, -32602);
+  });
+
+  test("unsupported protocol version lists supported versions", async () => {
+    const params = { _meta: { ...requestMeta(), "io.modelcontextprotocol/protocolVersion": "2025-11-25" } };
+    const headers = { ...standardHeaders("tools/list", params), "MCP-Protocol-Version": "2025-11-25" };
+    const { status, body } = await readResponse(await post(server, { jsonrpc: "2.0", id: 3, method: "tools/list", params }, headers));
+    assert.equal(status, 400);
+    assert.equal(body.error.code, -32022);
+    assert.deepEqual(body.error.data, { supported: [PROTOCOL_VERSION], requested: "2025-11-25" });
+  });
+
+  test("legacy initialize is rejected naming the supported versions", async () => {
+    const res = await post(
+      server,
+      { jsonrpc: "2.0", id: 0, method: "initialize", params: { protocolVersion: "2025-06-18", capabilities: {}, clientInfo: { name: "old", version: "1" } } },
+      { "Content-Type": "application/json", Accept: "application/json, text/event-stream" },
+    );
+    const { status, body } = await readResponse(res);
+    assert.equal(status, 400);
+    assert.equal(body.error.code, -32022);
+    assert.deepEqual(body.error.data.supported, [PROTOCOL_VERSION]);
+  });
+
+  test("missing MCP-Protocol-Version header is a header mismatch", async () => {
+    const { status, body } = await call(server, "tools/list", {}, { headers: { "MCP-Protocol-Version": null } });
+    assert.equal(status, 400);
+    assert.equal(body.error.code, -32020);
+  });
+
+  test("MCP-Protocol-Version header must match _meta", async () => {
+    const { status, body } = await call(server, "tools/list", {}, { headers: { "MCP-Protocol-Version": "2099-01-01" } });
+    assert.equal(status, 400);
+    assert.equal(body.error.code, -32020);
+  });
+
+  test("Mcp-Method header is required and must match", async () => {
+    let r = await call(server, "tools/list", {}, { headers: { "Mcp-Method": null } });
+    assert.equal(r.status, 400);
+    assert.equal(r.body.error.code, -32020);
+    r = await call(server, "tools/list", {}, { headers: { "Mcp-Method": "prompts/list" } });
+    assert.equal(r.status, 400);
+    assert.equal(r.body.error.code, -32020);
+  });
+
+  test("Mcp-Name header is required and must match, Base64 sentinel is decoded", async () => {
+    let r = await call(server, "resources/read", { uri: "notes://index" }, { headers: { "Mcp-Name": null } });
+    assert.equal(r.status, 400);
+    assert.equal(r.body.error.code, -32020);
+    r = await call(server, "resources/read", { uri: "notes://index" }, { headers: { "Mcp-Name": "notes://notes/n1" } });
+    assert.equal(r.status, 400);
+    assert.equal(r.body.error.code, -32020);
+    const encoded = `=?base64?${Buffer.from("notes://index").toString("base64")}?=`;
+    r = await call(server, "resources/read", { uri: "notes://index" }, { headers: { "Mcp-Name": encoded } });
+    assert.equal(r.status, 200);
+    assert.equal(r.body.result.resultType, "complete");
+    r = await call(server, "resources/read", { uri: "notes://index" }, { headers: { "Mcp-Name": "=?base64?!!!?=" } });
+    assert.equal(r.status, 400);
+    assert.equal(r.body.error.code, -32020);
+  });
+
+  test("unknown method is 404 with -32601", async () => {
+    const { status, body } = await call(server, "resources/subscribe", { uri: "notes://index" });
+    assert.equal(status, 404);
+    assert.equal(body.error.code, -32601);
+  });
+
+  test("invalid JSON is a parse error", async () => {
+    const res = await post(server, "{not json", standardHeaders("tools/list", {}));
+    const { status, body } = await readResponse(res);
+    assert.equal(status, 400);
+    assert.equal(body.error.code, -32700);
+  });
+
+  test("batches and responses are invalid requests", async () => {
+    let res = await post(server, [{ jsonrpc: "2.0", id: 1, method: "tools/list" }], standardHeaders("tools/list", {}));
+    assert.equal(res.statusCode, 400);
+    assert.equal((await readJson(res)).error.code, -32600);
+    res = await post(server, { jsonrpc: "2.0", id: 1, result: {} }, standardHeaders("tools/list", {}));
+    assert.equal(res.statusCode, 400);
+    assert.equal((await readJson(res)).error.code, -32600);
+  });
+
+  test("notifications are accepted with 202 and no body", async () => {
+    const res = await post(
+      server,
+      { jsonrpc: "2.0", method: "notifications/cancelled", params: { requestId: 99 } },
+      { "Content-Type": "application/json", Accept: "application/json, text/event-stream" },
+    );
+    assert.equal(res.statusCode, 202);
+    assert.equal(await readText(res), "");
+  });
+
+  test("GET and DELETE are 405, other paths 404", async () => {
+    assert.equal((await http(server, { method: "GET" })).statusCode, 405);
+    assert.equal((await http(server, { method: "DELETE" })).statusCode, 405);
+    const other = await http(server, { path: "/other", body: {}, headers: standardHeaders("tools/list", {}) });
+    assert.equal(other.statusCode, 404);
+  });
+
+  test("browser origins other than localhost:PORT are forbidden", async () => {
+    let r = await call(server, "tools/list", {}, { headers: { Origin: "http://evil.example" } });
+    assert.equal(r.status, 403);
+    r = await call(server, "tools/list", {}, { headers: { Origin: `http://localhost:${server.port + 1}` } });
+    assert.equal(r.status, 403);
+    r = await call(server, "tools/list", {}, { headers: { Origin: `http://localhost:${server.port}` } });
+    assert.equal(r.status, 200);
+    r = await call(server, "tools/list", {}, { headers: { Origin: `http://127.0.0.1:${server.port}` } });
+    assert.equal(r.status, 200);
+  });
+
+  test("Mcp-Session-Id is ignored and never minted", async () => {
+    const r = await call(server, "tools/list", {}, { headers: { "Mcp-Session-Id": "abc" } });
+    assert.equal(r.status, 200);
+    assert.equal(r.headers["mcp-session-id"], undefined);
+  });
+});
+
+describe("tools", () => {
+  test("tools/list returns the three tools alphabetically, cacheable", async () => {
+    const { body } = await call(server, "tools/list");
+    const r = body.result;
+    assert.deepEqual(r.tools.map((t: any) => t.name), ["add_note", "delete_note", "reindex"]);
+    assert.equal(r.ttlMs, 300000);
+    assert.equal(r.cacheScope, "public");
+    assert.equal(r.nextCursor, undefined);
+    const add = r.tools[0];
+    assert.equal(add.inputSchema.type, "object");
+    assert.equal(add.inputSchema.properties.notebook["x-mcp-header"], "Notebook");
+    assert.deepEqual([...add.inputSchema.required].sort(), ["body", "notebook", "title"]);
+    assert.equal(add.outputSchema.type, "object");
+    assert.deepEqual([...add.outputSchema.required].sort(), ["id", "notebook", "uri", "wordCount"]);
+  });
+
+  test("an unknown cursor is invalid params", async () => {
+    const { body } = await call(server, "tools/list", { cursor: "bogus" });
+    assert.equal(body.error.code, -32602);
+  });
+
+  test("unknown tool is a protocol error", async () => {
+    const { body } = await call(server, "tools/call", { name: "nope", arguments: {} });
+    assert.equal(body.error.code, -32602);
+  });
+
+  test("add_note returns structured output and a text copy", async () => {
+    const { status, body } = await call(server, "tools/call", {
+      name: "add_note",
+      arguments: { notebook: "work", title: "Plan", body: "  ship   it\tnow\n" },
+    });
+    assert.equal(status, 200);
+    const r = body.result;
+    assert.equal(r.resultType, "complete");
+    assert.notEqual(r.isError, true);
+    assert.match(r.structuredContent.id, /^n\d+$/);
+    assert.deepEqual(r.structuredContent, {
