+++ b/test/helpers.ts
@@ -0,0 +1,312 @@
+// Test helpers: run the server and talk MCP to it over HTTP.
+//
+// By default the built server (`dist/server.js`, i.e. what `npm start` runs) is
+// spawned on a random TCP port. Set MCP_TEST_TRANSPORT=memory to instead run the
+// same HTTP server in-process and feed it HTTP over an in-memory socket pair
+// (for sandboxes that forbid listening on sockets).
+
+import { spawn } from "node:child_process";
+import { request as httpRequest, type IncomingMessage, type Server } from "node:http";
+import { duplexPair } from "node:stream";
+import { fileURLToPath } from "node:url";
+import type { AddressInfo } from "node:net";
+
+export const PROTOCOL_VERSION = "2026-07-28";
+const SERVER_ENTRY = fileURLToPath(new URL("../dist/server.js", import.meta.url));
+const MEMORY = process.env.MCP_TEST_TRANSPORT === "memory";
+/** Port used for the origin allow-list when running in memory. */
+const MEMORY_PORT = 3000;
+
+export interface RunningServer {
+  url: string;
+  port: number;
+  /** Opens a client connection to the server (in-memory mode only). */
+  connect?: () => NodeJS.ReadWriteStream;
+  /** Asks the server to shut down (SIGTERM, or graceful shutdown in-process). */
+  terminate(): void;
+  /** Stops the server and waits until it is gone. */
+  stop(): Promise<void>;
+}
+
+/**
+ * Starts a server. With `inProcess` (an object from dist/http.js's
+ * createMcpHttpServer factory), that server is used instead of spawning one.
+ */
+export async function startServer(
+  inProcess?: () => { server: Server; shutdown(): Promise<void> },
+): Promise<RunningServer> {
+  if (MEMORY || inProcess) {
+    const factory = inProcess ?? (await defaultFactory());
+    const { server, shutdown } = factory();
+    let port = MEMORY_PORT;
+    let connect: RunningServer["connect"];
+    if (MEMORY) {
+      connect = () => {
+        const [client, serverSide] = duplexPair();
+        server.emit("connection", serverSide);
+        return client;
+      };
+    } else {
+      await new Promise<void>((resolve) => server.listen(0, "127.0.0.1", resolve));
+      port = (server.address() as AddressInfo).port;
+    }
+    let stopped: Promise<void> | undefined;
+    const stop = () => (stopped ??= shutdown());
+    return { url: `http://127.0.0.1:${port}/mcp`, port, connect, terminate: () => void stop(), stop };
+  }
+  return spawnServer();
+}
+
+async function defaultFactory() {
+  const { createMcpHttpServer } = await import("../dist/http.js");
+  return () => createMcpHttpServer(undefined, { originPort: MEMORY_PORT });
+}
+
+function spawnServer(): Promise<RunningServer> {
+  return new Promise((resolve, reject) => {
+    const child = spawn(process.execPath, [SERVER_ENTRY], {
+      env: { ...process.env, PORT: "0" },
+      stdio: ["ignore", "pipe", "inherit"],
+    });
+    let output = "";
+    const timer = setTimeout(() => reject(new Error(`server did not start: ${output}`)), 10_000);
+    child.stdout!.setEncoding("utf8");
+    child.stdout!.on("data", (chunk: string) => {
+      output += chunk;
+      const match = /listening on (http:\/\/127\.0\.0\.1:(\d+)\/mcp)/.exec(output);
+      if (!match) return;
+      clearTimeout(timer);
+      const exited = new Promise<void>((done) => child.once("exit", () => done()));
+      resolve({
+        url: match[1]!,
+        port: Number(match[2]),
+        terminate: () => void child.kill("SIGTERM"),
+        stop: async () => {
+          if (child.exitCode === null && child.signalCode === null) child.kill("SIGTERM");
+          await exited;
+        },
+      });
+    });
+    child.once("exit", (code) => {
+      clearTimeout(timer);
+      reject(new Error(`server exited early (${code}): ${output}`));
+    });
+  });
+}
+
+export interface HttpOptions {
+  method?: string;
+  path?: string;
+  headers?: Record<string, string>;
+  body?: unknown;
+  signal?: AbortSignal;
+}
+
+/** Sends one HTTP request to the server and resolves with the (streaming) response. */
+export function http(server: RunningServer, options: HttpOptions = {}): Promise<IncomingMessage> {
+  const target = new URL(server.url);
+  const body =
+    options.body === undefined ? undefined : typeof options.body === "string" ? options.body : JSON.stringify(options.body);
+  return new Promise((resolve, reject) => {
+    const req = httpRequest(
+      {
+        host: target.hostname,
+        port: target.port,
+        path: options.path ?? target.pathname,
+        method: options.method ?? "POST",
+        headers: options.headers,
+        signal: options.signal,
+        // A fresh connection per request (no keep-alive pooling between tests).
+        ...(server.connect ? { createConnection: server.connect as any } : { agent: false }),
+      },
+      resolve,
+    );
+    req.on("error", reject);
+    req.end(body);
+  });
+}
+
+export async function post(server: RunningServer, body: unknown, headers: Record<string, string>, signal?: AbortSignal) {
+  return http(server, { body, headers, signal });
+}
+
+export async function readText(res: IncomingMessage): Promise<string> {
+  res.setEncoding("utf8");
+  let text = "";
+  for await (const chunk of res) text += chunk;
+  return text;
+}
+
+export async function readJson(res: IncomingMessage): Promise<any> {
+  return JSON.parse(await readText(res));
+}
+
+export interface CallOptions {
+  id?: string | number;
+  capabilities?: Record<string, unknown>;
+  meta?: Record<string, unknown>;
+  /** Extra/override headers; a value of `null` removes a default header. */
+  headers?: Record<string, string | null>;
+}
+
+export interface RpcResponse {
+  status: number;
+  headers: IncomingMessage["headers"];
+  /** The final JSON-RPC response. */
+  body: any;
+  /** Notifications received before the final response (SSE only). */
+  notifications: any[];
+}
+
+let nextId = 1;
+
+export function requestMeta(capabilities: Record<string, unknown> = {}, extra: Record<string, unknown> = {}) {
+  return {
+    "io.modelcontextprotocol/protocolVersion": PROTOCOL_VERSION,
+    "io.modelcontextprotocol/clientInfo": { name: "field-notes-tests", version: "0.0.0" },
+    "io.modelcontextprotocol/clientCapabilities": capabilities,
+    ...extra,
+  };
+}
+
+/** The headers a conforming client sends for this request. */
+export function standardHeaders(method: string, params: Record<string, any>): Record<string, string> {
+  const headers: Record<string, string> = {
+    "Content-Type": "application/json",
+    Accept: "application/json, text/event-stream",
+    "MCP-Protocol-Version": PROTOCOL_VERSION,
+    "Mcp-Method": method,
+  };
+  if (method === "tools/call" || method === "prompts/get") headers["Mcp-Name"] = encodeHeader(params.name);
+  if (method === "resources/read") headers["Mcp-Name"] = encodeHeader(params.uri);
+  if (method === "tools/call" && params.name === "add_note" && typeof params.arguments?.notebook === "string") {
+    headers["Mcp-Param-Notebook"] = encodeHeader(params.arguments.notebook);
+  }
+  return headers;
+}
+
+export function encodeHeader(value: string): string {
+  const plain = /^[\x21-\x7e]([\x20-\x7e]*[\x21-\x7e])?$/.test(value);
+  const sentinel = value.startsWith("=?base64?") && value.endsWith("?=");
+  return plain && !sentinel ? value : `=?base64?${Buffer.from(value, "utf8").toString("base64")}?=`;
+}
+
+/** Sends a JSON-RPC request with the required `_meta` and headers and collects the response. */
+export async function call(
+  server: RunningServer,
+  method: string,
+  params: Record<string, any> = {},
+  options: CallOptions = {},
+): Promise<RpcResponse> {
+  const id = options.id ?? nextId++;
+  const fullParams = { ...params, _meta: requestMeta(options.capabilities, options.meta) };
+  const headers = standardHeaders(method, params);
+  for (const [k, v] of Object.entries(options.headers ?? {})) {
+    for (const existing of Object.keys(headers)) if (existing.toLowerCase() === k.toLowerCase()) delete headers[existing];
+    if (v !== null) headers[k] = v;
+  }
+  const res = await post(server, { jsonrpc: "2.0", id, method, params: fullParams }, headers);
+  return readResponse(res);
+}
+
+export async function readResponse(res: IncomingMessage): Promise<RpcResponse> {
+  const type = res.headers["content-type"] ?? "";
+  if (type.startsWith("text/event-stream")) {
+    const reader = new SseReader(res);
+    const messages: any[] = [];
+    for (;;) {
+      const message = await reader.next(30_000);
+      if (message === undefined) break;
+      messages.push(message);
+      if (!("method" in message)) break;
+    }
+    const body = messages.pop();
+    return { status: res.statusCode!, headers: res.headers, body, notifications: messages };
+  }
+  const text = await readText(res);
+  return { status: res.statusCode!, headers: res.headers, body: text ? JSON.parse(text) : undefined, notifications: [] };
+}
+
+/** Incremental reader for an SSE response carrying JSON-RPC messages. */
+export class SseReader {
+  private readonly res: IncomingMessage;
+  private buffer = "";
+  private readonly queue: any[] = [];
+  private ended = false;
+  private wake: (() => void) | undefined;
+
+  constructor(res: IncomingMessage) {
+    this.res = res;
+    res.setEncoding("utf8");
+    res.on("data", (chunk: string) => {
+      this.buffer += chunk;
+      this.parse();
+      this.wake?.();
+    });
+    const finish = () => {
+      this.ended = true;
+      this.wake?.();
+    };
+    res.on("end", finish);
+    res.on("close", finish);
+    res.on("error", finish);
+  }
+
+  /** Next JSON-RPC message, or undefined once the stream has ended. Rejects on timeout. */
+  async next(timeoutMs = 5000): Promise<any> {
+    const deadline = Date.now() + timeoutMs;
+    while (this.queue.length === 0 && !this.ended) {
+      const remaining = deadline - Date.now();
+      if (remaining <= 0) throw new Error("timed out waiting for SSE message");
+      await new Promise<void>((resolve) => {
+        const timer = setTimeout(resolve, remaining);
+        this.wake = () => {
+          clearTimeout(timer);
+          resolve();
+        };
+      });
+      this.wake = undefined;
+    }
+    return this.queue.shift();
+  }
+
+  /** True if no message arrives within `ms`. */
+  async quiet(ms: number): Promise<boolean> {
+    try {
+      const message = await this.next(ms);
+      if (message !== undefined) this.queue.unshift(message);
+      return message === undefined;
+    } catch {
+      return true;
+    }
+  }
+
+  close(): void {
+    this.res.destroy();
+  }
+
+  private parse(): void {
+    let match: RegExpExecArray | null;
+    while ((match = /\r?\n\r?\n/.exec(this.buffer))) {
+      const event = this.buffer.slice(0, match.index);
+      this.buffer = this.buffer.slice(match.index + match[0].length);
+      const data = event
+        .split(/\r?\n/)
+        .filter((line) => line.startsWith("data:"))
+        .map((line) => line.slice(5).replace(/^ /, ""))
+        .join("\n");
+      if (data) this.queue.push(JSON.parse(data));
+    }
+  }
+}
+
+/** Opens a subscriptions/listen stream. */
+export async function listen(server: RunningServer, notifications: Record<string, unknown>, id: string | number) {
+  const params = { notifications, _meta: requestMeta() };
+  const res = await post(
+    server,
+    { jsonrpc: "2.0", id, method: "subscriptions/listen", params },
+    standardHeaders("subscriptions/listen", params),
+  );
+  return { res, reader: new SseReader(res) };
+}
