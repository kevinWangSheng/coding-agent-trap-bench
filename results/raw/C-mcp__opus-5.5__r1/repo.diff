@@ -0,0 +1,46 @@
+import { createHmac, randomBytes, timingSafeEqual } from "node:crypto";
+import type { JsonObject } from "./protocol.js";
+import { isObject } from "./protocol.js";
+
+/**
+ * Integrity-protected, self-contained MRTR request state. The server keeps no
+ * per-request memory: everything needed to validate a retry travels inside the
+ * token, which is HMAC-signed so the client cannot forge or modify it.
+ */
+export class RequestStateSigner {
+  private readonly key: Buffer;
+  private readonly ttlMs: number;
+
+  constructor(key: Buffer = randomBytes(32), ttlMs = 10 * 60 * 1000) {
+    this.key = key;
+    this.ttlMs = ttlMs;
+  }
+
+  sign(payload: JsonObject): string {
+    const body = { ...payload, exp: Date.now() + this.ttlMs, nonce: randomBytes(8).toString("base64url") };
+    const encoded = Buffer.from(JSON.stringify(body)).toString("base64url");
+    return `${encoded}.${this.mac(encoded)}`;
+  }
+
+  /** Returns the payload, or undefined if the token is malformed, tampered with, or expired. */
+  verify(token: string): JsonObject | undefined {
+    const parts = token.split(".");
+    if (parts.length !== 2) return undefined;
+    const [encoded, mac] = parts as [string, string];
+    const expected = Buffer.from(this.mac(encoded));
+    const actual = Buffer.from(mac);
+    if (actual.length !== expected.length || !timingSafeEqual(actual, expected)) return undefined;
+    let payload: unknown;
+    try {
+      payload = JSON.parse(Buffer.from(encoded, "base64url").toString("utf8"));
+    } catch {
+      return undefined;
+    }
+    if (!isObject(payload) || typeof payload.exp !== "number" || payload.exp < Date.now()) return undefined;
+    return payload;
+  }
+
+  private mac(encoded: string): string {
+    return createHmac("sha256", this.key).update(encoded).digest("base64url");
+  }
+}
