+        for panic_at in [0, 1, 2, 5, 10] {
+            let td = td.clone();
+            let msg = assert_panics_without_hang(move || {
+                let mut count = 0;
+                WalkBuilder::new(td.path()).threads(10).build_parallel().run(
+                    || {
+                        if count == panic_at {
+                            panic!("builder panic");
+                        }
+                        count += 1;
+                        Box::new(|_| WalkState::Continue)
+                    },
+                );
+            });
+            assert_eq!(msg, "builder panic");
+        }
+    }
