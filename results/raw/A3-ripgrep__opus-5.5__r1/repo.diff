+/// Sets the shared `quit_now` flag if dropped while the thread is panicking.
+///
+/// This ensures that a panic in one worker causes all other workers to quit
+/// instead of waiting forever for work from the panicked worker.
+struct QuitOnPanic(Arc<AtomicBool>);
+
+impl Drop for QuitOnPanic {
+    fn drop(&mut self) {
+        if std::thread::panicking() {
+            self.0.store(true, AtomicOrdering::SeqCst);
+        }
+    }
+}
