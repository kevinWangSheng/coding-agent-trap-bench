+    /// Runs `f` on a separate thread and asserts that it panics within a
+    /// reasonable amount of time (instead of, e.g., deadlocking). Returns the
+    /// panic message.
+    fn assert_panics_without_hang<F>(f: F) -> String
+    where
+        F: FnOnce() + Send + 'static,
+    {
+        let (tx, rx) = std::sync::mpsc::channel();
+        std::thread::spawn(move || {
+            let result =
+                std::panic::catch_unwind(std::panic::AssertUnwindSafe(f));
+            let _ = tx.send(result);
+        });
+        let result = rx
+            .recv_timeout(std::time::Duration::from_secs(30))
+            .expect("parallel walk hung after a panic");
+        let payload = result.expect_err("parallel walk did not panic");
+        if let Some(msg) = payload.downcast_ref::<&str>() {
+            msg.to_string()
+        } else if let Some(msg) = payload.downcast_ref::<String>() {
+            msg.clone()
+        } else {
+            panic!("unexpected panic payload")
+        }
+    }
+
+    /// Creates a directory tree with enough directories to keep many
+    /// threads busy.
+    fn mk_panic_tree() -> TempDir {
+        let td = tmpdir();
+        for i in 0..20 {
+            for j in 0..5 {
+                mkdirp(td.path().join(format!("d{i}/e{j}")));
+                wfile(td.path().join(format!("d{i}/e{j}/foo")), "");
+            }
+        }
+        td
+    }
+
+    #[test]
+    fn parallel_panic_in_visitor() {
+        let td = Arc::new(mk_panic_tree());
+        for _ in 0..20 {
+            let td = td.clone();
+            let msg = assert_panics_without_hang(move || {
+                WalkBuilder::new(td.path())
+                    .threads(40)
+                    .build_parallel()
+                    .run(|| Box::new(|_| panic!("oops!")));
+            });
+            assert_eq!(msg, "oops!");
+        }
+    }
+
