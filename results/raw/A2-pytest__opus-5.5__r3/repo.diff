diff --git a/changelog/13456.bugfix.rst b/changelog/13456.bugfix.rst
new file mode 100644
index 0000000..110a839
--- /dev/null
+++ b/changelog/13456.bugfix.rst
@@ -0,0 +1 @@
+:meth:`MonkeyPatch.setattr <pytest.MonkeyPatch.setattr>` no longer leaves a copy of an inherited attribute in the instance ``__dict__`` after undoing a patch on a non-class object -- previously, this froze the result of ``__get__`` descriptors after teardown.
diff --git a/src/_pytest/monkeypatch.py b/src/_pytest/monkeypatch.py
index 9ae9e2b..6e209d9 100644
--- a/src/_pytest/monkeypatch.py
+++ b/src/_pytest/monkeypatch.py
@@ -244,7 +244,24 @@ class MonkeyPatch:
         # avoid class descriptors like staticmethod/classmethod
         if inspect.isclass(target):
             oldval = target.__dict__.get(name, NOTSET)
-        setattr(target, name, value)
+            setattr(target, name, value)
+        else:
+            # If the attribute is not in the instance ``__dict__`` (e.g. it is
+            # inherited from the class, or provided by ``__getattr__``) but
+            # setting it creates an entry there, undo must delete that entry
+            # rather than store the looked-up value, which would shadow the
+            # original lookup (and freeze the result of descriptors).
+            instance_dict = getattr(target, "__dict__", None)
+            was_in_dict = (
+                name in instance_dict if isinstance(instance_dict, dict) else True
+            )
+            setattr(target, name, value)
+            if (
+                not was_in_dict
+                and isinstance(instance_dict, dict)
+                and name in instance_dict
+            ):
+                oldval = NOTSET
         self._setattr.append((target, name, oldval))
 
     def delattr(
