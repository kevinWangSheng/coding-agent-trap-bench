+def test_setattr_inherited_attribute_on_instance_undo() -> None:
+    class A:
+        x = 1
+
+    a = A()
+    monkeypatch = MonkeyPatch()
+    monkeypatch.setattr(a, "x", 2)
+    assert a.x == 2
+    assert vars(a) == {"x": 2}
+    monkeypatch.undo()
+    assert a.x == 1
+    assert vars(a) == {}
+    A.x = 3
+    assert a.x == 3
+
+
+def test_setattr_inherited_descriptor_on_instance_undo() -> None:
+    counter = 0
+
+    class NonDataDescriptor:
+        def __get__(self, obj: object, objtype: type | None = None) -> int:
+            nonlocal counter
+            counter += 1
+            return counter
+
+    class A:
+        method = NonDataDescriptor()
+
+    a = A()
+    monkeypatch = MonkeyPatch()
+    monkeypatch.setattr(a, "method", 42)
+    assert a.method == 42
+    monkeypatch.undo()
+    assert "method" not in vars(a)
+    first = a.method
+    assert a.method == first + 1
+
+
+def test_setattr_data_descriptor_on_instance_undo() -> None:
+    class A:
+        def __init__(self) -> None:
+            self._x = 1
+
+        @property
+        def x(self) -> int:
+            return self._x
+
+        @x.setter
+        def x(self, value: int) -> None:
+            self._x = value
+
+    a = A()
+    monkeypatch = MonkeyPatch()
+    monkeypatch.setattr(a, "x", 2)
+    assert a.x == 2
+    monkeypatch.undo()
+    assert a.x == 1
+    assert vars(a) == {"_x": 1}
+
+
+def test_setattr_own_attribute_on_instance_undo() -> None:
+    class A:
+        x = 1
+
+    a = A()
+    a.x = 5
+    monkeypatch = MonkeyPatch()
+    monkeypatch.setattr(a, "x", 2)
+    monkeypatch.undo()
+    assert vars(a) == {"x": 5}
+
+
+def test_setattr_getattr_fallback_on_instance_undo() -> None:
+    class A:
+        def __getattr__(self, name: str) -> str:
+            return "dynamic"
+
+    a = A()
+    monkeypatch = MonkeyPatch()
+    monkeypatch.setattr(a, "y", "patched")
+    assert a.y == "patched"
+    monkeypatch.undo()
+    assert vars(a) == {}
+    assert a.y == "dynamic"
+
+
+def test_setattr_slots_on_instance_undo() -> None:
+    class A:
+        __slots__ = ("x",)
+
+        def __init__(self) -> None:
+            self.x = 1
+
+    a = A()
+    monkeypatch = MonkeyPatch()
+    monkeypatch.setattr(a, "x", 2)
+    assert a.x == 2
+    monkeypatch.undo()
+    assert a.x == 1
+
+
