@@ -49,14 +49,17 @@ class Parser:
         return node
 
     def term(self):
-        node = self.power()
+        node = self.unary()
         while (tok := self.accept("*", "/", "%")) is not None:
-            node = ("bin", tok.value, node, self.power())
+            node = ("bin", tok.value, node, self.unary())
         return node
 
     def power(self):
-        node = self.unary()
-        while self.accept("^") is not None:
+        node = self.atom()
+        # The right operand is a unary expression so that signed exponents
+        # are parsed and rejected during evaluation, while unary minus on the
+        # left binds less tightly than exponentiation (e.g. -3 ^ 2).
+        if self.accept("^") is not None:
             node = ("bin", "^", node, self.unary())
         return node
 
@@ -65,7 +68,7 @@ class Parser:
             return ("neg", self.unary())
         if self.accept("+") is not None:
             return self.unary()
-        return self.atom()
+        return self.power()
 
     def atom(self):
         tok = self.peek()
