+package storage
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"go.uber.org/zap/zaptest"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+	betesting "go.etcd.io/etcd/server/v3/storage/backend/testing"
+)
+
+func putOp(key, val string) *pb.RequestOp {
+	return &pb.RequestOp{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{Key: []byte(key), Value: []byte(val)}}}
+}
+
+func rangeOp(key string) *pb.RequestOp {
+	return &pb.RequestOp{Request: &pb.RequestOp_RequestRange{RequestRange: &pb.RangeRequest{Key: []byte(key)}}}
+}
+
+func txnOp(success, failure []*pb.RequestOp) *pb.RequestOp {
+	return &pb.RequestOp{Request: &pb.RequestOp_RequestTxn{RequestTxn: &pb.TxnRequest{Success: success, Failure: failure}}}
+}
+
+func TestBackendQuotaCost(t *testing.T) {
+	q := &BackendQuota{}
+	putCost := kvOverhead + len("foo") + len("bar")
+
+	tests := []struct {
+		name string
+		req  any
+		want int
+	}{
+		{
+			name: "put",
+			req:  &pb.PutRequest{Key: []byte("foo"), Value: []byte("bar")},
+			want: putCost,
+		},
+		{
+			name: "lease grant",
+			req:  &pb.LeaseGrantRequest{},
+			want: leaseOverhead,
+		},
+		{
+			name: "txn without puts",
+			req:  &pb.TxnRequest{Success: []*pb.RequestOp{rangeOp("foo")}, Failure: []*pb.RequestOp{rangeOp("foo")}},
+			want: 0,
+		},
+		{
+			name: "flat txn uses the larger branch (success)",
+			req:  &pb.TxnRequest{Success: []*pb.RequestOp{putOp("foo", "bar"), putOp("foo", "bar")}, Failure: []*pb.RequestOp{putOp("foo", "bar")}},
+			want: 2 * putCost,
+		},
+		{
+			name: "flat txn uses the larger branch (failure)",
+			req:  &pb.TxnRequest{Success: []*pb.RequestOp{putOp("foo", "bar")}, Failure: []*pb.RequestOp{putOp("foo", "bar"), putOp("foo", "bar")}},
+			want: 2 * putCost,
+		},
+		{
+			name: "nested txn in success branch",
+			req: &pb.TxnRequest{Success: []*pb.RequestOp{
+				txnOp([]*pb.RequestOp{putOp("foo", "bar"), putOp("foo", "bar")}, nil),
+			}},
+			want: 2 * putCost,
+		},
+		{
+			name: "nested txn in failure branch",
+			req: &pb.TxnRequest{Failure: []*pb.RequestOp{
+				txnOp(nil, []*pb.RequestOp{putOp("foo", "bar"), putOp("foo", "bar")}),
+			}},
+			want: 2 * putCost,
+		},
+		{
+			name: "nested txn cost adds to sibling puts and uses its larger branch",
+			req: &pb.TxnRequest{Success: []*pb.RequestOp{
+				putOp("foo", "bar"),
+				txnOp([]*pb.RequestOp{putOp("foo", "bar")}, []*pb.RequestOp{putOp("foo", "bar"), putOp("foo", "bar")}),
+			}},
+			want: 3 * putCost,
+		},
+		{
+			name: "deeply nested txn",
+			req: &pb.TxnRequest{Failure: []*pb.RequestOp{
+				txnOp([]*pb.RequestOp{
+					txnOp(nil, []*pb.RequestOp{putOp("foo", "bar")}),
+				}, nil),
+			}},
+			want: putCost,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			assert.Equal(t, tt.want, q.Cost(tt.req))
+		})
+	}
+}
+
+func TestBackendQuotaAvailableNestedTxn(t *testing.T) {
+	be, _ := betesting.NewDefaultTmpBackend(t)
+	defer betesting.Close(t, be)
+
+	// quota leaves room for a small request only
+	quotaBytes := be.Size() + int64(kvOverhead) + 100
+	q := NewBackendQuota(zaptest.NewLogger(t), quotaBytes, be, "test")
+
+	bigVal := string(make([]byte, 1024))
+	small := &pb.PutRequest{Key: []byte("k"), Value: []byte("v")}
+	assert.True(t, q.Available(small))
+	assert.False(t, q.Available(&pb.PutRequest{Key: []byte("k"), Value: []byte(bigVal)}))
+
+	flat := &pb.TxnRequest{Success: []*pb.RequestOp{putOp("k", bigVal)}}
+	assert.False(t, q.Available(flat))
+
+	nestedSuccess := &pb.TxnRequest{Success: []*pb.RequestOp{txnOp([]*pb.RequestOp{putOp("k", bigVal)}, nil)}}
+	assert.False(t, q.Available(nestedSuccess))
+
+	nestedFailure := &pb.TxnRequest{Failure: []*pb.RequestOp{txnOp(nil, []*pb.RequestOp{putOp("k", bigVal)})}}
+	assert.False(t, q.Available(nestedFailure))
+
+	readOnlyNested := &pb.TxnRequest{Success: []*pb.RequestOp{txnOp([]*pb.RequestOp{rangeOp("k")}, nil)}}
+	assert.True(t, q.Available(readOnlyNested))
+}
