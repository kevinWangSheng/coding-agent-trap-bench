diff --git a/testing/test_monkeypatch.py b/testing/test_monkeypatch.py
index 63e145c..5aaf1fd 100644
--- a/testing/test_monkeypatch.py
+++ b/testing/test_monkeypatch.py
@@ -501,6 +501,48 @@ def test_context_classmethod() -> None:
     assert A.x == 1
 
 
+def test_setattr_inherited_attribute_restores_instance_dict() -> None:
+    class Parent:
+        value = "inherited"
+
+    class Child(Parent):
+        pass
+
+    target = Child()
+    monkeypatch = MonkeyPatch()
+    monkeypatch.setattr(target, "value", "patched")
+    assert vars(target) == {"value": "patched"}
+
+    monkeypatch.undo()
+    assert vars(target) == {}
+    assert target.value == "inherited"
+
+
+def test_setattr_inherited_descriptor_does_not_cache_on_undo() -> None:
+    class Descriptor:
+        def __init__(self) -> None:
+            self.calls = 0
+
+        def __get__(self, instance, owner):
+            self.calls += 1
+            return self.calls
+
+    class Parent:
+        value = Descriptor()
+
+    class Child(Parent):
+        pass
+
+    target = Child()
+    monkeypatch = MonkeyPatch()
+    monkeypatch.setattr(target, "value", "patched")
+    monkeypatch.undo()
+
+    assert vars(target) == {}
+    assert target.value == 2
+    assert target.value == 3
+
+
