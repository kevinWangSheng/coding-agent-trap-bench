+def test_undo_inherited_attribute_on_instance() -> None:
+    class A:
+        x = 1
+
+    a = A()
+    monkeypatch = MonkeyPatch()
+    monkeypatch.setattr(a, "x", 2)
+    assert a.x == 2
+    monkeypatch.undo()
+    assert a.x == 1
+    assert "x" not in vars(a)
+
+
+def test_undo_inherited_descriptor_on_instance() -> None:
+    class Counter:
+        def __get__(self, obj, objtype=None):
+            obj.count += 1
+            return obj.count
+
+    class A:
+        value = Counter()
+
+        def __init__(self) -> None:
+            self.count = 0
+
+    a = A()
+    monkeypatch = MonkeyPatch()
+    monkeypatch.setattr(a, "value", 42)
+    assert a.value == 42
+    monkeypatch.undo()
+    assert "value" not in vars(a)
+    # The descriptor must be dynamically looked up again, not cached.
+    first = a.value
+    assert a.value == first + 1
+
+
+def test_undo_instance_attribute_shadowing_class() -> None:
+    class A:
+        x = 1
+
+    a = A()
+    a.x = 5
+    monkeypatch = MonkeyPatch()
+    monkeypatch.setattr(a, "x", 2)
+    monkeypatch.undo()
+    assert vars(a) == {"x": 5}
+
+
+def test_undo_data_descriptor_on_instance() -> None:
+    class A:
+        def __init__(self) -> None:
+            self._x = 1
+
+        @property
+        def x(self) -> int:
+            return self._x
+
+        @x.setter
+        def x(self, value: int) -> None:
+            self._x = value
+
+    a = A()
+    monkeypatch = MonkeyPatch()
+    monkeypatch.setattr(a, "x", 2)
+    assert a.x == 2
+    monkeypatch.undo()
+    assert a.x == 1
+    assert vars(a) == {"_x": 1}
+
+
+def test_undo_getattr_attribute_on_instance() -> None:
+    class A:
+        def __getattr__(self, name: str) -> str:
+            return f"dynamic-{name}"
+
+    a = A()
+    monkeypatch = MonkeyPatch()
+    monkeypatch.setattr(a, "x", "patched")
+    assert a.x == "patched"
+    monkeypatch.undo()
+    assert a.x == "dynamic-x"
+    assert "x" not in vars(a)
+
+
