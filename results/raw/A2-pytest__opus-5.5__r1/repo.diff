diff --git a/changelog/+monkeypatch-inherited-attr.bugfix.rst b/changelog/+monkeypatch-inherited-attr.bugfix.rst
new file mode 100644
index 0000000..fe76991
--- /dev/null
+++ b/changelog/+monkeypatch-inherited-attr.bugfix.rst
@@ -0,0 +1 @@
+:meth:`MonkeyPatch.setattr <pytest.MonkeyPatch.setattr>` no longer leaves a new entry in the instance ``__dict__`` after undo when patching an attribute that the (non-class) target inherited or obtained via a descriptor; previously this cached the value and broke dynamic lookup of ``__get__`` descriptors.
diff --git a/src/_pytest/monkeypatch.py b/src/_pytest/monkeypatch.py
index 9ae9e2b..d49e9b8 100644
--- a/src/_pytest/monkeypatch.py
+++ b/src/_pytest/monkeypatch.py
@@ -244,7 +244,24 @@ class MonkeyPatch:
         # avoid class descriptors like staticmethod/classmethod
         if inspect.isclass(target):
             oldval = target.__dict__.get(name, NOTSET)
-        setattr(target, name, value)
+            setattr(target, name, value)
+        else:
+            # If the attribute is not stored on the instance itself (e.g. it
+            # is inherited from the class or computed by a descriptor), and
+            # setting it stores a new entry in the instance __dict__, undo
+            # must remove that entry rather than write the old value back.
+            try:
+                instance_dict = vars(target)
+            except TypeError:
+                instance_dict = None
+            in_dict_before = instance_dict is not None and name in instance_dict
+            setattr(target, name, value)
+            if (
+                instance_dict is not None
+                and not in_dict_before
+                and name in instance_dict
+            ):
+                oldval = NOTSET
         self._setattr.append((target, name, oldval))
 
     def delattr(
