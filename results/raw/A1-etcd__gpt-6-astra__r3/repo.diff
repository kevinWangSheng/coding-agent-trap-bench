+package storage
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	pb "go.etcd.io/etcd/api/v3/etcdserverpb"
+)
+
+func txnPut(key, value string) *pb.RequestOp {
+	return &pb.RequestOp{Request: &pb.RequestOp_RequestPut{RequestPut: &pb.PutRequest{
+		Key: []byte(key), Value: []byte(value),
+	}}}
+}
+
+func txnNested(txn *pb.TxnRequest) *pb.RequestOp {
+	return &pb.RequestOp{Request: &pb.RequestOp_RequestTxn{RequestTxn: txn}}
+}
+
+func TestCostTxnIncludesNestedTransactions(t *testing.T) {
+	put := func(key, value string) int { return kvOverhead + len(key) + len(value) }
+
+	tests := []struct {
+		name string
+		txn  *pb.TxnRequest
+		want int
+	}{
+		{
+			name: "nested success branch",
+			txn: &pb.TxnRequest{Success: []*pb.RequestOp{
+				txnNested(&pb.TxnRequest{Success: []*pb.RequestOp{txnPut("key", "value")}}),
+			}},
+			want: put("key", "value"),
+		},
+		{
+			name: "nested failure branch",
+			txn: &pb.TxnRequest{Failure: []*pb.RequestOp{
+				txnNested(&pb.TxnRequest{Failure: []*pb.RequestOp{txnPut("key", "value")}}),
+			}},
+			want: put("key", "value"),
+		},
+		{
+			name: "nested branch maximum is selected",
+			txn: &pb.TxnRequest{
+				Success: []*pb.RequestOp{txnNested(&pb.TxnRequest{Success: []*pb.RequestOp{txnPut("small", "v")}})},
+				Failure: []*pb.RequestOp{txnNested(&pb.TxnRequest{Failure: []*pb.RequestOp{txnPut("larger", "value")}})},
+			},
+			want: put("larger", "value"),
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			require.Equal(t, tt.want, costTxn(tt.txn))
+		})
+	}
+}
