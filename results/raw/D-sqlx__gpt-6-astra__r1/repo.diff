+    /// Discard all prepared statements that have completed execution.
+    ///
+    /// Non-persistent statements are only used for one execution, so retaining
+    /// every VM until the whole multi-statement query finishes needlessly grows
+    /// memory usage and makes SQLite's allocator increasingly expensive.
+    pub(crate) fn discard_completed(&mut self) {
+        debug_assert!(!self.persistent);
+        self.index = None;
+        self.handles.clear();
+        self.columns.clear();
+        self.column_names.clear();
+    }
