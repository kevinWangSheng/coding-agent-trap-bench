+#[sqlx_macros::test]
+async fn it_executes_large_multi_statement_scripts() -> anyhow::Result<()> {
+    let mut conn = new::<Sqlite>().await?;
+    let mut script = String::from("CREATE TABLE items (value INTEGER);\n");
+    script.push_str(&format!("-- {}\n", "comment ".repeat(700)));
+
+    for value in 0..200 {
+        script.push_str(&format!("INSERT INTO items VALUES ({value});\n"));
+    }
+
+    sqlx::raw_sql(sqlx::AssertSqlSafe(script.as_str()))
+        .execute(&mut conn)
+        .await?;
+
+    let (count,): (i64,) = sqlx::query_as("SELECT count(*) FROM items")
+        .fetch_one(&mut conn)
+        .await?;
+    assert_eq!(count, 200);
+
+    Ok(())
+}
