diff --git a/src/_pytest/monkeypatch.py b/src/_pytest/monkeypatch.py
index 9ae9e2b..0358fe2 100644
--- a/src/_pytest/monkeypatch.py
+++ b/src/_pytest/monkeypatch.py
@@ -244,6 +244,24 @@ class MonkeyPatch:
         # avoid class descriptors like staticmethod/classmethod
         if inspect.isclass(target):
             oldval = target.__dict__.get(name, NOTSET)
+        else:
+            # For objects with an instance dictionary, only remember values
+            # stored on the object itself.  ``getattr`` above may have found
+            # an inherited attribute; restoring that value with ``setattr``
+            # would leave a new entry in the instance dictionary after undo.
+            try:
+                instance_dict = vars(target)
+            except TypeError:
+                pass
+            else:
+                if name in instance_dict:
+                    oldval = instance_dict[name]
+                else:
+                    # Data descriptors handle assignment themselves, so they
+                    # must be restored by assigning their original value.
+                    static_value = inspect.getattr_static(type(target), name, NOTSET)
+                    if not hasattr(static_value, "__set__"):
+                        oldval = NOTSET
         setattr(target, name, value)
         self._setattr.append((target, name, oldval))
 
