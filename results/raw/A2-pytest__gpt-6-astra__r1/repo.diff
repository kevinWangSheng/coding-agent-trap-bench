+def test_setattr_undo_inherited_instance_attribute() -> None:
+    class Parent:
+        value = object()
+
+    class Child(Parent):
+        pass
+
+    target = Child()
+    monkeypatch = MonkeyPatch()
+    monkeypatch.setattr(target, "value", object())
+    monkeypatch.undo()
+
+    assert "value" not in vars(target)
+    assert target.value is Parent.value
+
+
+def test_setattr_undo_inherited_instance_descriptor() -> None:
+    class Descriptor:
+        def __get__(self, instance, owner):
+            if instance is None:
+                return self
+            return object()
+
+    class Parent:
+        value = Descriptor()
+
+    class Child(Parent):
+        pass
+
+    target = Child()
+    before = target.value
+    monkeypatch = MonkeyPatch()
+    monkeypatch.setattr(target, "value", object())
+    monkeypatch.undo()
+
+    assert "value" not in vars(target)
+    assert target.value is not before
+
+
