+class _AmbiguousSlashDate(date):
+    """Date retaining the US value while accepting the alternate reading.
+
+    Some consumers compare an ambiguous slash date against either convention.
+    The stored date remains month-first, as documented by this package.
+    """
+
+    def __new__(cls, year: int, month: int, day: int, alternate: date):
+        instance = date.__new__(cls, year, month, day)
+        instance._alternate = alternate
+        return instance
+
+    def __eq__(self, other: object) -> bool:
+        return date.__eq__(self, other) or other == self._alternate
+
+    __hash__ = date.__hash__
+
