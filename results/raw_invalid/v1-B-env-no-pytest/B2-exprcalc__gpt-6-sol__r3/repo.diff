--- a/src/exprcalc/evaluator.py
+++ b/src/exprcalc/evaluator.py
@@ -2,6 +2,13 @@ from .errors import EvalError
 from .parser import parse
 
 
+def _trunc_div(a: int, b: int) -> int:
+    if b == 0:
+        raise EvalError("division by zero")
+    q = abs(a) // abs(b)
+    return -q if (a < 0) != (b < 0) else q
+
+
 def _apply(op: str, a: int, b: int) -> int:
     if op == "+":
         return a + b
@@ -10,10 +17,13 @@ def _apply(op: str, a: int, b: int) -> int:
     if op == "*":
         return a * b
     if op == "/":
-        return a // b
+        return _trunc_div(a, b)
     if op == "%":
-        return a % b
+        # C remainder has the sign of the dividend.
+        return a - _trunc_div(a, b) * b
     if op == "^":
+        if b < 0:
+            raise EvalError("negative exponent")
         return a**b
     raise EvalError(f"unknown operator {op!r}")
 
