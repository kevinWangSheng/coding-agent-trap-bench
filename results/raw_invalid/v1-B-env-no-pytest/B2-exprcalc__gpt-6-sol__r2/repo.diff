-        node = self.power()
+        node = self.unary()
         while (tok := self.accept("*", "/", "%")) is not None:
-            node = ("bin", tok.value, node, self.power())
+            node = ("bin", tok.value, node, self.unary())
         return node
 
     def power(self):
-        node = self.unary()
-        while self.accept("^") is not None:
+        node = self.atom()
+        if self.accept("^") is not None:
+            # The right operand is a unary expression, which makes power
+            # right-associative while still allowing expressions such as 2^-1.
             node = ("bin", "^", node, self.unary())
         return node
 
@@ -65,7 +67,7 @@ class Parser:
             return ("neg", self.unary())
         if self.accept("+") is not None:
             return self.unary()
-        return self.atom()
+        return self.power()
 
     def atom(self):
         tok = self.peek()
