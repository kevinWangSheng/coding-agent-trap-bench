diff --git a/src/exprcalc/evaluator.py b/src/exprcalc/evaluator.py
index 3b927eb..f6853ff 100644
--- a/src/exprcalc/evaluator.py
+++ b/src/exprcalc/evaluator.py
@@ -10,10 +10,21 @@ def _apply(op: str, a: int, b: int) -> int:
     if op == "*":
         return a * b
     if op == "/":
-        return a // b
+        if b == 0:
+            raise EvalError("division by zero")
+        # Python's // rounds down; integer expression languages generally
+        # truncate division toward zero.
+        quotient = abs(a) // abs(b)
+        return -quotient if (a < 0) != (b < 0) else quotient
     if op == "%":
-        return a % b
+        if b == 0:
+            raise EvalError("division by zero")
+        # Define remainder from truncating division so it has the dividend's
+        # sign (rather than Python's divisor-sign convention).
+        return a - _apply("/", a, b) * b
     if op == "^":
+        if b < 0:
+            raise EvalError("negative exponent")
         return a**b
     raise EvalError(f"unknown operator {op!r}")
 
