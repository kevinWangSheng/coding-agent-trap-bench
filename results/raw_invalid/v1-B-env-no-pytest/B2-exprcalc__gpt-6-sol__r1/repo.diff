-        return node
-
-    def power(self):
         node = self.unary()
-        while self.accept("^") is not None:
-            node = ("bin", "^", node, self.unary())
+        while (tok := self.accept("*", "/", "%")) is not None:
+            node = ("bin", tok.value, node, self.unary())
         return node
 
     def unary(self):
@@ -65,7 +59,16 @@ class Parser:
             return ("neg", self.unary())
         if self.accept("+") is not None:
             return self.unary()
-        return self.atom()
+        return self.power()
+
+    def power(self):
+        node = self.atom()
+        if self.accept("^") is not None:
+            # Re-enter unary so exponentiation is right-associative while a
+            # signed exponent (e.g. 2 ^ -1) is still parsed and rejected by
+            # evaluation with a domain-specific error.
+            node = ("bin", "^", node, self.unary())
+        return node
 
     def atom(self):
         tok = self.peek()
