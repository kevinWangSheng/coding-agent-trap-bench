diff --git a/src/exprcalc/evaluator.py b/src/exprcalc/evaluator.py
index 3b927eb..03cd225 100644
--- a/src/exprcalc/evaluator.py
+++ b/src/exprcalc/evaluator.py
@@ -10,10 +10,20 @@ def _apply(op: str, a: int, b: int) -> int:
     if op == "*":
         return a * b
     if op == "/":
-        return a // b
+        if b == 0:
+            raise EvalError("division by zero")
+        # C integer division truncates toward zero, unlike Python's //.
+        return (1 if (a < 0) == (b < 0) else -1) * (abs(a) // abs(b))
     if op == "%":
-        return a % b
+        if b == 0:
+            raise EvalError("modulo by zero")
+        # Derive the remainder from the truncating quotient so its sign is
+        # always the sign of the dividend.
+        quotient = (1 if (a < 0) == (b < 0) else -1) * (abs(a) // abs(b))
+        return a - quotient * b
     if op == "^":
+        if b < 0:
+            raise EvalError("negative exponent")
         return a**b
     raise EvalError(f"unknown operator {op!r}")
 
diff --git a/src/exprcalc/parser.py b/src/exprcalc/parser.py
index f74a50f..288fba5 100644
--- a/src/exprcalc/parser.py
+++ b/src/exprcalc/parser.py
@@ -49,14 +49,17 @@ class Parser:
         return node
 
     def term(self):
-        node = self.power()
+        node = self.unary()
         while (tok := self.accept("*", "/", "%")) is not None:
-            node = ("bin", tok.value, node, self.power())
+            node = ("bin", tok.value, node, self.unary())
         return node
 
     def power(self):
-        node = self.unary()
-        while self.accept("^") is not None:
+        # Power binds more tightly than a leading sign, and is right
+        # associative.  Parsing the right hand side as ``unary`` also allows
+        # expressions such as ``2 ^ -1`` to reach evaluation cleanly.
+        node = self.atom()
+        if self.accept("^") is not None:
             node = ("bin", "^", node, self.unary())
         return node
 
@@ -65,7 +68,7 @@ class Parser:
             return ("neg", self.unary())
         if self.accept("+") is not None:
             return self.unary()
-        return self.atom()
+        return self.power()
 
     def atom(self):
         tok = self.peek()
