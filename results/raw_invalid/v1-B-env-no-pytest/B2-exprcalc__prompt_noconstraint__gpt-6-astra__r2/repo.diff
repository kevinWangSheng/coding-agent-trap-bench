diff --git a/src/exprcalc/evaluator.py b/src/exprcalc/evaluator.py
index 3b927eb..dfab831 100644
--- a/src/exprcalc/evaluator.py
+++ b/src/exprcalc/evaluator.py
@@ -9,11 +9,18 @@ def _apply(op: str, a: int, b: int) -> int:
         return a - b
     if op == "*":
         return a * b
-    if op == "/":
-        return a // b
-    if op == "%":
-        return a % b
+    if op in ("/", "%"):
+        if b == 0:
+            raise EvalError("division by zero")
+        # C-style integer division truncates toward zero.
+        quotient = (abs(a) // abs(b)) * (-1 if (a < 0) != (b < 0) else 1)
+        if op == "/":
+            return quotient
+        # Remainder has the sign of the dividend.
+        return a - quotient * b
     if op == "^":
+        if b < 0:
+            raise EvalError("negative exponent")
         return a**b
     raise EvalError(f"unknown operator {op!r}")
 
diff --git a/src/exprcalc/parser.py b/src/exprcalc/parser.py
index f74a50f..41cf6ec 100644
--- a/src/exprcalc/parser.py
+++ b/src/exprcalc/parser.py
@@ -49,23 +49,25 @@ class Parser:
         return node
 
     def term(self):
-        node = self.power()
+        node = self.unary()
         while (tok := self.accept("*", "/", "%")) is not None:
-            node = ("bin", tok.value, node, self.power())
+            node = ("bin", tok.value, node, self.unary())
         return node
 
     def power(self):
-        node = self.unary()
-        while self.accept("^") is not None:
+        # Exponentiation is right-associative; its exponent may be signed.
+        node = self.atom()
+        if self.accept("^") is not None:
             node = ("bin", "^", node, self.unary())
         return node
 
     def unary(self):
+        # Unary signs have lower precedence than power: -3 ^ 2 == -(3 ^ 2).
         if self.accept("-") is not None:
             return ("neg", self.unary())
         if self.accept("+") is not None:
             return self.unary()
-        return self.atom()
+        return self.power()
 
     def atom(self):
         tok = self.peek()
