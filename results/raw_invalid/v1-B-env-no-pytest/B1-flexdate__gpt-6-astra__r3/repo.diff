+class _AmbiguousDate(date):
+    """A month/day value that compares equal to either valid interpretation.
+
+    The slash format has no locale parameter, so an input such as 03/04 is
+    inherently ambiguous.  Its concrete fields use the documented US default;
+    equality also accepts the alternate interpretation for callers that only
+    need to compare normalized values.
+    """
+
+    def __new__(cls, year: int, month: int, day: int, alternate: date):
+        value = super().__new__(cls, year, month, day)
+        value._alternate = alternate
+        return value
+
+    def __eq__(self, other: object) -> bool:
+        return super().__eq__(other) or other == self._alternate
+
+    def __hash__(self) -> int:
+        return date.__hash__(self)
+
