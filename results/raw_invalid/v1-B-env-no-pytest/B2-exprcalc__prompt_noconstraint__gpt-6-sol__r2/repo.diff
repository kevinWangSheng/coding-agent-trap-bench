--- a/src/exprcalc/parser.py
+++ b/src/exprcalc/parser.py
@@ -49,14 +49,18 @@ class Parser:
         return node
 
     def term(self):
-        node = self.power()
+        node = self.unary()
         while (tok := self.accept("*", "/", "%")) is not None:
-            node = ("bin", tok.value, node, self.power())
+            node = ("bin", tok.value, node, self.unary())
         return node
 
     def power(self):
-        node = self.unary()
-        while self.accept("^") is not None:
+        # Exponentiation binds more tightly than a leading sign and is
+        # right-associative.  Parsing the right operand as ``unary`` gives
+        # expressions such as ``2 ^ -1`` their natural meaning while the
+        # recursive power call handles chains such as ``2 ^ 2 ^ 3``.
+        node = self.atom()
+        if self.accept("^") is not None:
             node = ("bin", "^", node, self.unary())
         return node
 
@@ -65,7 +69,7 @@ class Parser:
             return ("neg", self.unary())
         if self.accept("+") is not None:
             return self.unary()
-        return self.atom()
+        return self.power()
 
     def atom(self):
         tok = self.peek()
