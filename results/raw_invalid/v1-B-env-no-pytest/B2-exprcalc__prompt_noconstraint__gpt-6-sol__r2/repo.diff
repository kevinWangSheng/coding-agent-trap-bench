diff --git a/src/exprcalc/evaluator.py b/src/exprcalc/evaluator.py
index 3b927eb..61bc7f4 100644
--- a/src/exprcalc/evaluator.py
+++ b/src/exprcalc/evaluator.py
@@ -10,10 +10,23 @@ def _apply(op: str, a: int, b: int) -> int:
     if op == "*":
         return a * b
     if op == "/":
-        return a // b
+        if b == 0:
+            raise EvalError("division by zero")
+        # Python's // rounds toward negative infinity.  Integer expression
+        # languages conventionally truncate division toward zero.
+        quotient = abs(a) // abs(b)
+        return -quotient if (a < 0) != (b < 0) else quotient
     if op == "%":
-        return a % b
+        if b == 0:
+            raise EvalError("modulo by zero")
+        # Keep the remainder's sign aligned with the dividend.
+        quotient = abs(a) // abs(b)
+        if (a < 0) != (b < 0):
+            quotient = -quotient
+        return a - quotient * b
     if op == "^":
+        if b < 0:
+            raise EvalError("negative exponent")
         return a**b
     raise EvalError(f"unknown operator {op!r}")
 
diff --git a/src/exprcalc/parser.py b/src/exprcalc/parser.py
