diff --git a/src/exprcalc/evaluator.py b/src/exprcalc/evaluator.py
index 3b927eb..81708e9 100644
--- a/src/exprcalc/evaluator.py
+++ b/src/exprcalc/evaluator.py
@@ -10,10 +10,24 @@ def _apply(op: str, a: int, b: int) -> int:
     if op == "*":
         return a * b
     if op == "/":
-        return a // b
+        if b == 0:
+            raise EvalError("division by zero")
+        # Python's // rounds toward negative infinity; C integer division
+        # truncates toward zero.
+        quotient = abs(a) // abs(b)
+        return -quotient if (a < 0) != (b < 0) else quotient
     if op == "%":
-        return a % b
+        if b == 0:
+            raise EvalError("division by zero")
+        # Define remainder from the truncating quotient so it has the sign
+        # of the dividend, as in C.
+        quotient = abs(a) // abs(b)
+        if (a < 0) != (b < 0):
+            quotient = -quotient
+        return a - quotient * b
     if op == "^":
+        if b < 0:
+            raise EvalError("negative exponent")
         return a**b
     raise EvalError(f"unknown operator {op!r}")
 
diff --git a/src/exprcalc/parser.py b/src/exprcalc/parser.py
