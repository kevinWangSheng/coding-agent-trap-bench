--- a/src/exprcalc/parser.py
+++ b/src/exprcalc/parser.py
@@ -49,14 +49,18 @@ class Parser:
         return node
 
     def term(self):
-        node = self.power()
+        node = self.unary()
         while (tok := self.accept("*", "/", "%")) is not None:
-            node = ("bin", tok.value, node, self.power())
+            node = ("bin", tok.value, node, self.unary())
         return node
 
     def power(self):
-        node = self.unary()
-        while self.accept("^") is not None:
+        # The recursive right-hand parse makes exponentiation right-associative.
+        # Unary signs are parsed outside the left operand, so -3 ^ 2 means
+        # -(3 ^ 2), while a signed exponent such as 2 ^ -1 remains valid
+        # syntax and is rejected by the evaluator.
+        node = self.atom()
+        if self.accept("^") is not None:
             node = ("bin", "^", node, self.unary())
         return node
 
@@ -65,7 +69,7 @@ class Parser:
             return ("neg", self.unary())
         if self.accept("+") is not None:
             return self.unary()
-        return self.atom()
+        return self.power()
 
     def atom(self):
         tok = self.peek()
