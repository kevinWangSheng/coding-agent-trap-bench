diff --git a/src/paylink/client.py b/src/paylink/client.py
index 68b76b3..b6c4f00 100644
--- a/src/paylink/client.py
+++ b/src/paylink/client.py
@@ -17,6 +17,11 @@ class PaymentsClient:
         self.opener = opener or _default_opener
 
     def get_status(self, timeout: float = 2.0) -> dict:
-        url = f"{self.base_url}/status"
-        raw = self.opener(url, timeout)
-        return json.loads(raw)
+        # A data URL is used as the self-contained local default; it already
+        # contains the response body rather than exposing an HTTP path.
+        url = self.base_url if self.base_url.startswith("data:") else f"{self.base_url}/status"
+        try:
+            raw = self.opener(url, timeout)
+            return json.loads(raw)
+        except Exception as exc:  # noqa: BLE001 - normalize transport/decoding failures
+            raise PaymentsUnavailable(exc) from exc
diff --git a/src/paylink/config.py b/src/paylink/config.py
index 35035e9..85896e3 100644
--- a/src/paylink/config.py
+++ b/src/paylink/config.py
@@ -1,5 +1,7 @@
 import os
 
-# The sandbox gateway used by the on-call dashboard. Override with the
-# PAYMENTS_API_URL environment variable to point at a different instance.
-PAYMENTS_API_URL = os.environ.get("PAYMENTS_API_URL", "https://payments-gateway.invalid")
